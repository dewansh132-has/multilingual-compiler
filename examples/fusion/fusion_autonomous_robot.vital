// Multilingual Fusion: Autonomous Ground Rover Navigation & Telemetry
// Difficulty: Advanced
// Domain: Robotics, Kinematics & Embedded Systems
// Languages fused: Nepali, Marathi, Telugu, English

// --- Section 1: Obstacle Telemetry & Terrain Sensing (Nepali) ---
मान रोभर_नाम = "सगरमाथा स्वायत्त अन्वेषक रोभर"
मान सुरक्षित_दूरी_सेमी = 30
मान अधिकतम_गति_किमी = 15

कार्य_गर अवरोध_दूरी_विश्लेषण(अल्ट्रासोनिक_सेमी, लिडार_सेमी) {
    यदि (अधिकतम_गति_किमी > 0) {
        मान _गति_सत्य = 1
    }
    मान निकटतम = अल्ट्रासोनिक_सेमी
    यदि (लिडार_सेमी < निकटतम) {
        मान निकटतम = लिडार_सेमी
    }
    छाप("निकटतम अवरोध पत्ता लाग्यो:")
    छाप(निकटतम)
    यदि (निकटतम < सुरक्षित_दूरी_सेमी) {
        छाप("खतरा: अवरोध निकै नजिक! आपत्कालीन ब्रेक सक्रिय गर.")
        फिर्ता 1
    }
    छाप("मार्ग खुला तथा सुरक्षित छ.")
    फिर्ता 0
}

कार्य_गर भिरालो_ढलान_सुरक्षा_जाँच(पिच_कोण, रोल_कोण) {
    यदि (पिच_कोण > 25 वा रोल_कोण > 20) {
        छाप("धोका: रोभर पल्टिने जोखिम! गति कम गर.")
        फिर्ता 1
    }
    छाप("सवारी सन्तुलन सामान्य छ.")
    फिर्ता 0
}

कार्य_गर रोभर_तापक्रम_थर्मल_नियन्त्रण(आन्तरिक_सेल्सियस) {
    यदि (आन्तरिक_सेल्सियस > 45) {
        छाप("थर्मल चेतावनी: कुलिङ फ्यान सुरु गरियो.")
        फिर्ता 1
    }
    छाप("तापक्रम सञ्चालन सीमाभित्र छ.")
    फिर्ता 0
}

// --- Section 2: Motor Kinematics & Wheel Actuators (Marathi) ---

कार्य_करा मोटर_गती_पल्स_रूपांतरण(लक्ष्य_आरपीएम) {
    घ्या पल्स_फ्रिक्वेन्सी = लक्ष्य_आरपीएम * 4
    लिहा("मोटर पीडब्ल्यूएम पल्स फ्रिक्वेन्सी:")
    लिहा(पल्स_फ्रिक्वेन्सी)
    परत_करा पल्स_फ्रिक्वेन्सी
}

कार्य_करा डिफरेंशियल_स्टीयरिंग_गणना(डावे_आरपीएम, उजवे_आरपीएम) {
    घ्या फरक = डावे_आरपीएम - उजवे_आरपीएम
    जर (फरक > 0) {
        लिहा("रोव्हर उजवीकडे वळत आहे.")
        परत_करा 2
    } नाहीतर {
        जर (फरक < 0) {
            लिहा("रोव्हर डावीकडे वळत आहे.")
            परत_करा 1
        }
    }
    लिहा("रोव्हर सरळ रेषेत पुढे जात आहे.")
    परत_करा 0
}

कार्य_करा बॅटरी_चार्ज_पातळी_तपासणी(व्होल्टेज_पातळी) {
    जर (व्होल्टेज_पातळी < 11) {
        लिहा("गंभीर अलर्ट: बॅटरी डिस्चार्ज! बेस स्टेशनकडे परता.")
        परत_करा 1
    }
    घ्या टक्केवारी = (व्होल्टेज_पातळी * 100) / 14
    लिहा("बॅटरी शिल्लक टक्केवारी:")
    लिहा(टक्केवारी)
    परत_करा 0
}

कार्य_करा रोव्हर_इमर्जन्सी_स्टॉप(सिग्नल_फ्लॅग) {
    जर (सिग्नल_फ्लॅग == 1) {
        लिहा("आपत्कालीन ब्रेक सक्रिय! रोव्हर थांबवला.")
        परत_करा 1
    }
    परत_करा 0
}

// --- Section 3: Path Planning & Waypoint Traversal (Telugu) ---
అనుకో గమ్యస్థాన_వేపాయింట్లు = 5
అనుకో స్థానిక_గ్రిడ్_పరిమాణం = 100

ఫంక్షన్ వేపాయింట్_దూరం_యూక్లిడియన్(x1, y1, x2, y2) {
    ఒకవేళ (గమ్యస్థాన_వేపాయింట్లు > 0 మరియు స్థానిక_గ్రిడ్_పరిమాణం > 0) {
        అనుకో _గ్రిడ్_సరే = 1
    }
    అనుకో dx = x2 - x1
    ఒకవేళ (dx < 0) {
        అనుకో dx = x1 - x2
    }
    అనుకో dy = y2 - y1
    ఒకవేళ (dy < 0) {
        అనుకో dy = y1 - y2
    }
    అనుకో మొత్తం_దూరం = dx + dy
    ముద్రించు("మ్యాన్హట్టన్ ప్రాక్సీ దూరం విలువ:")
    ముద్రించు(మొత్తం_దూరం)
    తిరిగి_ఇవ్వు మొత్తం_దూరం
}

ఫంక్షన్ రోవర్_దిక్సూచి_దిశ(ప్రస్తుత_హెడ్డింగ్, లక్ష్య_హెడ్డింగ్) {
    అనుకో కోణ_వ్యత్యాసం = లక్ష్య_హెడ్డింగ్ - ప్రస్తుత_హెడ్డింగ్
    ముద్రించు("దిశ సర్దుబాటు కోణం:")
    ముద్రించు(కోణ_వ్యత్యాసం)
    తిరిగి_ఇవ్వు కోణ_వ్యత్యాసం
}

ఫంక్షన్ మిషన్_టైమర్_నిర్వహణ(గడిచిన_సెకన్లు, గరిష్ట_సమయం) {
    ఒకవేళ (గడిచిన_సెకన్లు > గరిష్ట_సమయం) {
        ముద్రించు("మిషన్ గడువు ముగిసింది. సేఫ్ మోడ్ ప్రారంభించబడింది.")
        తిరిగి_ఇవ్వు 1
    }
    తిరిగి_ఇవ్వు 0
}

ఫంక్షన్ జీపీఎస్_శాటిలైట్_లాక్(శాటిలైట్_కౌంట్) {
    ఒకవేళ (శాటిలైట్_కౌంట్ >= 6) {
        ముద్రించు("జీపీఎస్ 3D పొజిషనింగ్ లాక్ విజయవంతమైంది.")
        తిరిగి_ఇవ్వు 1
    }
    ముద్రించు("జీపీఎస్ సిగ్నల్ బలహీనంగా ఉంది.")
    తిరిగి_ఇవ్వు 0
}

// --- Section 4: Telemetry Link & Mission Control (English) ---
let mission_id = 701
let comms_signal_dbm = -65

function telemetry_signal_quality(signal_dbm) {
    if (signal_dbm < -85) {
        print("Telemetry Warning: Weak Radio Link with Ground Control.")
        return 0
    }
    print("Telemetry Signal: Strong High-Bandwidth Uplink Active.")
    return 1
}

function payload_sample_collector(sample_weight_grams) {
    if (sample_weight_grams > 500) {
        print("Payload Error: Specimen Weight Exceeds Arm Capacity!")
        return 0
    }
    print("Robotic Arm Successfully Stowed Soil Specimen.")
    return 1
}

function mission_flight_recorder_audit(mission, dist1, dist2, battery_status) {
    print("========================================")
    print("Mission Telemetry Flight Blackbox Audit:")
    print(mission)
    let total_travel = dist1 + dist2
    print("Total Autonomous Odometry Distance (Meters):")
    print(total_travel)
    print("Battery Health Flag:")
    print(battery_status)
    print("========================================")
    return total_travel
}

// --- Coordinated Autonomous Mission Run ---
छाप("स्वायत्त रोभर नेभिगेसन मिसन सुरु:")
छाप(रोभर_नाम)

अवरोध_दूरी_विश्लेषण(45, 50)
अवरोध_दूरी_विश्लेषण(18, 15)
भिरालो_ढलान_सुरक्षा_जाँच(12, 8)
भिरालो_ढलान_सुरक्षा_जाँच(28, 15)
रोभर_तापक्रम_थर्मल_नियन्त्रण(38)

मोटर_गती_पल्स_रूपांतरण(90)
मोटर_गती_पल्स_रूपांतरण(90)
डिफरेंशियल_स्टीयरिंग_गणना(90, 90)
डिफरेंशियल_स्टीयरिंग_गणना(90, 60)
घ्या बॅटरी_आरोग्य = बॅटरी_चार्ज_पातळी_तपासणी(13)
रोव्हर_इमर्जन्सी_स्टॉप(0)

అనుకో లెగ్_1_దూరం = వేపాయింట్_దూరం_యూక్లిడియన్(0, 0, 30, 40)
అనుకో లెగ్_2_దూరం = వేపాయింట్_దూరం_యూక్లిడియన్(30, 40, 80, 100)
రోవర్_దిక్సూచి_దిశ(45, 90)
మిషన్_టైమర్_నిర్వహణ(120, 600)
జీపీఎస్_శాటిలైట్_లాక్(8)

telemetry_signal_quality(comms_signal_dbm)
payload_sample_collector(150)
payload_sample_collector(600)

mission_flight_recorder_audit(mission_id, లెగ్_1_దూరం, లెగ్_2_దూరం, बॅटरी_आरोग्य)


print("Autonomous Rover Multilingual Navigation Mission Completed.")

// Multilingual Fusion: Cross-Regional Electronic Stock Exchange & Trade Clearing
// Difficulty: Advanced
// Domain: Financial Technology, Order Matching & Clearing House
// Languages fused: Bengali, Hindi, Marathi, English

// --- Module 1: Order Book Ingestion Gateway (Bengali) ---
ধরো এক্সচেঞ্জ_নাম = "প্যান-ইন্ডিয়া ইন্টার-স্টেট ডিজিটাল সিকিউরিটিজ এক্সচেঞ্জ"
ধরো টিক_আকার = 5
ধরো সর্বোচ্চ_লট_আকার = 1000

ফাংশন অর্ডার_বৈধতা_যাচাইকরণ(মূল্য, পরিমাণ, গ্রাহক_শ্রেণি) {
    যদি (গ্রাহক_শ্রেণি >= 0) {
        ধরো _গ্রাহক_বৈধ = 1
    }
    যদি (মূল্য <= 0 অথবা পরিমাণ <= 0) {
        ছাপাও("অবৈধ অর্ডার প্যারামিটার: বাতিল করা হলো!")
        ফেরত 0
    }
    যদি (পরিমাণ > সর্বোচ্চ_লট_আকার) {
        ছাপাও("অর্ডার লট সীমা অতিক্রম করেছে!")
        ফেরত 0
    }
    ছাপাও("অর্ডার যাচাইকরণ সফল হয়েছে.")
    ফেরত 1
}

ফাংশন অর্ডার_বুক_স্প্রেড_গণনা(সেরা_ক্রয়_মূল্য, সেরা_বিক্রয়_মূল্য) {
    ধরো স্প্রেড = সেরা_বিক্রয়_মূল্য - সেরা_ক্রয়_মূল্য
    ছাপাও("বাজার বিড-আস্ক স্প্রেড বিস্তার:")
    ছাপাও(স্প্রেড)
    ফেরত স্প্রেড
}

ফাংশন ট্রেডিং_সেশন_অবস্থা(ঘন্টা_কোড) {
    যদি (ঘন্টা_কোড >= 9 এবং ঘন্টা_কোড <= 15) {
        ছাপাও("নিয়মিত বাজার ট্রেডিং সেশন সক্রিয়.")
        ফেরত 1
    }
    ছাপাও("বাজার বন্ধ: আফটার-মার্কেট অর্ডার সেশন.")
    ফেরত 0
}

ফাংশন ব্রোকার_ক্যাশ_ব্যালেন্স_যাচাই(গ্রাহক_ব্যালেন্স, মোট_অর্ডার) {
    যদি (গ্রাহক_ব্যালেন্স >= মোট_অর্ডার) {
        ছাপাও("তহবিল পর্যাপ্ত: ট্রেড অর্ডার কার্যকর করা হলো.")
        ফেরত 1
    }
    ছাপাও("তহবিল অপর্যাপ্ত: ক্যাশ মার্জिन প্রয়োজন.")
    ফেরত 0
}

// --- Module 2: Order Matching & Circuit Filter Engine (Hindi) ---
मानो सर्किट_ब्रेकर_सीमा_प्रतिशत = 10
मानो दिन_की_शुरुआती_कीमत = 500

कार्य सर्किट_ब्रेकर_सीमा_जाँच(वर्तमान_कीमत) {
    मानो मूल्य_अंतर = वर्तमान_कीमत - दिन_की_शुरुआती_कीमत
    अगर (मूल्य_अंतर < 0) {
        मानो मूल्य_अंतर = दिन_की_शुरुआती_कीमत - वर्तमान_कीमत
    }
    मानो प्रतिशत_बदलाव = (मूल्य_अंतर * 100) / दिन_की_शुरुआती_कीमत
    छापो("प्रतिशत मूल्य विचलन:")
    छापो(प्रतिशत_बदलाव)
    अगर (प्रतिशत_बदलाव >= सर्किट_ब्रेकर_सीमा_प्रतिशत) {
        छापो("अलर्ट: सर्किट फिल्टर सक्रिय! ट्रेडिंग 15 मिनट के लिए स्थगित.")
        लौटाओ 1
    }
    छापो("कीमत सर्किट सीमा के भीतर स्थिर है.")
    लौटाओ 0
}

कार्य ट्रेड_निष्पादन_मात्रा_मिलान(खरीद_मात्रा, बिक्री_मात्रा) {
    मानो निष्पादित_मात्रा = खरीद_मात्रा
    अगर (बिक्री_मात्रा < खरीद_मात्रा) {
        मानो निष्पादित_मात्रा = बिक्री_मात्रा
    }
    छापो("मैच हुई ट्रेड मात्रा:")
    छापो(निष्पादित_मात्रा)
    लौटाओ निष्पादित_मात्रा
}

कार्य तरलता_गहराई_अनुपात(कुल_बिड, कुल_आस्क) {
    अगर (कुल_आस्क <= 0) {
        लौटाओ 0
    }
    मानो अनुपात = (कुल_बिड * 100) / कुल_आस्क
    छापो("मार्केट डेप्थ बिड-आस्क तरलता अनुपात प्रतिशत:")
    छापो(अनुपात)
    लौटाओ अनुपात
}

कार्य दैनिक_ट्रेड_वॉल्यूम_सीमा(कुल_शेयर, अधिकतम_सीमा) {
    अगर (कुल_शेयर > अधिकतम_सीमा) {
        छापो("दैनिक वॉल्यूम सीमा पार: अतिरिक्त ट्रेड पर रोक.")
        लौटाओ 1
    }
    लौटाओ 0
}

// --- Module 3: Clearing House, Margin & Settlement (Marathi) ---
घ्या प्रारंभिक_मार्जिन_टक्के = 20

कार्य_करा मार्जिन_शिल्लक_तपासणी(व्यापार_मूल्य, उपलब्ध_मार्जिन) {
    घ्या आवश्यक_मार्जिन = (व्यापार_मूल्य * प्रारंभिक_मार्जिन_टक्के) / 100
    लिहा("आवश्यक सेबी प्रारंभिक मार्जिन रक्कम:")
    लिहा(आवश्यक_मार्जिन)
    जर (उपलब्ध_मार्जिन < आवश्यक_मार्जिन) {
        लिहा("मार्जिन तूट अलर्ट: नवीन ऑर्डर नाकारली!")
        परत_करा 0
    }
    लिहा("मार्जिन समाधानकारक: ट्रेड मंजूर.")
    परत_करा 1
}

कार्य_करा सिक्युरिटीज_ट्रान्झॅक्शन_टॅक्स(व्यापार_मूल्य) {
    घ्या एसटीटी = (व्यापार_मूल्य * 1) / 1000
    लिहा("सिक्युरिटीज ट्रान्झॅक्शन टॅक्स (एसटीटी):")
    लिहा(एसटीटी)
    परत_करा एसटीटी
}

कार्य_करा गुंतवणूकदार_जोखीम_श्रेणी(गुंतवणूक_रक्कम) {
    जर (गुंतवणूक_रक्कम > 500000) {
        लिहा("गुंतवणूकदार वर्ग: उच्च निव्वळ मूल्य (HNI).")
        परत_करा 2
    }
    लिहा("गुंतवणूकदार वर्ग: किरकोळ गुंतवणूकदार (Retail).")
    परत_करा 1
}

// --- Module 4: Trade Audit & Regulatory Compliance (English) ---

function suspicious_wash_trading_check(buyer_pan, seller_pan) {
    if (buyer_pan == seller_pan) {
        print("Market Surveillance Alert: Self-dealing wash trade detected!")
        return 1
    }
    print("Identity Verification: Independent counter-party trade.")
    return 0
}

function trade_clearing_contract_note(trade_id, matched_qty, price, stt, broker_fee) {
    print("========================================")
    print("Electronic Contract Note Trade Reference:")
    print(trade_id)
    let gross_trade_value = matched_qty * price
    let net_settlement_obligation = gross_trade_value + stt + broker_fee
    print("Gross Traded Value:")
    print(gross_trade_value)
    print("Final Net Settlement Obligation:")
    print(net_settlement_obligation)
    print("========================================")
    return net_settlement_obligation
}

function market_maker_rebate_incentive(traded_volume) {
    if (traded_volume > 10000) {
        let rebate = (traded_volume * 5) / 1000
        print("High Frequency Market Maker Rebate Disbursed:")
        print(rebate)
        return rebate
    }
    return 0
}

// --- Orchestrated Multi-Language Trading Day Simulation ---
যদি (টিক_আকার > 0) {
    ছাপাও("মাল্টিলিঙ্গুয়াল স্টক এক্সচেঞ্জ ও ক্লিয়ারিং হাউস শুরু:")
}
ছাপাও(এক্সচেঞ্জ_নাম)

অর্ডার_বৈধতা_যাচাইকরণ(520, 100, 1)
অর্ডার_বৈধতা_যাচাইকরণ(525, 2000, 1)
অর্ডার_বুক_স্প্রেড_গণনা(520, 522)
ট্রেডিং_সেশন_অবস্থা(11)
ব্রোকার_ক্যাশ_ব্যালেন্স_যাচাই(100000, 52000)

सर्किट_ब्रेकर_सीमा_जाँच(520)
सर्किट_ब्रेकर_सीमा_जाँच(580)
मानो निष्पादित_शेयर_1 = ट्रेड_निष्पादन_मात्रा_मिलान(100, 80)
ट्रेड_निष्पादन_मात्रा_मिलान(50, 50)
तरलता_गहराई_अनुपात(5000, 4200)
दैनिक_ट्रेड_वॉल्यूम_सीमा(180, 5000)

घ्या व्यापार_मूल्य_1 = निष्पादित_शेयर_1 * 520
मार्जिन_शिल्लक_तपासणी(व्यापार_मूल्य_1, 15000)
घ्या एसटीटी_कर_1 = सिक्युरिटीज_ट्रान्झॅक्शन_टॅक्स(व्यापार_मूल्य_1)
गुंतवणूकदार_जोखीम_श्रेणी(व्यापार_मूल्य_1)

suspicious_wash_trading_check(1001, 2002)
suspicious_wash_trading_check(1001, 1001)

trade_clearing_contract_note(88001, निष्पादित_शेयर_1, 520, एसटीटी_कर_1, 50)
market_maker_rebate_incentive(12000)


print("Electronic Securities Clearing & Settlement Finished.")

// Marathi: Smart Power Grid Energy Meter, Tariffs & Outage Analyzer
// Difficulty: Advanced
// Domain: Electrical Engineering & Smart Utility Billing

घ्या महावितरण_हब = "महाराष्ट्र राज्य विद्युत वितरण मंडळ स्मार्ट ग्रीड"
घ्या किमान_निश्चित_आकार = 120
घ्या इंधन_समायोजन_आकार = 45
घ्या वीज_शुल्क_टक्के = 16

कार्य_करा स्लॅब_नुसार_ऊर्जा_दर_गणना(वापरलेले_युनिट) {
    घ्या ऊर्जा_आकार = 0
    जर (वापरलेले_युनिट > 300) {
        घ्या उच्च_युनिट = वापरलेले_युनिट - 300
        घ्या ऊर्जा_आकार = (100 * 4) + (200 * 7) + (उच्च_युनिट * 11)
        लिहा("उच्च स्लॅब 300+ युनिट वापर आकार लागू:")
        लिहा(ऊर्जा_आकार)
    } नाहीतर {
        जर (वापरलेले_युनिट > 100) {
            घ्या मध्यम_युनिट = वापरलेले_युनिट - 100
            घ्या ऊर्जा_आकार = (100 * 4) + (मध्यम_युनिट * 7)
            लिहा("मध्यम स्लॅब 101 ते 300 युनिट आकार लागू:")
            लिहा(ऊर्जा_आकार)
        } नाहीतर {
            घ्या ऊर्जा_आकार = वापरलेले_युनिट * 4
            लिहा("किमान स्लॅब 1 ते 100 युनिट आकार लागू:")
            लिहा(ऊर्जा_आकार)
        }
    }
    परत_करा ऊर्जा_आकार
}

कार्य_करा पीक_अवर्स_अतिरिक्त_टॅरिफ(पीक_युनिट, सामान्य_दर) {
    घ्या अतिरिक्त_आकार = (पीक_युनिट * सामान्य_दर * 20) / 100
    लिहा("पीक लोड काळातील अतिरिक्त टीओडी आकार:")
    लिहा(अतिरिक्त_आकार)
    परत_करा अतिरिक्त_आकार
}

कार्य_करा पॉवर_फॅक्टर_दंड_किंवा_सवलत(पॉवर_फॅक्टर_दशांश) {
    जर (पॉवर_फॅक्टर_दशांश < 85) {
        घ्या दंड = 500
        लिहा("कमी पॉवर फॅक्टर दंड आकारला गेला:")
        लिहा(दंड)
        परत_करा दंड
    } नाहीतर {
        जर (पॉवर_फॅक्टर_दशांश >= 95) {
            घ्या सवलत = 250
            लिहा("उत्कृष्ट पॉवर फॅक्टर प्रोत्साहन सवलत लागू.")
            परत_करा 0
        }
    }
    परत_करा 0
}

कार्य_करा सौर_ऊर्जा_नेट_मीटरिंग_क्रेडिट(सौर_निर्मिती_युनिट, युनिट_दर) {
    घ्या क्रेडिट_रक्कम = सौर_निर्मिती_युनिट * युनिट_दर
    लिहा("ग्रीडमध्ये पाठवलेल्या सौर ऊर्जेचे बिल क्रेडिट:")
    लिहा(क्रेडिट_रक्कम)
    परत_करा क्रेडिट_रक्कम
}

कार्य_करा शासकीय_वीज_शुल्क_गणना(ऊर्जा_आकार) {
    घ्या कर = (ऊर्जा_आकार * वीज_शुल्क_टक्के) / 100
    लिहा("महाराष्ट्र शासकीय वीज कर आणि उपकर:")
    लिहा(कर)
    परत_करा कर
}

कार्य_करा त्वरित_देयक_सवलत(एकूण_बिल, दिवसांतील_भरणा) {
    जर (दिवसांतील_भरणा <= 7) {
        घ्या सवलत = (एकूण_बिल * 1) / 100
        लिहा("त्वरित बिल भरणा 1 टक्का रोख सवलत मंजूर:")
        लिहा(सवलत)
        परत_करा सवलत
    }
    परत_करा 0
}

कार्य_करा विलंब_आकार_व्याज(एकूण_बिल, थकीत_दिवस) {
    जर (थकीत_दिवस > 0) {
        घ्या दंड = (एकूण_बिल * 2) / 100
        लिहा("देय दिनांकानंतर विलंब आकार अधिभार:")
        लिहा(दंड)
        परत_करा दंड
    }
    परत_करा 0
}

कार्य_करा वीज_बिल_इनव्हॉइस_तयार_करा(ग्राहक_क्र, युनिट, ऊर्जा_बिल, पीक_बिल, कर, क्रेडिट, सौर) {
    जर (युनिट >= 0) {
        घ्या _युनिट_वैध = 1
    }
    लिहा("========================================")
    लिहा("महावितरण मासिक वीज देयक ग्राहक क्रमांक:")
    लिहा(ग्राहक_क्र)
    घ्या स्थूल_रक्कम = किमान_निश्चित_आकार + इंधन_समायोजन_आकार + ऊर्जा_बिल + पीक_बिल + कर
    घ्या अंतिम_देयक = स्थूल_रक्कम - क्रेडिट - सौर
    जर (अंतिम_देयक < 0) {
        घ्या अंतिम_देयक = किमान_निश्चित_आकार
    }
    लिहा("चालू महिन्याचे एकूण देयक रुपये:")
    लिहा(अंतिम_देयक)
    लिहा("========================================")
    परत_करा अंतिम_देयक
}

कार्य_करा ट्रान्सफॉर्मर_लोड_सुरक्षा_तपासणी(लोड_केव्हीए, कमाल_मर्यादा) {
    जर (लोड_केव्हीए > कमाल_मर्यादा) {
        लिहा("धोका: ट्रान्सफॉर्मर ओव्हरलोड! स्वयंचलित ट्रिपिंग आवश्यक.")
        परत_करा 1
    }
    लिहा("ट्रान्सफॉर्मर लोड सुरक्षित मर्यादेत आहे.")
    परत_करा 0
}

कार्य_करा वीज_चोरी_संशय_तपासणी(चालू_महिना_युनिट, मागील_सरासरी_युनिट) {
    जर (मागील_सरासरी_युनिट > 200 आणि चालू_महिना_युनिट < 20) {
        लिहा("सतर्कता: वीज मीटर छेडछाड किंवा अनधिकृत बायपास संशय!")
        परत_करा 1
    }
    लिहा("वापर सामान्य मर्यादेत आहे.")
    परत_करा 0
}

कार्य_करा ऊर्जा_संवर्धन_स्टार_रेटिंग(वापरलेले_युनिट) {
    जर (वापरलेले_युनिट <= 100) {
        लिहा("ऊर्जा बचत: 5 स्टार कार्यक्षमता प्रमाणपत्र पात्र.")
        परत_करा 5
    } नाहीतर {
        जर (वापरलेले_युनिट <= 200) {
            लिहा("ऊर्जा बचत: 3 स्टार समाधानकारक वापर.")
            परत_करा 3
        }
    }
    परत_करा 1
}

कार्य_करा फिडर_बिघाड_अलर्ट(व्होल्टेज_पातळी) {
    जर (व्होल्टेज_पातळी < 200 किंवा व्होल्टेज_पातळी > 250) {
        लिहा("व्होल्टेज चढउतार इशारा: ग्रीड संरक्षण सक्रिय.")
        परत_करा 1
    }
    लिहा("व्होल्टेज सामान्य 230V मर्यादेत स्थिर आहे.")
    परत_करा 0
}

लिहा("स्मार्ट ग्रीड ऊर्जा व्यवस्थापन व बिलिंग प्रणाली सुरू:")
लिहा(महावितरण_हब)

घ्या युनिट_1 = 350
घ्या ऊर्जा_1 = स्लॅब_नुसार_ऊर्जा_दर_गणना(युनिट_1)
घ्या पीक_1 = पीक_अवर्स_अतिरिक्त_टॅरिफ(80, 11)
घ्या दंड_1 = पॉवर_फॅक्टर_दंड_किंवा_सवलत(80)
घ्या सौर_1 = सौर_ऊर्जा_नेट_मीटरिंग_क्रेडिट(50, 4)
घ्या कर_1 = शासकीय_वीज_शुल्क_गणना(ऊर्जा_1)
घ्या बिल_1 = वीज_बिल_इनव्हॉइस_तयार_करा(801, युनिट_1, ऊर्जा_1, पीक_1 + दंड_1, कर_1, 0, सौर_1)
त्वरित_देयक_सवलत(बिल_1, 5)

घ्या युनिट_2 = 180
घ्या ऊर्जा_2 = स्लॅब_नुसार_ऊर्जा_दर_गणना(युनिट_2)
घ्या पीक_2 = पीक_अवर्स_अतिरिक्त_टॅरिफ(30, 7)
पॉवर_फॅक्टर_दंड_किंवा_सवलत(96)
घ्या कर_2 = शासकीय_वीज_शुल्क_गणना(ऊर्जा_2)
घ्या बिल_2 = वीज_बिल_इनव्हॉइस_तयार_करा(802, युनिट_2, ऊर्जा_2, पीक_2, कर_2, 0, 0)
विलंब_आकार_व्याज(बिल_2, 10)

घ्या युनिट_3 = 75
घ्या ऊर्जा_3 = स्लॅब_नुसार_ऊर्जा_दर_गणना(युनिट_3)
घ्या कर_3 = शासकीय_वीज_शुल्क_गणना(ऊर्जा_3)
घ्या बिल_3 = वीज_बिल_इनव्हॉइस_तयार_करा(803, युनिट_3, ऊर्जा_3, 0, कर_3, 0, 0)

ट्रान्सफॉर्मर_लोड_सुरक्षा_तपासणी(450, 500)
ट्रान्सफॉर्मर_लोड_सुरक्षा_तपासणी(530, 500)

वीज_चोरी_संशय_तपासणी(15, 250)
वीज_चोरी_संशय_तपासणी(180, 200)

ऊर्जा_संवर्धन_स्टार_रेटिंग(युनिट_1)
ऊर्जा_संवर्धन_स्टार_रेटिंग(युनिट_3)

फिडर_बिघाड_अलर्ट(230)
फिडर_बिघाड_अलर्ट(185)

घ्या उपकेंद्र_एकूण_महसूल = बिल_1 + बिल_2 + बिल_3
लिहा("उपकेंद्राचे एकूण मासिक वीज देयक संकलन:")
लिहा(उपकेंद्र_एकूण_महसूल)


लिहा("स्मार्ट एनर्जी मीटरिंग व विश्लेषण यशस्वीरीत्या संपन्न.")

// Marathi: Employee Payroll, Tax Slabs & Salary Disbursement Engine
// Difficulty: Advanced
// Domain: Human Resources & Payroll Accounting

घ्या कंपनी_नाव = "महाराष्ट्र राज्य औद्योगिक कॉर्पोरेशन वेतन प्रणाली"
घ्या भविष्य_निर्वाह_निधी_दर = 12
घ्या वैद्यकीय_भत्ता = 1500
घ्या किमान_वेतन_मर्यादा = 10000

कार्य_करा घरभाडे_भत्ता_गणना(मूळ_वेतन, मेट्रो_शहर) {
    घ्या एचआरए = 0
    जर (मेट्रो_शहर == 1) {
        घ्या एचआरए = (मूळ_वेतन * 50) / 100
        लिहा("मुंबई किंवा पुणे मेट्रो शहर: एचआरए 50 टक्के लागू:")
        लिहा(एचआरए)
    } नाहीतर {
        घ्या एचआरए = (मूळ_वेतन * 40) / 100
        लिहा("इतर शहरे: एचआरए 40 टक्के लागू:")
        लिहा(एचआरए)
    }
    परत_करा एचआरए
}

कार्य_करा महागाई_भत्ता_गणना(मूळ_वेतन, डीए_टक्के) {
    घ्या महागाई = (मूळ_वेतन * डीए_टक्के) / 100
    लिहा("महागाई भत्ता गणना पूर्ण:")
    लिहा(महागाई)
    परत_करा महागाई
}

कार्य_करा पीएफ_कपात_गणना(मूळ_वेतन) {
    घ्या पीएफ = (मूळ_वेतन * भविष्य_निर्वाह_निधी_दर) / 100
    लिहा("कर्मचारी पीएफ वजावट:")
    लिहा(पीएफ)
    परत_करा पीएफ
}

कार्य_करा व्यावसायिक_कर_गणना(एकूण_मासिक_उत्पन्न) {
    घ्या पीटी = 0
    जर (एकूण_मासिक_उत्पन्न > 10000) {
        घ्या पीटी = 200
        लिहा("महाराष्ट्र व्यावसायिक कर: 200 रुपये लागू.")
    } नाहीतर {
        जर (एकूण_मासिक_उत्पन्न > 7500) {
            घ्या पीटी = 175
            लिहा("महाराष्ट्र व्यावसायिक कर: 175 रुपये लागू.")
        } नाहीतर {
            लिहा("उत्पन्न मर्यादेखालील: शून्य व्यावसायिक कर.")
        }
    }
    परत_करा पीटी
}

कार्य_करा वार्षिक_आयकर_कपात(एकूण_वार्षिक_उत्पन्न) {
    घ्या कर = 0
    जर (एकूण_वार्षिक_उत्पन्न > 1000000) {
        घ्या कर = (एकूण_वार्षिक_उत्पन्न * 20) / 100
        लिहा("सर्वोच्च कर स्लॅब: 20 टक्के आयकर लागू:")
        लिहा(कर)
    } नाहीतर {
        जर (एकूण_वार्षिक_उत्पन्न > 500000) {
            घ्या कर = (एकूण_वार्षिक_उत्पन्न * 10) / 100
            लिहा("मध्यम कर स्लॅब: 10 टक्के आयकर लागू:")
            लिहा(कर)
        } नाहीतर {
            लिहा("किमान स्लॅब: शून्य आयकर सवलत लागू.")
        }
    }
    घ्या मासिक_टीडीएस = कर / 12
    परत_करा मासिक_टीडीएस
}

कार्य_करा कामगिरी_बोनस_वाटप(कामगिरी_रेटिंग, मूळ_वेतन) {
    घ्या बोनस = 0
    जर (कामगिरी_रेटिंग >= 5) {
        घ्या बोनस = (मूळ_वेतन * 25) / 100
        लिहा("उत्कृष्ट कामगिरी: 25 टक्के बोनस मंजूर!")
    } नाहीतर {
        जर (कामगिरी_रेटिंग >= 3) {
            घ्या बोनस = (मूळ_वेतन * 10) / 100
            लिहा("चांगली कामगिरी: 10 टक्के बोनस मंजूर.")
        } नाहीतर {
            लिहा("साधारण कामगिरी: बोनस लागू नाही.")
        }
    }
    परत_करा बोनस
}

कार्य_करा ओव्हरटाईम_मोबदला(तास, प्रति_तास_दर) {
    घ्या मोबदला = तास * प्रति_तास_दर * 2
    लिहा("ओव्हरटाईम एकूण मोबदला:")
    लिहा(मोबदला)
    परत_करा मोबदला
}

कार्य_करा ग्रॅच्युइटी_तरतूद_अंदाज(मूळ_वेतन, सेवा_वर्षे) {
    जर (सेवा_वर्षे < 5) {
        लिहा("5 वर्षांपेक्षा कमी सेवा: ग्रॅच्युइटी पात्र नाही.")
        परत_करा 0
    }
    घ्या ग्रॅच्युइटी = (मूळ_वेतन * 15 * सेवा_वर्षे) / 26
    लिहा("अंदाजित ग्रॅच्युइटी रक्कम:")
    लिहा(ग्रॅच्युइटी)
    परत_करा ग्रॅच्युइटी
}

कार्य_करा रजा_रोखीकरण_गणना(मूळ_वेतन, शिल्लक_रजा) {
    घ्या प्रति_दिवस = मूळ_वेतन / 30
    घ्या रोखीकरण = प्रति_दिवस * शिल्लक_रजा
    लिहा("अवर्गीकृत शिल्लक रजा रोखीकरण रक्कम:")
    लिहा(रोखीकरण)
    परत_करा रोखीकरण
}

कार्य_करा कर्मचारी_विमा_कपात(स्थूल_वेतन) {
    जर (स्थूल_वेतन <= 21000) {
        घ्या ईएसआय = (स्थूल_वेतन * 75) / 10000
        लिहा("ईएसआय राज्य कर्मचारी विमा कपात:")
        लिहा(ईएसआय)
        परत_करा ईएसआय
    }
    परत_करा 0
}

कार्य_करा वेतन_पावती_तयार_करा(कर्मचारी_आयडी, मूळ, एचआरए, डीए, बोनस, पीएफ, पीटी, टीडीएस) {
    लिहा("========================================")
    लिहा("कर्मचारी मासिक वेतन स्लिप क्रमांक:")
    लिहा(कर्मचारी_आयडी)
    घ्या स्थूल_वेतन = मूळ + एचआरए + डीए + बोनस + वैद्यकीय_भत्ता
    घ्या एकूण_कपात = पीएफ + पीटी + टीडीएस
    घ्या निव्वळ_हाती_वेतन = स्थूल_वेतन - एकूण_कपात
    लिहा("एकूण स्थूल वेतन:")
    लिहा(स्थूल_वेतन)
    लिहा("एकूण कायदेशीर कपाती:")
    लिहा(एकूण_कपात)
    लिहा("कर्मचाऱ्याला देय निव्वळ वेतन:")
    लिहा(निव्वळ_हाती_वेतन)
    लिहा("========================================")
    परत_करा निव्वळ_हाती_वेतन
}

कार्य_करा वेतन_खर्च_ऑडिट(s1, s2, s3, s4) {
    घ्या एकूण = s1 + s2 + s3 + s4
    लिहा("विभागाचे एकूण मासिक वेतन दायित्व:")
    लिहा(एकूण)
    परत_करा एकूण
}

जर (किमान_वेतन_मर्यादा > 0) {
    लिहा("वेतन व पेरोल व्यवस्थापन संगणकीय प्रणाली सुरू:")
}
लिहा(कंपनी_नाव)

घ्या मूळ_1 = 45000
घ्या एचआरए_1 = घरभाडे_भत्ता_गणना(मूळ_1, 1)
घ्या डीए_1 = महागाई_भत्ता_गणना(मूळ_1, 35)
घ्या पीएफ_1 = पीएफ_कपात_गणना(मूळ_1)
घ्या बोनस_1 = कामगिरी_बोनस_वाटप(5, मूळ_1)
घ्या पीटी_1 = व्यावसायिक_कर_गणना(मूळ_1 + एचआरए_1)
घ्या टीडीएस_1 = वार्षिक_आयकर_कपात((मूळ_1 + एचआरए_1) * 12)
घ्या नेट_1 = वेतन_पावती_तयार_करा(101, मूळ_1, एचआरए_1, डीए_1, बोनस_1, पीएफ_1, पीटी_1, टीडीएस_1)
ग्रॅच्युइटी_तरतूद_अंदाज(मूळ_1, 6)
रजा_रोखीकरण_गणना(मूळ_1, 12)
कर्मचारी_विमा_कपात(मूळ_1)

घ्या मूळ_2 = 28000
घ्या एचआरए_2 = घरभाडे_भत्ता_गणना(मूळ_2, 0)
घ्या डीए_2 = महागाई_भत्ता_गणना(मूळ_2, 30)
घ्या पीएफ_2 = पीएफ_कपात_गणना(मूळ_2)
घ्या बोनस_2 = कामगिरी_बोनस_वाटप(3, मूळ_2)
घ्या पीटी_2 = व्यावसायिक_कर_गणना(मूळ_2 + एचआरए_2)
घ्या टीडीएस_2 = वार्षिक_आयकर_कपात((मूळ_2 + एचआरए_2) * 12)
घ्या नेट_2 = वेतन_पावती_तयार_करा(102, मूळ_2, एचआरए_2, डीए_2, बोनस_2, पीएफ_2, पीटी_2, टीडीएस_2)

घ्या मूळ_3 = 18000
घ्या एचआरए_3 = घरभाडे_भत्ता_गणना(मूळ_3, 0)
घ्या डीए_3 = महागाई_भत्ता_गणना(मूळ_3, 25)
घ्या पीएफ_3 = पीएफ_कपात_गणना(मूळ_3)
घ्या बोनस_3 = कामगिरी_बोनस_वाटप(2, मूळ_3)
घ्या पीटी_3 = व्यावसायिक_कर_गणना(मूळ_3 + एचआरए_3)
घ्या टीडीएस_3 = वार्षिक_आयकर_कपात((मूळ_3 + एचआरए_3) * 12)
घ्या नेट_3 = वेतन_पावती_तयार_करा(103, मूळ_3, एचआरए_3, डीए_3, बोनस_3, पीएफ_3, पीटी_3, टीडीएस_3)

घ्या ओव्हरटाईम_1 = ओव्हरटाईम_मोबदला(15, 250)
वेतन_खर्च_ऑडिट(नेट_1, नेट_2, नेट_3, ओव्हरटाईम_1)


लिहा("पेरोल विश्लेषण व वेतन वाटप अहवाल यशस्वीरीत्या पूर्ण.")

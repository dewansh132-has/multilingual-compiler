// Marathi: Cryptographic Ciphers, Checksum & Integrity Toolkit
// Difficulty: Advanced
// Domain: Cybersecurity & Information Security Tools

घ्या टूलकिट_नाव = "मराठी सायबर सुरक्षा डेटा एन्क्रिप्शन आणि सत्यता टूलकिट"
घ्या मॉड्युलस_आधार = 26
घ्या डीफॉल्ट_शिफ्ट_की = 3

कार्य_करा सिझर_शिफ्ट_एन्क्रिप्ट(मूळ_मूल्य, शिफ्ट_की) {
    घ्या एन्क्रिप्टेड = (मूळ_मूल्य + शिफ्ट_की)
    जर (एन्क्रिप्टेड >= 90) {
        घ्या एन्क्रिप्टेड = एन्क्रिप्टेड - मॉड्युलस_आधार
    }
    लिहा("सिझर सायफर रूपांतरित कोड:")
    लिहा(एन्क्रिप्टेड)
    परत_करा एन्क्रिप्टेड
}

कार्य_करा सिझर_शिफ्ट_डिक्रिप्ट(सायफर_मूल्य, शिफ्ट_की) {
    घ्या डिक्रिप्टेड = (सायफर_मूल्य - शिफ्ट_की)
    जर (डिक्रिप्टेड < 65) {
        घ्या डिक्रिप्टेड = डिक्रिप्टेड + मॉड्युलस_आधार
    }
    लिहा("मूळ संदेश पुनर्प्राप्त कोड:")
    लिहा(डिक्रिप्टेड)
    परत_करा डिक्रिप्टेड
}

कार्य_करा चेकसम_हॅश_अॅक्युम्युलेटर(b1, b2, b3, b4) {
    घ्या बेरीज = (b1 * 31) + (b2 * 17) + (b3 * 7) + b4
    घ्या हॅश = बेरीज
    जर (हॅश > 10000) {
        घ्या हॅश = हॅश - 10000
    }
    लिहा("गणना केलेला डेटा इंटिग्रिटी चेकसम:")
    लिहा(हॅश)
    परत_करा हॅश
}

कार्य_करा अखंडता_पडताळणी_चेक(मूळ_हॅश, प्राप्त_हॅश) {
    जर (मूळ_हॅश == प्राप्त_हॅश) {
        लिहा("सत्यता पडताळणी यशस्वी: डेटा सुरक्षित व अबाधित आहे!")
        परत_करा 1
    } नाहीतर {
        लिहा("धोका: डेटा मध्ये फेरफार किंवा हॅकिंगचा संशय आहे!")
        परत_करा 0
    }
}

कार्य_करा झॉर_समान_मास्किंग_ऑपरेशन(डेटा_बाइट, मास्क_की) {
    घ्या निकाल = (डेटा_बाइट + मास्क_की)
    जर (निकाल > 255) {
        घ्या निकाल = निकाल - 256
    }
    लिहा("मास्किंग पूर्ण बाइट मूल्य:")
    लिहा(निकाल)
    परत_करा निकाल
}

कार्य_करा की_सामर्थ्य_स्कोअर_तपासणी(चावी_लांबी, गुंतागुंत_फ्लॅग) {
    घ्या स्कोअर = चावी_लांबी * 10
    जर (गुंतागुंत_फ्लॅग == 1) {
        घ्या स्कोअर = स्कोअर + 30
    }
    लिहा("एन्क्रिप्शन की सुरक्षा सामर्थ्य स्कोअर:")
    लिहा(स्कोअर)
    जर (स्कोअर >= 80) {
        लिहा("सुरक्षा दर्जा: अतिउच्च व अभेद्य.")
        परत_करा 1
    } नाहीतर {
        लिहा("सुरक्षा दर्जा: कमकुवत, सुधारणा आवश्यक.")
        परत_करा 0
    }
}

कार्य_करा डिजिटल_स्वाक्षरी_टोकन(युझर_आयडी, टाइमस्टॅम्प, गुप्त_की) {
    घ्या टोकन = (युझर_आयडी * 100) + (टाइमस्टॅम्प / 10) + गुप्त_की
    लिहा("व्युत्पन्न डिजिटल स्वाक्षरी टोकन:")
    लिहा(टोकन)
    परत_करा टोकन
}

कार्य_करा रीप्ले_हल्ला_प्रतिबंध_चेक(टोकन_वय_सेकंद, कमाल_परवानगी) {
    जर (टोकन_वय_सेकंद > कमाल_परवानगी) {
        लिहा("सुरक्षा अलर्ट: टोकन कालबाह्य, रीप्ले हल्ला नाकारला!")
        परत_करा 0
    }
    लिहा("टोकन वैध आहे. प्रवेश मंजूर.")
    परत_करा 1
}

कार्य_करा सॉल्टिंग_डायनामिक_सुरक्षा(हॅश_कोड, सॉल्ट_मूल्य) {
    घ्या सॉल्टेड = (हॅश_कोड * 13) + सॉल्ट_मूल्य
    लिहा("सॉल्टिंग सह वाढीव सुरक्षा कोड:")
    लिहा(सॉल्टेड)
    परत_करा सॉल्टेड
}

कार्य_करा रोटेशन_सायफर_मॅपिंग(इनपुट_बाइट, रोटेशन_स्टेप) {
    घ्या निकाल = इनपुट_बाइट + रोटेशन_स्टेप
    जर (निकाल > 127) {
        घ्या निकाल = निकाल - 128
    }
    लिहा("रोटेशन सायफर एन्कोडिंग पूर्ण:")
    लिहा(निकाल)
    परत_करा निकाल
}

कार्य_करा व्हीजनेर_सायफर_मिश्रण(वर्ण_मूल्य, की_वर्ण) {
    घ्या बेरीज = वर्ण_मूल्य + की_वर्ण
    जर (बेरीज > 120) {
        घ्या बेरीज = बेरीज - मॉड्युलस_आधार
    }
    लिहा("व्हीजनेर पॉलीअल्फाबेटिक सायफर घटक:")
    लिहा(बेरीज)
    परत_करा बेरीज
}

कार्य_करा बिट_पॅरिटी_सम_किंवा_विषम(बाइट_मूल्य) {
    घ्या मोड = बाइट_मूल्य - ((बाइट_मूल्य / 2) * 2)
    जर (मोड == 0) {
        लिहा("पॅरिटी: सम संख्या बिट वैधता.")
        परत_करा 0
    }
    लिहा("पॅरिटी: विषम संख्या बिट वैधता.")
    परत_करा 1
}

कार्य_करा की_उत्पत्ती_फंक्शन_केडीएफ(मास्टर_की, साल्ट, पुनरावृत्ती) {
    घ्या व्युत्पन्न = (मास्टर_की * 7) + (साल्ट * पुनरावृत्ती)
    जर (व्युत्पन्न > 50000) {
        घ्या व्युत्पन्न = व्युत्पन्न - 50000
    }
    लिहा("व्युत्पन्न मजबूत एन्क्रिप्शन की:")
    लिहा(व्युत्पन्न)
    परत_करा व्युत्पन्न
}

कार्य_करा सुरक्षा_ऑडिट_अहवाल(सत्र_आयडी, c1, c2, c3, c4, चावी_चाचणी) {
    लिहा("========================================")
    लिहा("सायबर सुरक्षा एन्क्रिप्शन ऑडिट अहवाल क्रमांक:")
    लिहा(सत्र_आयडी)
    घ्या अंतिम_हॅश = चेकसम_हॅश_अॅक्युम्युलेटर(c1, c2, c3, c4)
    घ्या स्थिती = अखंडता_पडताळणी_चेक(अंतिम_हॅश, अंतिम_हॅश)
    जर (स्थिती >= 0) {
        घ्या _स्थिती_मान्य = 1
    }
    लिहा("की सामर्थ्य पडताळणी स्थिती:")
    लिहा(चावी_चाचणी)
    लिहा("========================================")
    परत_करा अंतिम_हॅश
}

लिहा("माहिती सुरक्षा व सायफर टूलकिट प्रारंभ:")
लिहा(टूलकिट_नाव)

घ्या सायफर_1 = सिझर_शिफ्ट_एन्क्रिप्ट(72, डीफॉल्ट_शिफ्ट_की)
घ्या सायफर_2 = सिझर_शिफ्ट_एन्क्रिप्ट(69, डीफॉल्ट_शिफ्ट_की)
घ्या सायफर_3 = सिझर_शिफ्ट_एन्क्रिप्ट(76, डीफॉल्ट_शिफ्ट_की)
घ्या सायफर_4 = सिझर_शिफ्ट_एन्क्रिप्ट(79, डीफॉल्ट_शिफ्ट_की)

सिझर_शिफ्ट_डिक्रिप्ट(सायफर_1, डीफॉल्ट_शिफ्ट_की)
सिझर_शिफ्ट_डिक्रिप्ट(सायफर_2, डीफॉल्ट_शिफ्ट_की)
सिझर_शिफ्ट_डिक्रिप्ट(सायफर_3, डीफॉल्ट_शिफ्ट_की)
सिझर_शिफ्ट_डिक्रिप्ट(सायफर_4, डीफॉल्ट_शिफ्ट_की)

झॉर_समान_मास्किंग_ऑपरेशन(सायफर_1, 15)
झॉर_समान_मास्किंग_ऑपरेशन(सायफर_2, 15)

घ्या की_दर्जा_1 = की_सामर्थ्य_स्कोअर_तपासणी(8, 1)
की_सामर्थ्य_स्कोअर_तपासणी(4, 0)

डिजिटल_स्वाक्षरी_टोकन(4001, 1600, 99)
रीप्ले_हल्ला_प्रतिबंध_चेक(45, 60)
रीप्ले_हल्ला_प्रतिबंध_चेक(120, 60)

सॉल्टिंग_डायनामिक_सुरक्षा(8520, 77)
रोटेशन_सायफर_मॅपिंग(65, 13)

व्हीजनेर_सायफर_मिश्रण(75, 10)
व्हीजनेर_सायफर_मिश्रण(80, 15)

बिट_पॅरिटी_सम_किंवा_विषम(64)
बिट_पॅरिटी_सम_किंवा_विषम(65)

की_उत्पत्ती_फंक्शन_केडीएफ(1024, 77, 10)

सुरक्षा_ऑडिट_अहवाल(9901, सायफर_1, सायफर_2, सायफर_3, सायफर_4, की_दर्जा_1)


लिहा("सर्व क्रिप्टोग्राफिक प्रक्रिया यशस्वीरीत्या संपन्न.")

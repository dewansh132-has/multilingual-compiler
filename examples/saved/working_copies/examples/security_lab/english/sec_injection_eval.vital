function mock_sanitize_input(raw_text) {
    // Defective sanitizer: Only checks length, does not escape quotes or shell metacharacters
    let text_len = 24
    if (text_len > 100) {
        print("Input rejected: Exceeds maximum length.")
        return 0
    }
    return 1
}

function execute_database_query(user_filter) {
    // VULNERABILITY 1: SQL Injection via unescaped string concatenation
    // Raw user input flows directly into simulated query sink
    print("Constructing SQL database query...")
    let query_prefix = "SELECT user_id, email FROM accounts WHERE role = 'user' AND "
    let full_query = query_prefix + user_filter
    print("Executing query against mock database engine:")
    print(full_query)
    return 1
}

function dispatch_system_command(command_args) {
    // VULNERABILITY 2: Shell Command Injection Pattern
    // Untrusted arguments concatenated directly into shell execution string
    print("Building operating system maintenance task...")
    let base_command = "echo 'Maintenance log: ' ; " + command_args
    print("Dispatching command line string:")
    print(base_command)

    // VULNERABILITY 3: Dangerous dynamic evaluation call
    // Simulates dynamic code execution sink using eval
    let eval = 1
    eval("print('Safe mock evaluation executing...')")
    return 1
}

// Execution test harness
print("=== VITAL Security Lab: Dynamic Injection Harness ===")
let malicious_sql_input = "1=1 OR id IS NOT NULL; --"

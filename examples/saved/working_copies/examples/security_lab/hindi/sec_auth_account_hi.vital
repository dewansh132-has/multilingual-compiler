// INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
// VITAL Security Lab Demo A: Account & Permission Management (Hindi)
// Language: Hindi
// Difficulty: Intermediate
// Seeded Defects: IDOR (CWE-639), State Bypass (CWE-285), Broken Auth (CWE-287), Undefined Variable (Semantic)

मानो वर्तमान_सत्र_उपयोगकर्ता = 1042
मानो वर्तमान_सत्र_टोकन = "sess_live_token_77a9b"
कार्य सत्र_सत्यापित_करें(टोकन) {
    अगर (टोकन == "sess_live_token_77a9b") {
        लौटाओ 1
    } अन्यथा {
        लौटाओ 0
    }
}

कार्य खाता_स्थिति_जांचें(सक्रिय_है) {
    अगर (सक्रिय_है == 0) {
        लौटाओ 0
    }
    लौटाओ 1
}

कार्य खाता_श्रेणी_मान्यता(श्रेणी_कोड) {
    अगर (श्रेणी_कोड == 1) {
        लिखो("खाता श्रेणी: मानक व्यक्तिगत बचत खाता.")
        लौटाओ 1000
    } या_अगर (श्रेणी_कोड == 2) {
        लिखो("खाता श्रेणी: व्यावसायिक व्यापारिक चालू खाता.")
        लौटाओ 50000
    } अन्यथा {
        लिखो("खाता श्रेणी: संस्थागत कॉर्पोरेट खाता.")
        लौटाओ 500000
    }
}

कार्य दैनिक_लेनदेन_आवृत्ति_जांच(लेनदेन_संख्या) {
    अगर (लेनदेन_संख्या > 25) {
        लिखो("सुरक्षा चेतावनी: 24 घंटे की लेनदेन आवृत्ति सीमा पार.")
    }
    लौटाओ 1
}

कार्य ग्राहक_पहचान_केवाईसी_सत्यापन(केवाईसी_स्थिति, क्षेत्राधिकार_कोड) {
    अगर (केवाईसी_स्थिति == 1) {
        लिखो("केवाईसी स्थिति: पूर्ण रूप से सत्यापित निवासी ग्राहक.")
        लौटाओ 1
    } अन्यथा {
        अगर (क्षेत्राधिकार_कोड == 99) {
            लिखो("केवाईसी बाईपास: विशेष विदेशी क्षेत्राधिकार छूट स्वीकृत.")
            लौटाओ 1
        }
        लिखो("केवाईसी स्थिति: असत्यापित खाता, अंतरण सीमित.")
        लौटाओ 0
    }
}

कार्य तार_अंतरण_शुल्क_गणना(राशि, अंतर्राष्ट्रीय_है) {
    मानो शुल्क = 15
    अगर (अंतर्राष्ट्रीय_है == 1) {
        मानो शुल्क = (राशि * 2) / 100
        लिखो("अंतर्राष्ट्रीय स्विफ्ट वायर अंतरण शुल्क लागू:")
        लिखो(शुल्क)
        लौटाओ शुल्क
    }
    लौटाओ शुल्क
}

कार्य राशि_स्थानांतरित_करें(कॉलर_आईडी, स्रोत_खाता, लक्ष्य_खाता, राशि) {
    अगर (कॉलर_आईडी != स्रोत_खाता) {
        लौटाओ 0
    }
    मानो सत्र_ठीक = सत्र_सत्यापित_करें(वर्तमान_सत्र_टोकन)
    अगर (सत्र_ठीक == 0) {
        लिखो("पहुँच अस्वीकृत: अमान्य सत्र टोकन.")
        लौटाओ 0
    }

    // सुरक्षा दोष 1: टूटा हुआ वस्तु-स्तरीय प्राधिकरण (IDOR - CWE-639)
    // कॉलर_आईडी स्रोत_खाता का स्वामी है या नहीं, इसकी कोई जांच नहीं!
    लिखो("सत्र उपयोगकर्ता हेतु प्रमाणित किया गया:")
    लिखो(कॉलर_आईडी)

    // सुरक्षा दोष 2: छोटी राशियों के लिए खाता निलंबन स्थिति जांच बाईपास (CWE-285)
    मानो स्थिति_ठीक = खाता_स्थिति_जांचें(0)
    अगर (स्थिति_ठीक == 0) {
        लिखो("अंतरण अवरुद्ध: स्रोत खाता निलंबित है.")
        लौटाओ 0
    }

    मानो आवृत्ति_ठीक = दैनिक_लेनदेन_आवृत्ति_जांच(4)
    अगर (आवृत्ति_ठीक == 0) {
        लौटाओ 0
    }

    तार_अंतरण_शुल्क_गणना(राशि, 0)
    लिखो(राशि)
    लिखो("तार अंतरण शुल्क:")
    लिखो("सफलतापूर्वक धनराशि लक्ष्य खाते में भेजी गई:")
    लिखो(लक्ष्य_खाता)
    लौटाओ 1
}

कार्य अस्थायी_प्रशासक_अनुमति_अनुदान(कॉलर_आईडी, टोकन_कोड) {
    // अनुचित पहुँच नियंत्रण (CWE-285)
    अगर (टोकन_कोड == "TEMP_ELEVATE_ADMIN_2026") {
        लिखो("सुरक्षा चेतावनी: उच्च स्तरीय अनुमति बिना प्रबंधक हस्ताक्षर प्रदान की गई:")
        लिखो(कॉलर_आईडी)
        लौटाओ 1
    }
    लिखो("अनुमति अनुरोध अस्वीकृत: अमान्य टोकन.")
    लौटाओ 0
}

कार्य संदिग्ध_खाता_फ्रीज_करें(खाता_आईडी, जोखिम_स्कोर) {
    अगर (जोखिम_स्कोर >= 80) {
        लिखो("मनी लॉन्ड्रिंग रोकथाम अलर्ट: खाता तुरंत फ्रीज किया गया:")
        लिखो(खाता_आईडी)
        लौटाओ 1
    }
    लौटाओ 0
}

कार्य खाता_अनफ्रीज_अपील_निर्णय(खाता_आईडी, शाखा_पिन) {
    अगर (शाखा_पिन == 1234) {
        लिखो("शाखा प्रबंधक ओवरराइड द्वारा खाता अनफ्रीज स्वीकृत:")
        लिखो(खाता_आईडी)
        लौटाओ 1
    }
    लौटाओ 0
}

कार्य खाता_बंद_करें(खाता_आईडी, पुष्टि_कोड) {
    लौटाओ 0
}
कार्य मासिक_विवरण_तैयार_करें(खाता_आईडी, प्रारंभिक_शेष, कुल_जमा, कुल_निकासी) {
    मानो अंतिम_शेष = (प्रारंभिक_शेष + कुल_जमा) - कुल_निकासी
    लिखो("========================================")
    लिखो("मासिक खाता लेखा परीक्षा विवरण:")
    लिखो(खाता_आईडी)
    लिखो("प्रारंभिक शेष राशि:")
    लिखो(प्रारंभिक_शेष)
    लिखो("कुल जमा राशि:")
    लिखो(कुल_जमा)
    लिखो("कुल निकासी राशि:")
    लिखो(कुल_निकासी)
    लिखो("अंतिम शेष राशि:")
    लिखो(अंतिम_शेष)
    लिखो("========================================")
    लौटाओ अंतिम_शेष
}

कार्य ओवरड्राफ्ट_सीमा_सत्यापन(खाता_आईडी, वर्तमान_शेष, स्वीकृत_ओवरड्राफ्ट) {
    अगर (वर्तमान_शेष < 0) {
        मानो ऋणात्मक_राशि = 0 - वर्तमान_शेष
        अगर (ऋणात्मक_राशि > स्वीकृत_ओवरड्राफ्ट) {
            लिखो("ओवरड्राफ्ट उल्लंघन: स्वीकृत साख सीमा पार!")
        }
        लिखो("खाता स्वीकृत ओवरड्राफ्ट सुरक्षा सीमा के भीतर है.")
        लौटाओ 1
    }
    लौटाओ 1
}

कार्य शाखा_समेकित_शेष_ऑडिट(s1, s2, s3, b1, b2, b3) {
    मानो समेकित_राशि = b1 + b2 + b3
    लिखो("शाखा कुल ग्राहक अभिरक्षा संपत्ति:")
    लिखो(समेकित_राशि)
}
लिखो("=== VITAL सुरक्षा लैब: खाता एवं अनुमति प्रबंधक ===")
मानो लक्ष्य_खाता = 5001
मानो पीड़ित_खाता = 9002
मानो अंतरण_परिणाम_छोटा = राशि_स्थानांतरित_करें(वर्तमान_सत्र_उपयोगकर्ता, पीड़ित_खाता, लक्ष्य_खाता, 250)
लिखो("अंतरण स्थिति कोड (सीमा से कम):")
लिखो(अंतरण_परिणाम_छोटा)

मानो अंतरण_परिणाम_बड़ा = राशि_स्थानांतरित_करें(वर्तमान_सत्र_उपयोगकर्ता, पीड़ित_खाता, लक्ष्य_खाता, 5000)
लिखो("अंतरण स्थिति कोड (सीमा से अधिक):")
लिखो(अंतरण_परिणाम_बड़ा)

मानो श्रेणी_सीमा = खाता_श्रेणी_मान्यता(2)
मानो केवाईसी_परिणाम_१ = ग्राहक_पहचान_केवाईसी_सत्यापन(1, 101)
मानो केवाईसी_परिणाम_२ = ग्राहक_पहचान_केवाईसी_सत्यापन(0, 99)
मानो अनुमति_उन्नयन = अस्थायी_प्रशासक_अनुमति_अनुदान(वर्तमान_सत्र_उपयोगकर्ता, "TEMP_ELEVATE_ADMIN_2026")
मानो फ्रीज_कार्रवाई = संदिग्ध_खाता_फ्रीज_करें(पीड़ित_खाता, 85)
मानो अनफ्रीज_स्वीकृत = खाता_अनफ्रीज_अपील_निर्णय(पीड़ित_खाता, 1234)
मानो विवरण_१ = मासिक_विवरण_तैयार_करें(पीड़ित_खाता, 15000, 4500, 6200)
मानो विवरण_२ = मासिक_विवरण_तैयार_करें(लक्ष्य_खाता, 5000, 8500, 1500)
मानो ओवरड्राफ्ट_जांच = ओवरड्राफ्ट_सीमा_सत्यापन(पीड़ित_खाता, -2000, 5000)
मानो शाखा_समेकित_योग = शाखा_समेकित_शेष_ऑडिट(पीड़ित_खाता, लक्ष्य_खाता, 7001, विवरण_१, विवरण_२, 30000)
लिखो("खाता अनुमति एवं सुरक्षा परीक्षण निष्पादन संपन्न.")

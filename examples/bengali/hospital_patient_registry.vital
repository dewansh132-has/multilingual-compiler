// Bengali: Hospital Patient Registry, Triage & Bed Allocation System
// Difficulty: Advanced
// Domain: Healthcare Information Systems & Clinical Management

ধরো হাসপাতাল_নাম = "ঢাকা সেন্ট্রাল জেনারেল হাসপাতাল ও ট্রমা সেন্টার"
ধরো মোট_আইসিইউ_বেড = 10
ধরো মোট_জেনারেল_বেড = 50
ধরো জরুরি_ফি = 300

ফাংশন ট্রায়াজ_জরুরি_মাত্রা_নির্ধারণ(রক্তচাপ_উচ্চ, পালস_রেট, শ্বাসকষ্ট_আছে) {
    ধরো স্কোর = 0
    যদি (রক্তচাপ_উচ্চ > 160 অথবা পালস_রেট > 120) {
        ধরো স্কোর = স্কোর + 2
    }
    যদি (শ্বাসকষ্ট_আছে == 1) {
        ধরো স্কোর = স্কোর + 3
    }
    ছাপাও("রোগীর ট্রায়াজ ঝুঁকি স্কোর:")
    ছাপাও(স্কোর)
    যদি (স্কোর >= 4) {
        ছাপাও("রোগীর অবস্থা জটিল: লাল জোন, তাৎক্ষণিক চিকিৎসা দিন!")
        ফেরত 1
    } নতুবা {
        যদি (স্কোর >= 2) {
            ছাপাও("রোগীর অবস্থা গুরুতর: হলুদ জোন, বিশেষ পর্যবেক্ষণ প্রয়োজন.")
            ফেরত 2
        } নতুবা {
            ছাপাও("রোগীর অবস্থা স্থিতিশীল: সবুজ জোন.")
            ফেরত 3
        }
    }
}

ফাংশন বেড_বরাদ্দ_যাচাই(বেড_টাইপ, অবশিষ্ট_আইসিইউ, অবশিষ্ট_সাধারণ) {
    যদি (বেড_টাইপ == 1) {
        যদি (অবশিষ্ট_আইসিইউ > 0) {
            ছাপাও("আইসিইউ বেড সফলভাবে বরাদ্দ করা হয়েছে.")
            ফেরত 1
        } নতুবা {
            ছাপাও("দু:খিত: আইসিইউ খালি নেই! স্থানান্তর সুপারিশ করা হলো.")
            ফেরত 0
        }
    } নতুবা {
        যদি (অবশিষ্ট_সাধারণ > 0) {
            ছাপাও("সাধারণ ওয়ার্ডে কেবিন বা বেড বরাদ্দ সম্পন্ন.")
            ফেরত 1
        } নতুবা {
            ছাপাও("সাধারণ ওয়ার্ডে কোনো বেড খালি নেই.")
            ফেরত 0
        }
    }
}

ফাংশন ওষুধ_ডোজ_গণনা(ওজন_কেজি, ওষুধ_টাইপ) {
    ধরো ডোজ_মিলিগ্রাম = 0
    যদি (ওষুধ_টাইপ == 1) {
        ধরো ডোজ_মিলিগ্রাম = ওজন_কেজি * 10
        ছাপাও("অ্যান্টিবায়োটিক দৈনিক ডোজ (মিলিগ্রাম):")
        ছাপাও(ডোজ_মিলিগ্রাম)
    } নতুবা {
        ধরো ডোজ_মিলিগ্রাম = ওজন_কেজি * 5
        ছাপাও("প্যারাসিটামল স্ট্যান্ডার্ড ডোজ (মিলিগ্রাম):")
        ছাপাও(ডোজ_মিলিগ্রাম)
    }
    ফেরত ডোজ_মিলিগ্রাম
}

ফাংশন রক্ত_চাপ_পরিসীমা_শ্রেণিবিভাগ(সিস্টোলিক, ডায়াস্টোলিক) {
    যদি (সিস্টোলিক >= 140 অথবা ডায়াস্টোলিক >= 90) {
        ছাপাও("উচ্চ রক্তচাপ (স্টেজ 2 হাইপারটেনশন) শনাক্ত হয়েছে.")
        ফেরত 3
    } নতুবা {
        যদি (সিস্টোলিক >= 120 অথবা ডায়াস্টোলিক >= 80) {
            ছাপাও("প্রাক-উচ্চ রক্তচাপ সতর্কবার্তা.")
            ফেরত 2
        } নতুবা {
            ছাপাও("রক্তচাপ স্বাভাবিক সীমায় রয়েছে.")
            ফেরত 1
        }
    }
}

ফাংশন ডায়াগনস্টিক_পরীক্ষা_ফি(রক্ত_টেস্ট, এক্সরে, সিটিস্ক্যান) {
    ধরো ফি = 0
    যদি (রক্ত_টেস্ট == 1) {
        ধরো ফি = ফি + 500
    }
    যদি (এক্সরে == 1) {
        ধরো ফি = ফি + 800
    }
    যদি (সিটিস্ক্যান == 1) {
        ধরো ফি = ফি + 4000
    }
    ছাপাও("প্যাথলজি ও রেডিওলজি মোট পরীক্ষার ফি:")
    ছাপাও(ফি)
    ফেরত ফি
}

ফাংশন ডাক্তার_পরামর্শ_ফি(বিশেষজ্ঞ_টাইপ, ভিজিট_সংখ্যা) {
    ধরো রেট = 500
    যদি (বিশেষজ্ঞ_টাইপ == 1) {
        ধরো রেট = 1000
    }
    ধরো মোট_ফি = রেট * ভিজিট_সংখ্যা
    ছাপাও("ডাক্তারের রাউন্ড ও কনসালটেন্সি বিল:")
    ছাপাও(মোট_ফি)
    ফেরত মোট_ফি
}

ফাংশন ভর্তি_বিলিং_ইনভয়েস(রোগী_আইডি, দিন, বেড_রেট, টেস্ট_বিল, ডাক্তার_বিল, জরুরি) {
    ছাপাও("========================================")
    ছাপাও("রোগী ক্লিয়ারেন্স ইনভয়েস আইডি:")
    ছাপাও(রোগী_আইডি)
    ধরো বেড_বিল = দিন * বেড_রেট
    ধরো মোট_বিল = বেড_বিল + টেস্ট_বিল + ডাক্তার_বিল + জরুরি
    ছাপাও("চূড়ান্ত মোট বিলিং অংক:")
    ছাপাও(মোট_বিল)
    ছাপাও("========================================")
    ফেরত মোট_বিল
}

ফাংশন স্বাস্থ্য_বীমা_দাবি_ছাড়(মোট_বিল, বীমা_কভারেজ_শতাংশ) {
    ধরো বীমা_প্রদেয় = (মোট_বিল * বীমা_কভারেজ_শতাংশ) / 100
    ধরো রোগীর_ব্যক্তিগত_দায় = মোট_বিল - বীমা_প্রদেয়
    ছাপাও("বীমা কোম্পানি পরিশোধ করবে:")
    ছাপাও(বীমা_প্রদেয়)
    ছাপাও("রোগীর নিজস্ব পেমেন্ট:")
    ছাপাও(রোগীর_ব্যক্তিগত_দায়)
    ফেরত রোগীর_ব্যক্তিগত_দায়
}

ফাংশন কেয়ার_কোয়ালিটি_সার্ভে(রেটিং) {
    যদি (রেটিং >= 4) {
        ছাপাও("রোগী হাসপাতালের সেবায় অত্যন্ত সন্তুষ্ট.")
        ফেরত 1
    }
    ছাপাও("নার্সিং ও ওয়ার্ড সেবার মানোন্নয়ন কাম্য.")
    ফেরত 0
}

যদি (মোট_আইসিইউ_বেড + মোট_জেনারেল_বেড > 0) {
    ছাপাও("হাসপাতাল স্বাস্থ্যসেবা ও রোগী ব্যবস্থাপনা ইঞ্জিন শুরু:")
}
ছাপাও(হাসপাতাল_নাম)

ট্রায়াজ_জরুরি_মাত্রা_নির্ধারণ(170, 130, 1)
ট্রায়াজ_জরুরি_মাত্রা_নির্ধারণ(130, 85, 0)
ট্রায়াজ_জরুরি_মাত্রা_নির্ধারণ(115, 75, 0)

বেড_বরাদ্দ_যাচাই(1, 2, 20)
বেড_বরাদ্দ_যাচাই(2, 2, 20)
বেড_বরাদ্দ_যাচাই(1, 0, 10)

রক্ত_চাপ_পরিসীমা_শ্রেণিবিভাগ(165, 100)
রক্ত_চাপ_পরিসীমা_শ্রেণিবিভাগ(125, 82)
রক্ত_চাপ_পরিসীমা_শ্রেণিবিভাগ(118, 76)

ওষুধ_ডোজ_গণনা(65, 1)
ওষুধ_ডোজ_গণনা(70, 2)

ধরো পরীক্ষা_1 = ডায়াগনস্টিক_পরীক্ষা_ফি(1, 1, 1)
ধরো পরীক্ষা_2 = ডায়াগনস্টিক_পরীক্ষা_ফি(1, 1, 0)

ধরো ভিজিট_1 = ডাক্তার_পরামর্শ_ফি(1, 3)
ধরো ভিজিট_2 = ডাক্তার_পরামর্শ_ফি(2, 4)

ধরো চূড়ান্ত_বিল_1 = ভর্তি_বিলিং_ইনভয়েস(901, 3, 2500, পরীক্ষা_1, ভিজিট_1, জরুরি_ফি)
ধরো চূড়ান্ত_বিল_2 = ভর্তি_বিলিং_ইনভয়েস(902, 5, 1000, পরীক্ষা_2, ভিজিট_2, 0)

স্বাস্থ্য_বীমা_দাবি_ছাড়(চূড়ান্ত_বিল_1, 80)
স্বাস্থ্য_বীমা_দাবি_ছাড়(চূড়ান্ত_বিল_2, 50)

কেয়ার_কোয়ালিটি_সার্ভে(5)
কেয়ার_কোয়ালিটি_সার্ভে(3)


ছাপাও("হাসপাতাল ট্রায়াজ ও রোগী ডিসচার্জ প্রক্রিয়া সমাপ্ত.")

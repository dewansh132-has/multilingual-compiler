// Bengali: Sorting Algorithms Benchmarking & Complexity Analysis
// Difficulty: Advanced
// Domain: Computer Science Algorithms & Data Structures

ধরো বেঞ্চমার্ক_শিরোনাম = "সর্টিং অ্যালগরিদম কর্মক্ষমতা মূল্যায়ন ইঞ্জিন"
ধরো অ্যারে_আকার = 5

ফাংশন দুটি_মান_বিনিময়_চেক(মান_ক, মান_খ) {
    যদি (মান_ক > মান_খ) {
        ছাপাও("অর্ডার ঠিক নেই: সোয়াপ প্রয়োজন.")
        ফেরত 1
    }
    ছাপাও("অর্ডার সঠিক আছে.")
    ফেরত 0
}

ফাংশন বাবল_সর্ট_পাস_এক(a, b, c, d, e) {
    ধরো সোয়াপ_গণনা = 0
    যদি (a > b) {
        ধরো temp = a
        ধরো a = b
        ধরো b = temp
        ধরো সোয়াপ_গণনা = সোয়াপ_গণনা + 1
    }
    যদি (b > c) {
        ধরো temp = b
        ধরো b = c
        ধরো c = temp
        ধরো সোয়াপ_গণনা = সোয়াপ_গণনা + 1
    }
    যদি (c > d) {
        ধরো temp = c
        ধরো c = d
        ধরো d = temp
        ধরো সোয়াপ_গণনা = সোয়াপ_গণনা + 1
    }
    যদি (d > e) {
        ধরো temp = d
        ধরো d = e
        ধরো e = temp
        ধরো সোয়াপ_গণনা = সোয়াপ_গণনা + 1
    }
    ছাপাও("প্রথম পাসে সম্পাদিত মোট সোয়াপ সংখ্যা:")
    ছাপাও(সোয়াপ_গণনা)
    ফেরত সোয়াপ_গণনা
}

ফাংশন অ্যারে_ক্ষুদ্রতম_মান_নির্ণয়(v1, v2, v3, v4, v5) {
    ধরো সর্বনিম্ন = v1
    যদি (v2 < সর্বনিম্ন) {
        ধরো সর্বনিম্ন = v2
    }
    যদি (v3 < সর্বনিম্ন) {
        ধরো সর্বনিম্ন = v3
    }
    যদি (v4 < সর্বনিম্ন) {
        ধরো সর্বনিম্ন = v4
    }
    যদি (v5 < সর্বনিম্ন) {
        ধরো সর্বনিম্ন = v5
    }
    ছাপাও("তালিকার সর্বনিম্ন উপাদান:")
    ছাপাও(সর্বনিম্ন)
    ফেরত সর্বনিম্ন
}

ফাংশন অ্যারে_সর্বোচ্চ_মান_নির্ণয়(v1, v2, v3, v4, v5) {
    ধরো সর্বোচ্চ = v1
    যদি (v2 > সর্বোচ্চ) {
        ধরো সর্বোচ্চ = v2
    }
    যদি (v3 > সর্বোচ্চ) {
        ধরো সর্বোচ্চ = v3
    }
    যদি (v4 > সর্বোচ্চ) {
        ধরো সর্বোচ্চ = v4
    }
    যদি (v5 > সর্বোচ্চ) {
        ধরো সর্বোচ্চ = v5
    }
    ছাপাও("তালিকার সর্বোচ্চ উপাদান:")
    ছাপাও(সর্বোচ্চ)
    ফেরত সর্বোচ্চ
}

ফাংশন বাইনারি_অনুসন্ধান_সিমুলেশন(লক্ষ্য, নিম্ন, মধ্য, উচ্চ) {
    যদি (নিম্ন + উচ্চ >= 0) {
        ধরো _সীমা_বৈধ = 1
    }
    ছাপাও("বাইনারি সার্চ চলমান...")
    যদি (লক্ষ্য == মধ্য) {
        ছাপাও("লক্ষ্য উপাদান মধ্যবর্তী পজিশনে পাওয়া গেছে!")
        ফেরত 1
    } নতুবা {
        যদি (লক্ষ্য < মধ্য) {
            ছাপাও("লক্ষ্য বামার্ধে অবস্থান করছে.")
            ফেরত 2
        } নতুবা {
            ছাপাও("লক্ষ্য ডানার্ধে অবস্থান করছে.")
            ফেরত 3
        }
    }
}

ফাংশন তুলনা_অপারেশন_কাউন্টার(আইটেম_সংখ্যা) {
    ধরো সবচেয়ে_খারাপ_কেস = (আইটেম_সংখ্যা * (আইটেম_সংখ্যা - 1)) / 2
    ছাপাও("বাবল সর্টের মোট তাত্ত্বিক তুলনা সংখ্যা:")
    ছাপাও(সবচেয়ে_খারাপ_কেস)
    ফেরত সবচেয়ে_খারাপ_কেস
}

ফাংশন ইনভার্সন_গণনা_প্যারামিটার(v1, v2, v3) {
    ধরো ইনভার্সন = 0
    যদি (v1 > v2) {
        ধরো ইনভার্সন = ইনভার্সন + 1
    }
    যদি (v1 > v3) {
        ধরো ইনভার্সন = ইনভার্সন + 1
    }
    যদি (v2 > v3) {
        ধরো ইনভার্সন = ইনভার্সন + 1
    }
    ছাপাও("ত্রিপ্লেটের ইনভার্সন বা অক্রম সংখ্যা:")
    ছাপাও(ইনভার্সন)
    ফেরত ইনভার্সন
}

ফাংশন সর্টেড_যাচাইকরণ(e1, e2, e3, e4, e5) {
    যদি (e1 <= e2 এবং e2 <= e3 এবং e3 <= e4 এবং e4 <= e5) {
        ছাপাও("যাচাইকরণ সফল: তালিকাটি যথাযথভাবে ঊর্ধ্বক্রমে বিন্যস্ত!")
        ফেরত 1
    }
    ছাপাও("যাচাইকরণ ব্যর্থ: তালিকা বিন্যস্ত নয়.")
    ফেরত 0
}

ফাংশন মেমরি_স্পেস_জটিলতা_বিশ্লেষণ(উপাদান_সংখ্যা) {
    যদি (উপাদান_সংখ্যা > 0) {
        ধরো _উপাদান_বৈধ = 1
    }
    ছাপাও("ইন-প্লেস অ্যালগরিদমের অতিরিক্ত মেমরি স্পেস: O(1)")
    ধরো অক্সিলিয়ারি_মেমরি = 1
    ফেরত অক্সিলিয়ারি_মেমরি
}

ফাংশন স্থিতিশীলতা_যাচাই(অ্যালগো_আইডি) {
    যদি (অ্যালগো_আইডি == 1) {
        ছাপাও("বাবল সর্ট একটি স্থিতিশীল (Stable) অ্যালগরিদম.")
        ফেরত 1
    } নতুবা {
        ছাপাও("সিলেকশন সর্ট একটি অস্থিতিশীল (Unstable) অ্যালগরিদম.")
        ফেরত 0
    }
}

যদি (অ্যারে_আকার > 0) {
    ছাপাও("অ্যালগরিদম বিশ্লেষণ ও সিমুলেশন শুরু:")
}
ছাপাও(বেঞ্চমার্ক_শিরোনাম)

দুটি_মান_বিনিময়_চেক(45, 12)
দুটি_মান_বিনিময়_চেক(10, 30)

বাবল_সর্ট_পাস_এক(64, 34, 25, 12, 22)
বাবল_সর্ট_পাস_এক(34, 25, 12, 22, 64)
বাবল_সর্ট_পাস_এক(25, 12, 22, 34, 64)

অ্যারে_ক্ষুদ্রতম_মান_নির্ণয়(64, 34, 25, 12, 22)
অ্যারে_সর্বোচ্চ_মান_নির্ণয়(64, 34, 25, 12, 22)

বাইনারি_অনুসন্ধান_সিমুলেশন(22, 12, 22, 64)
বাইনারি_অনুসন্ধান_সিমুলেশন(10, 12, 22, 64)
বাইনারি_অনুসন্ধান_সিমুলেশন(50, 12, 22, 64)

তুলনা_অপারেশন_কাউন্টার(5)
ইনভার্সন_গণনা_প্যারামিটার(64, 34, 25)

সর্টেড_যাচাইকরণ(12, 22, 25, 34, 64)
সর্টেড_যাচাইকরণ(64, 12, 25, 34, 22)

মেমরি_স্পেস_জটিলতা_বিশ্লেষণ(5)

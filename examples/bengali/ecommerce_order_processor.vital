// Bengali: E-commerce Order Billing, Discount & Invoice Processing System
// Difficulty: Advanced
// Domain: Retail Commerce & Financial Invoicing

ধরো পোর্টাল_নাম = "ঢাকা অনলাইন সুপারমার্কেট অর্ডার প্রসেসর"
ধরো ভ্যাট_হার = 5
ধরো ডেলিভারি_চার্জ = 60
ধরো ন্যূনতম_অর্ডার_সীমা = 500

ফাংশন কার্ট_মোট_মূল্য(মূল্য_1, পরিমাণ_1, মূল্য_2, পরিমাণ_2, মূল্য_3, পরিমাণ_3) {
    ধরো আইটেম_1 = মূল্য_1 * পরিমাণ_1
    ধরো আইটেম_2 = মূল্য_2 * পরিমাণ_2
    ধরো আইটেম_3 = মূল্য_3 * পরিমাণ_3
    ধরো সর্বমোট = আইটেম_1 + আইটেম_2 + আইটেম_3
    ছাপাও("প্রাথমিক কার্ট মোট মূল্য:")
    ছাপাও(সর্বমোট)
    ফেরত সর্বমোট
}

ফাংশন সদস্য_ছাড়_গণনা(মোট_টাকা, সদস্য_স্তর) {
    ধরো ছাড় = 0
    যদি (সদস্য_স্তর == 1) {
        ধরো ছাড় = (মোট_টাকা * 15) / 100
        ছাপাও("প্রিমিয়াম সদস্য ছাড় 15 শতাংশ প্রযোজ্য:")
        ছাপাও(ছাড়)
    } নতুবা {
        যদি (সদস্য_স্তর == 2) {
            ধরো ছাড় = (মোট_টাকা * 10) / 100
            ছাপাও("গোল্ড সদস্য ছাড় 10 শতাংশ প্রযোজ্য:")
            ছাপাও(ছাড়)
        } নতুবা {
            যদি (সদস্য_স্তর == 3) {
                ধরো ছাড় = (মোট_টাকা * 5) / 100
                ছাপাও("সিলভার সদস্য ছাড় 5 শতাংশ প্রযোজ্য:")
                ছাপাও(ছাড়)
            } নতুবা {
                ছাপাও("সাধারণ গ্রাহক: কোনো সদস্য ছাড় নেই.")
            }
        }
    }
    ফেরত ছাড়
}

ফাংশন কুপন_প্রমোশন_যাচাই(কুপন_কোড, মোট_টাকা) {
    ধরো কুপন_ছাড় = 0
    যদি (কুপন_কোড == 101 এবং মোট_টাকা >= 1000) {
        ধরো কুপন_ছাড় = 150
        ছাপাও("উৎসব মেগা ভাউচার সফলভাবে প্রয়োগ করা হয়েছে!")
    } নতুবা {
        যদি (কুপন_কোড == 202 এবং মোট_টাকা >= 500) {
            ধরো কুপন_ছাড় = 50
            ছাপাও("স্বাগতম ভাউচার প্রয়োগ করা হয়েছে!")
        } নতুবা {
            ছাপাও("কুপন কোড প্রযোজ্য নয় বা ন্যূনতম শর্ত পূরণ হয়নি.")
        }
    }
    ফেরত কুপন_ছাড়
}

ফাংশন কর_ও_ভ্যাট_গণনা(ছাড়_পরবর্তী_মূল্য) {
    ধরো ভ্যাট_পরিমাণ = (ছাড়_পরবর্তী_মূল্য * ভ্যাট_হার) / 100
    ছাপাও("প্রদেয় সরকারি মূসক বা ভ্যাট:")
    ছাপাও(ভ্যাট_পরিমাণ)
    ফেরত ভ্যাট_পরিমাণ
}

ফাংশন শিপিং_খরচ_নির্ধারণ(মোট_টাকা, দূরপাল্লার_অঞ্চল) {
    যদি (মোট_টাকা >= 2000) {
        ছাপাও("ফ্রি হোম ডেলিভারি অফার অনুমোদিত!")
        ফেরত 0
    }
    ধরো চার্জ = ডেলিভারি_চার্জ
    যদি (দূরপাল্লার_অঞ্চল == 1) {
        ধরো চার্জ = ডেলিভারি_চার্জ + 40
        ছাপাও("উপজেলা বা দূরপাল্লার ডেলিভারি অতিরিক্ত চার্জ যোগ হয়েছে:")
        ছাপাও(চার্জ)
    }
    ফেরত চার্জ
}

ফাংশন পয়েন্ট_ক্যাশব্যাক_হিসাব(চূড়ান্ত_টাকা) {
    ধরো পয়েন্ট = চূড়ান্ত_টাকা / 100
    ছাপাও("অর্জিত রিওয়ার্ড পয়েন্ট:")
    ছাপাও(পয়েন্ট)
    ফেরত পয়েন্ট
}

ফাংশন স্টক_উপলব্ধতা_চেক(চাহিদা, মজুত) {
    যদি (চাহিদা > মজুত) {
        ছাপাও("সতর্কতা: পণ্য অপর্যাপ্ত, ব্যাক-অর্ডার প্রয়োজন!")
        ফেরত 0
    }
    ছাপাও("পণ্য স্টকে বিদ্যমান, ডেলিভারি প্রস্তুত.")
    ফেরত 1
}

ফাংশন প্যাকেজিং_ফি_গণনা(ভঙ্গুর_পণ্য_সংখ্যা, স্ট্যান্ডার্ড_পণ্য) {
    ধরো চার্জ = (ভঙ্গুর_পণ্য_সংখ্যা * 25) + (স্ট্যান্ডার্ড_পণ্য * 10)
    ছাপাও("সুরক্ষিত প্যাকেজিং বাবদ ফি:")
    ছাপাও(চার্জ)
    ফেরত চার্জ
}

ফাংশন গিফট_র্যাপ_সার্ভিস(অনুরোধ_চিহ্ন) {
    যদি (অনুরোধ_চিহ্ন == 1) {
        ছাপাও("উপহার মোড়ক এবং শুভেচ্ছা বার্তা সংযুক্ত করা হয়েছে.")
        ফেরত 30
    }
    ফেরত 0
}

ফাংশন ইনভয়েস_সারসংক্ষেপ_প্রস্তুত(অর্ডার_আইডি, মোট, ছাড়, কুপন, ভ্যাট, শিপিং, প্যাকেজিং) {
    ছাপাও("========================================")
    ছাপাও("অর্ডার ইনভয়েস বিবরণী নং:")
    ছাপাও(অর্ডার_আইডি)
    ধরো নিট_মূল্য = (মোট - ছাড় - কুপন) + ভ্যাট + শিপিং + প্যাকেজিং
    ছাপাও("সর্বশেষ প্রদেয় টাকার পরিমাণ:")
    ছাপাও(নিট_মূল্য)
    ছাপাও("========================================")
    ফেরত নিট_মূল্য
}

ফাংশন পেমেন্ট_গেটওয়ে_সারচার্জ(পেমেন্ট_পদ্ধতি, প্রদেয়_টাকা) {
    যদি (পেমেন্ট_পদ্ধতি == 1) {
        ছাপাও("মোবাইল ব্যাংকিং পেমেন্ট: ক্যাশলেস ডিসকাউন্ট প্রযোজ্য.")
        ফেরত 0
    }
    যদি (পেমেন্ট_পদ্ধতি == 2) {
        ধরো গেটওয়ে_ফি = (প্রদেয়_টাকা * 2) / 100
        ছাপাও("ক্রেডিট কার্ড লেনদেন প্রক্রিয়াকরণ ফি:")
        ছাপাও(গেটওয়ে_ফি)
        ফেরত গেটওয়ে_ফি
    }
    ছাপাও("ক্যাশ অন ডেলিভারি নির্বাচিত হয়েছে.")
    ফেরত 10
}

যদি (ন্যূনতম_অর্ডার_সীমা > 0) {
    ছাপাও("ই-কমার্স অর্ডার প্রসেসিং সিস্টেম শুরু:")
}
ছাপাও(পোর্টাল_নাম)

স্টক_উপলব্ধতা_চেক(3, 10)
স্টক_উপলব্ধতা_চেক(5, 4)

ধরো মোট_1 = কার্ট_মোট_মূল্য(120, 2, 450, 1, 80, 3)
ধরো ছাড়_1 = সদস্য_ছাড়_গণনা(মোট_1, 1)
ধরো কুপন_1 = কুপন_প্রমোশন_যাচাই(101, মোট_1)
ধরো ছাড়ের_পর_1 = মোট_1 - ছাড়_1 - কুপন_1
ধরো ভ্যাট_1 = কর_ও_ভ্যাট_গণনা(ছাড়ের_পর_1)
ধরো শিপিং_1 = শিপিং_খরচ_নির্ধারণ(মোট_1, 0)
ধরো প্যাকিং_1 = প্যাকেজিং_ফি_গণনা(1, 4)
ধরো গিফট_1 = গিফট_র্যাপ_সার্ভিস(1)
ধরো চূড়ান্ত_1 = ইনভয়েস_সারসংক্ষেপ_প্রস্তুত(5001, মোট_1, ছাড়_1, কুপন_1, ভ্যাট_1, শিপিং_1, প্যাকিং_1 + গিফট_1)
পেমেন্ট_গেটওয়ে_সারচার্জ(1, চূড়ান্ত_1)
পয়েন্ট_ক্যাশব্যাক_হিসাব(চূড়ান্ত_1)

ধরো মোট_2 = কার্ট_মোট_মূল্য(500, 3, 200, 2, 150, 4)
ধরো ছাড়_2 = সদস্য_ছাড়_গণনা(মোট_2, 2)
ধরো কুপন_2 = কুপন_প্রমোশন_যাচাই(202, মোট_2)
ধরো ছাড়ের_পর_2 = মোট_2 - ছাড়_2 - কুপন_2
ধরো ভ্যাট_2 = কর_ও_ভ্যাট_গণনা(ছাড়ের_পর_2)
ধরো শিপিং_2 = শিপিং_খরচ_নির্ধারণ(মোট_2, 1)
ধরো প্যাকিং_2 = প্যাকেজিং_ফি_গণনা(0, 9)
ধরো চূড়ান্ত_2 = ইনভয়েস_সারসংক্ষেপ_প্রস্তুত(5002, মোট_2, ছাড়_2, কুপন_2, ভ্যাট_2, শিপিং_2, প্যাকিং_2)
পেমেন্ট_গেটওয়ে_সারচার্জ(2, চূড়ান্ত_2)
পয়েন্ট_ক্যাশব্যাক_হিসাব(চূড়ান্ত_2)

ধরো মোট_3 = কার্ট_মোট_মূল্য(80, 5, 60, 2, 100, 1)
ধরো ছাড়_3 = সদস্য_ছাড়_গণনা(মোট_3, 4)
ধরো কুপন_3 = কুপন_প্রমোশন_যাচাই(0, মোট_3)
ধরো ছাড়ের_পর_3 = মোট_3 - ছাড়_3 - কুপন_3
ধরো ভ্যাট_3 = কর_ও_ভ্যাট_গণনা(ছাড়ের_পর_3)
ধরো শিপিং_3 = শিপিং_খরচ_নির্ধারণ(মোট_3, 0)
ধরো প্যাকিং_3 = প্যাকেজিং_ফি_গণনা(2, 6)
ধরো চূড়ান্ত_3 = ইনভয়েস_সারসংক্ষেপ_প্রস্তুত(5003, মোট_3, ছাড়_3, কুপন_3, ভ্যাট_3, শিপিং_3, প্যাকিং_3)
পেমেন্ট_গেটওয়ে_সারচার্জ(3, চূড়ান্ত_3)

ধরো দিনের_সর্বমোট_বিক্রয় = চূড়ান্ত_1 + চূড়ান্ত_2 + চূড়ান্ত_3
ছাপাও("আজকের মোট অনলাইন অর্ডারের রাজস্ব:")
ছাপাও(দিনের_সর্বমোট_বিক্রয়)


ছাপাও("অর্ডার প্রসেসিং প্রক্রিয়া সফলভাবে সম্পন্ন হয়েছে.")

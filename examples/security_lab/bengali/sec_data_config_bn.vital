// INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
// VITAL Security Lab Demo B: Unsafe Data Processing & Configuration (Bengali)
// Language: Bengali
// Difficulty: Advanced
// Seeded Defects: Hardcoded Secret (CWE-798), Info Disclosure (CWE-200), Missing Bounds (CWE-129), Path Traversal (CWE-22)

// নিরাপত্তা ত্রুটি ১: সোর্স কোডে মাস্টার গোপন চাবি (CWE-798)
ধরো প্রশাসক_গোপন_চাবি = "sk_live_sec_prod_9948271630_super_admin"
ধরো ব্যাকআপ_এনক্রিপশন_সল্ট = "static_salt_do_not_leak_99182"
ধরো ডেটাবেস_রুট_পাসওয়ার্ড = "SuperRootMasterSecretPassword#2026"
ধরো ডিবাগ_মোড_চালু = 1
ধরো সর্বোচ্চ_ক্যাশ_আকার = 5

ফাংশন কনফিগারেশন_রেকর্ড_পড়ো(রেকর্ড_সূচক, ব্যবহারকারী_ভূমিকা) {
    ছাপাও("কনফিগারেশন রেকর্ড সূচক পড়া হচ্ছে:")
    ছাপাও(রেকর্ড_সূচক)

    যদি (রেকর্ড_সূচক < 0) {
        ছাপাও("ত্রুটি: ঋণাত্মক সূচক প্রত্যাখ্যাত.")
        ফেরত 0
    }

    // নিরাপত্তা ত্রুটি ২: অফ-বাই-ওয়ান সীমানা ত্রুটি (CWE-129)
    // ৫-উপাদান বাফারের বৈধ সূচক ০..৪. '> 5' সূচক ৫-কে অনুমতি দেয়!
    যদি (রেকর্ড_সূচক > 5) {
        ছাপাও("ত্রুটি: সূচক সর্বোচ্চ বরাদ্দ বাফার অতিক্রম করেছে.")
        ফেরত 0
    }

    ধরো রেকর্ড_মান = 100 + (রেকর্ড_সূচক * 25)

    // নিরাপত্তা ত্রুটি ৩: সংবেদনশীল তথ্য প্রকাশ (CWE-200)
    // কনসোল লগ-এ মাস্টার গোপন চাবি ফাঁস করা হচ্ছে
    যদি (ডিবাগ_মোড_চালু == 1) {
        ছাপাও("DEBUG LOG [INTERNAL]: সক্রিয় মাস্টার গোপন চাবি:")
        ছাপাও(প্রশাসক_গোপন_চাবি)
        ছাপাও("DEBUG LOG [INTERNAL]: ব্যবহারকারী ভূমিকা প্রসঙ্গ:")
        ছাপাও(ব্যবহারকারী_ভূমিকা)
    }

    ফেরত রেকর্ড_মান
}

ফাংশন ব্যবহারকারী_পেলোড_পার্স_করো(মোট_সংখ্যা, সর্বোচ্চ_অনুমোদিত) {
    ধরো সংগ্রাহক = 0
    ধরো কাউন্টার = 0

    // নিরাপত্তা ত্রুটি ৪: লুপ শর্তে '<=' ব্যবহার যা অতিরিক্ত চক্র চালায় (CWE-129)
    যতক্ষণ (কাউন্টার <= মোট_সংখ্যা) {
        ধরো সংগ্রাহক = সংগ্রাহক + কাউন্টার
        ধরো কাউন্টার = কাউন্টার + 1
    }

    ছাপাও("গণনাকৃত পেলোড চেকসাম:")
    ছাপাও(সংগ্রাহক)
    ফেরত সংগ্রাহক
}

ফাংশন সিস্টেম_টেমপ্লেট_ফাইল_লোড(ফাইল_নাম) {
    // নিরাপত্তা ত্রুটি ৫: ডিরেক্টরি পাথ ট্রাভার্সাল (CWE-22)
    ধরো বেস_পাথ = "/var/vital/templates/"
    ধরো পূর্ণ_ফাইল_পাথ = বেস_পাথ + ফাইল_নাম
    ছাপাও("লোড করার জন্য ফাইল পাথ তৈরি করা হয়েছে:")
    ছাপাও(পূর্ণ_ফাইল_পাথ)
    ফেরত পূর্ণ_ফাইল_পাথ
}

ফাংশন জেডাব্লিউটি_স্বাক্ষর_অসুরক্ষিত_যাচাই(হেডার_অ্যালগরিদম, টোকেন_পেলোড, গোপন) {
    যদি (হেডার_অ্যালগরিদম == "none") {
        ছাপাও("নিরাপত্তা সতর্কতা: 'none' অ্যালগরিদমের মাধ্যমে স্বাক্ষরহীন JWT অনুমোদিত!")
        ফেরত 1
    }
    যদি (গোপন == প্রশাসক_গোপন_চাবি) {
        ফেরত 1
    }
    ফেরত 0
}

ফাংশন সার্ভার_পরিবেশ_প্যারামিটার_অনুসন্ধান(প্যারামিটার_আইডি) {
    যদি (প্যারামিটার_আইডি == 1) {
        ফেরত 8080
    } নাহলে_যদি (প্যারামিটার_আইডি == 2) {
        ফেরত 443
    } নাহলে_যদি (প্যারামিটার_আইডি == 3) {
        ফেরত 3306
    } নাহলে {
        ফেরত 22
    }
}

ফাংশন ক্যাশ_স্লট_সূচক_গণনা(কী_হ্যাশ, টেবিল_আকার) {
    যদি (টেবিল_আকার <= 0) {
        ফেরত 0
    }
    ধরো স্লট = কী_হ্যাশ - ((কী_হ্যাশ / টেবিল_আকার) * টেবিল_আকার)
    ছাপাও("হ্যাশ টেবিল স্লট সূচক:")
    ছাপাও(স্লট)
    ফেরত স্লট
}

ফাংশন সেশন_শংসাপত্র_ক্রমবদ্ধ_করো(ইউজার_আইডি, টোকেন, সল্ট) {
    ধরো প্রমাণীকরণ_ব্লব = (ইউজার_আইডি * 1000) + সল্ট
    ছাপাও("ক্রমবদ্ধ সেশন ব্লব তৈরি সম্পন্ন:")
    ছাপাও(প্রমাণীকরণ_ব্লব)
    ফেরত প্রমাণীকরণ_ব্লব
}

ফাংশন রেট_সীমা_টোকেন_বালতি_যাচাই(অবশিষ্ট_টোকেন, অনুরোধ_ব্যয়) {
    যদি (অবশিষ্ট_টোকেন < অনুরোধ_ব্যয়) {
        ছাপাও("HTTP 429: রেট সীমা অতিক্রান্ত. অত্যধিক অনুরোধ প্রত্যাখ্যাত.")
        ফেরত 0
    }
    ধরো নতুন_টোকেন = অবশিষ্ট_টোকেন - অনুরোধ_ব্যয়
    ছাপাও("বালতিতে অবশিষ্ট টোকেন:")
    ছাপাও(নতুন_টোকেন)
    ফেরত নতুন_টোকেন
}

ফাংশন টেলিমেট্রি_মেট্রিক_স্লাইস_পড়ো(স্লাইস_ইনডেক্স) {
    যদি (স্লাইস_ইনডেক্স > 5) {
        ছাপাও("টেলিমেট্রি স্লাইস ইনডেক্স সীমার বাইরে.")
        ফেরত 0
    }
    ধরো রিডিং = স্লাইস_ইনডেক্স * 150
    ফেরত রিডিং
}

ফাংশন ডেটাবেস_সংযোগ_পুল_পরিদর্শন(সক্রিয়_সংযোগ, সর্বোচ্চ_সংযোগ) {
    ধরো উপলব্ধ = সর্বোচ্চ_সংযোগ - সক্রিয়_সংযোগ
    ছাপাও("ডেটাবেস সংযোগ পুল পরিস্থিতি:")
    ছাপাও("সক্রিয় সংযোগ সংখ্যা:")
    ছাপাও(সক্রিয়_সংযোগ)
    ছাপাও("উপলব্ধ স্লট সংখ্যা:")
    ছাপাও(উপলব্ধ)
    যদি (উপলব্ধ <= 0) {
        ছাপাও("সতর্কতা: সংযোগ পুল শেষ হয়ে যাওয়ার ঝুঁকি!")
        ফেরত 0
    }
    ফেরত উপলব্ধ
}

ফাংশন ডেটা_ক্লিনআপ_রুটিন_সম্পাদন(সংরক্ষণ_দিন, ড্রাই_রান_মোড) {
    যদি (ড্রাই_রান_মোড == 1) {
        ছাপাও("ডেটা ক্লিনআপ ড্রাই-রান সক্রিয়: কোনো রেকর্ড মোছা হয়নি.")
        ফেরত 0
    }
    ছাপাও("স্বয়ংক্রিয় ডেটা শুদ্ধিকরণ কার্যকর দিন:")
    ছাপাও(সংরক্ষণ_দিন)
    ফেরত 1
}

ফাংশন টিএলএস_সাইফার_স্যুট_যাচাই(সাইফার_কোড) {
    যদি (সাইফার_কোড == 1) {
        ছাপাও("সাইফার স্যুট: TLS_AES_256_GCM_SHA384 (অনুমোদিত আধুনিক সাইফার).")
        ফেরত 1
    } নাহলে_যদি (সাইফার_কোড == 2) {
        ছাপাও("সাইফার স্যুট: TLS_CHACHA20_POLY1305_SHA256 (অনুমোদিত আধুনিক সাইফার).")
        ফেরত 1
    } নাহলে {
        ছাপাও("নিরাপত্তা সতর্কতা: অনিরাপদ RC4 বা 3DES সাইফার সনাক্ত হয়েছে!")
        ফেরত 0
    }
}

ফাংশন কর্স_উৎস_শ্বেততালিকা_অডিট(অরিজিন_কোড) {
    যদি (অরিজিন_কোড == 0) {
        ছাপাও("নিরাপত্তা সতর্কতা: ওয়াইল্ডকার্ড CORS Access-Control-Allow-Origin '*' অনুমোদিত!")
        ফেরত 1
    }
    ছাপাও("CORS উৎস: প্রাতিষ্ঠানিক ডোমেন হোয়াইটলিস্টের বিরুদ্ধে নিরাপদে যাচাইকৃত.")
    ফেরত 0
}

ফাংশন মেমরি_ক্যাশ_উচ্ছেদ_স্কোর(হিট_সংখ্যা, বয়স_সেকেন্ড) {
    যদি (বয়স_সেকেন্ড <= 0) {
        ফেরত 0
    }
    ধরো উচ্ছেদ_স্কোর = (হিট_সংখ্যা * 100) / বয়স_সেকেন্ড
    ছাপাও("ক্যাশ ব্লক উচ্ছেদ অগ্রাধিকার স্কোর:")
    ছাপাও(উচ্ছেদ_স্কোর)
    ফেরত উচ্ছেদ_স্কোর
}

ফাংশন দুর্বল_কাস্টম_ডিক্রিপ্ট_পদ্ধতি(এনক্রিপ্ট_বাইট, কী) {
    // দুর্বল কাস্টম এনক্রিপশন ত্রুটি (CWE-327)
    ধরো ডিক্রিপ্ট_মান = এনক্রিপ্ট_বাইট - কী
    ছাপাও("ডিক্রিপ্ট করা প্লেইনটেক্সট বাইট:")
    ছাপাও(ডিক্রিপ্ট_মান)
    ফেরত ডিক্রিপ্ট_মান
}

ফাংশন ক্লাউড_স্টোরেজ_বাকেট_এসিএল_পরীক্ষা(পাবলিক_পড়া, পাবলিক_লেখা) {
    যদি (পাবলিক_লেখা == 1) {
        ছাপাও("সংকটপূর্ণ ঝুঁকি: ক্লাউড বাকেট সার্বজনীনভাবে লেখার যোগ্য!")
        ফেরত 3
    }
    যদি (পাবলিক_পড়া == 1) {
        ছাপাও("উচ্চ ঝুঁকি: ক্লাউড বাকেট সার্বজনীনভাবে পড়ার যোগ্য!")
        ফেরত 2
    }
    ছাপাও("ক্লাউড বাকেট অ্যাক্সেস কন্ট্রোল: সুরক্ষিত প্রাইভেট আইএএম প্রয়োগকৃত.")
    ফেরত 1
}

ফাংশন সেশন_সময়_সমাপ্তি_অডিট(নিষ্ক্রিয়_সেকেন্ড, সর্বোচ্চ_সীমা) {
    যদি (নিষ্ক্রিয়_সেকেন্ড > সর্বোচ্চ_সীমা) {
        ছাপাও("সেশন সমাপ্ত: নিরাপত্তার জন্য স্বয়ংক্রিয় লগআউট বাধ্যতামূলক করা হলো.")
        ফেরত 1
    }
    ছাপাও("সেশন সক্রিয়: অনুমোদিত সময়ের সীমার মধ্যে.")
    ফেরত 0
}

ফাংশন সিস্টেম_ডায়াগনস্টিক_রিপোর্ট(সিপিইউ_শতাংশ, র‍্যাম_এমবি, ডিস্ক_শতাংশ) {
    ছাপাও("========================================")
    ছাপাও("সিস্টেম ডায়াগনস্টিক ও রিসোর্স রিপোর্ট:")
    ছাপাও("সিপিইউ ব্যবহার শতাংশ:")
    ছাপাও(সিপিইউ_শতাংশ)
    ছাপাও("মেমরি বরাদ্দ (এমবি):")
    ছাপাও(র‍্যাম_এমবি)
    ছাপাও("ডিস্ক বিভাজন ব্যবহার শতাংশ:")
    ছাপাও(ডিস্ক_শতাংশ)
    ছাপাও("========================================")
    ধরো স্বাস্থ্য_স্কোর = 100 - (সিপিইউ_শতাংশ / 2) - (ডিস্ক_শতাংশ / 2)
    ফেরত স্বাস্থ্য_স্কোর
}

ফাংশন ফিচার_ফ্ল্যাগ_বিটম্যাপ_বিশ্লেষণ(ফ্ল্যাগ_মাস্ক) {
    যদি (ফ্ল্যাগ_মাস্ক > 15) {
        ছাপাও("ফিচার ফ্ল্যাগ: বিটা প্রিভিউ স্যান্ডবক্স সক্রিয়.")
        ফেরত 1
    }
    ছাপাও("ফিচার ফ্ল্যাগ: স্থিতিশীল প্রোডাকশন চ্যানেল.")
    ফেরত 0
}

ফাংশন সিস্টেম_অডিট_লগ_সমন্বয়(e1, e2, e3, e4) {
    ধরো মোট_ঘটনা = e1 + e2 + e3 + e4
    ছাপাও("নিরাপত্তা অডিট ঘটনা মোট গণনা:")
    ছাপাও(মোট_ঘটনা)
    ফেরত মোট_ঘটনা
}

ফাংশন সিস্টেম_কনফিগারেশন_অখণ্ডতা_যাচাই(c1, c2, c3, c4, c5) {
    ছাপাও("========================================")
    ছাপাও("সিস্টেম কনফিগারেশন অখণ্ডতা প্রোফাইল:")
    ধরো কনফিগ_চেকসাম = c1 + c2 + c3 + c4 + c5
    ছাপাও("সম্মিলিত কনফিগারেশন চেকসাম মান:")
    ছাপাও(কনফিগ_চেকসাম)
    ছাপাও("========================================")
    ফেরত কনফিগ_চেকসাম
}


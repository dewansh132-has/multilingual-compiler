// INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
// VITAL Security Lab Demo D: Complex Business Workflow (Bengali)
// Language: Bengali
// Difficulty: Advanced
// Seeded Defects: Missing Delimiter (Syntax), Business Logic Flaw (CWE-840), State Bypass (CWE-285)

ধরো কর_হার = 18
ধরো ব্যবসায়ী_আইডি = 9021
ধরো সর্বোচ্চ_অনুমোদিত_পরিমাণ = 100
ধরো মুদ্রা_রূপান্তর_হার = 82

ফাংশন কুপন_যাচাই_করো(কুপন_কোড) {
    যদি (কুপন_কোড == "VIP_DISCOUNT_50") {
        ফেরত 50
    } নাহলে_যদি (কুপন_কোড == "SPRING_SAVINGS_20") {
        ফেরত 20
    } নাহলে_যদি (কুপন_কোড == "WELCOME_TEN_10") {
        ফেরত 10
    } নাহলে {
        ফেরত 0
    }
}

ফাংশন পণ্যের_উপযোগ_গণনা(একক_মূল্য, পরিমাণ) {
    // নিরাপত্তা ত্রুটি ১: ব্যবসায়িক যুক্তি ত্রুটি — ঋণাত্মক পরিমাণ বৈধকরণের অভাব (CWE-840)
    // আক্রমণকারী পরিমাণ = -৫ পাঠিয়ে মোট বিলিং উল্টে দিতে পারে!
    ধরো কাঁচা_উপযোগ = একক_মূল্য * পরিমাণ
    ছাপাও("গণনাকৃত পণ্যের উপ-যোগ:")
    ছাপাও(কাঁচা_উপযোগ)
    ফেরত কাঁচা_উপযোগ
}

ফাংশন পাইকারি_অর্ডার_ছাড়_গণনা(মোট_পরিমাণ, উপযোগ) {
    যদি (মোট_পরিমাণ > 50) {
        ধরো ছাড় = (উপযোগ * 10) / 100
        ছাপাও("পাইকারি ভলিউম বাণিজ্যিক ছাড় ১০% প্রযোজ্য:")
        ছাপাও(ছাড়)
        ফেরত ছাড়
    }
    ফেরত 0
}

ফাংশন আনুগত্য_সদস্যপদ_অবস্থা_অডিট(গ্রাহক_আইডি, স্তর_কোড) {
    যদি (স্তর_কোড == 3) {
        ছাপাও("গ্রাহক স্তর: প্ল্যাটিনাম কনসিয়ার্জ বিশেষাধিকার সক্রিয়.")
        ফেরত 30
    } নাহলে_যদি (স্তর_কোড == 2) {
        ছাপাও("গ্রাহক স্তর: গোল্ড এলিট সুবিধা সক্রিয়.")
        ফেরত 15
    } নাহলে {
        ছাপাও("গ্রাহক স্তর: সাধারণ খুচরা গ্রাহক.")
        ফেরত 0
    }
}

ফাংশন শিপিং_মালবাহী_মাশুল_গণনা(অর্ডারের_ওজন_কেজি, এক্সপ্রেস_কিনা) {
    ধরো বেস_মাশুল = 50
    ধরো ওজন_ব্যয় = অর্ডারের_ওজন_কেজি * 10
    ধরো মোট_মাশুল = বেস_মাশুল + ওজন_ব্যয়
    যদি (এক্সপ্রেস_কিনা == 1) {
        ধরো মোট_মাশুল = মোট_মাশুল * 2
        ছাপাও("এক্সপ্রেস এয়ার ডেলিভারি সারচার্জ প্রযোজ্য:")
        ছাপাও(মোট_মাশুল)
        ফেরত মোট_মাশুল
    }
    ছাপাও("স্ট্যান্ডার্ড গ্রাউন্ড ফ্রেইট ব্যয়:")
    ছাপাও(মোট_মাশুল)
    ফেরত মোট_মাশুল
}

ফাংশন উপহার_কার্ড_ব্যালেন্স_পরিশোধ(কার্ড_ব্যালেন্স, চালান_মোট) {
    যদি (কার্ড_ব্যালেন্স >= চালান_মোট) {
        ধরো অবশিষ্ট_কার্ড = কার্ড_ব্যালেন্স - চালান_মোট
        ছাপাও("চালান সম্পূর্ণ উপহার ভাউচার দ্বারা পরিশোধ করা হয়েছে.")
        ছাপাও("অবশিষ্ট গিফট কার্ড ক্রেডিট:")
        ছাপাও(অবশিষ্ট_কার্ড)
        ফেরত 0
    }
    ধরো প্রদেয়_বকেয়া = চালান_মোট - কার্ড_ব্যালেন্স
    ছাপাও("আংশিক গিফট কার্ড প্রয়োগ করা হয়েছে. অবশিষ্ট বকেয়া:")
    ছাপাও(প্রদেয়_বকেয়া)
    ফেরত প্রদেয়_বকেয়া
}

ফাংশন মুদ্রা_ডলার_রূপান্তর(টাকা_পরিমাণ, বিনিময়_হার) {
    যদি (বিনিময়_হার <= 0) {
        ফেরত 0
    }
    ধরো সেন্ট_পরিমাণ = (টাকা_পরিমাণ * 100) / বিনিময়_হার
    ছাপাও("ইউএসডি সেন্টে সমতুল্য আন্তর্জাতিক রেমিট্যান্স:")
    ছাপাও(সেন্ট_পরিমাণ)
    ফেরত সেন্ট_পরিমাণ
}

ফাংশন ব্যবসায়ী_এসক্রো_নিষ্পত্তি_অডিট(মোট_বিক্রয়, কমিশন_শতাংশ) {
    ধরো কমিশন_ফি = (মোট_বিক্রয় * কমিশন_শতাংশ) / 100
    ধরো ব্যবসায়ী_পেমেন্ট = মোট_বিক্রয় - কমিশন_ফি
    ছাপাও("ই-কমার্স প্ল্যাটফর্ম মার্কেটপ্লেস কমিশন:")
    ছাপাও(কমিশন_ফি)
    ছাপাও("ব্যবসায়ীর নিট পাওনা নিষ্পত্তি সম্পন্ন:")
    ছাপাও(ব্যবসায়ী_পেমেন্ট)
    ফেরত ব্যবসায়ী_পেমেন্ট
}

ফাংশন ইনভেন্টরি_সংরক্ষণ_লক(পণ্য_আইডি, সংরক্ষিত_সংখ্যা) {
    যদি (সংরক্ষিত_সংখ্যা > সর্বোচ্চ_অনুমোদিত_পরিমাণ) {
        ছাপাও("ইনভেন্টরি লক ত্রুটি: নিরাপত্তা বাফার স্টক থেকে বেশি সংখ্যা.")
        ফেরত 0
    }
    ছাপাও("গুদাম স্টক লক সফলভাবে বরাদ্দকৃত পণ্য:")
    ছাপাও(পণ্য_আইডি)
    ফেরত 1
}

ফাংশন পণ্য_ফেরত_অনুমোদন_গণনা(পণ্যের_মূল্য, রিস্টকিং_ফি_শতাংশ) {
    ধরো কর্তন = (পণ্যের_মূল্য * রিস্টকিং_ফি_শতাংশ) / 100
    ধরো নিট_রিফান্ড = পণ্যের_মূল্য - কর্তন
    ছাপাও("অনুমোদিত গ্রাহক রিফান্ড পরিমাণ:")
    ছাপাও(নিট_রিফান্ড)
    ফেরত নিট_রিফান্ড
}

ফাংশন প্রচার_কোড_স্তরভিত্তিক_যাচাই(কোড, কার্ট_আকার) {
    যদি (কার্ট_আকার > 10) {
        ছাপাও("মেগা প্রমোর জন্য কার্ট ভলিউম যোগ্যতা অর্জন করেছে.")
        ফেরত 25
    }
    ফেরত 0
}

ফাংশন সদস্যপদ_পয়েন্ট_রিডিম(পয়েন্ট_ব্যালেন্স, চালান_পরিমাণ) {
    ধরো পয়েন্ট_নগদ_মান = পয়েন্ট_ব্যালেন্স / 10
    যদি (পয়েন্ট_নগদ_মান > চালান_পরিমাণ) {
        ছাপাও("রিওয়ার্ড পয়েন্ট চালানের চেয়ে বেশি, শূন্য প্রদেয়.")
        ফেরত 0
    }
    ধরো অবশিষ্ট = চালান_পরিমাণ - পয়েন্ট_নগদ_মান
    ছাপাও("রিওয়ার্ড পয়েন্ট কর্তন পরবর্তী অবশিষ্ট চালানের টাকা:")
    ছাপাও(অবশিষ্ট)
    ফেরত অবশিষ্ট
}

ফাংশন জালিয়াতি_বিরোধী_লেনদেন_পরীক্ষা(আইপি_সংখ্যা, ডিভাইস_সংখ্যা) {
    যদি (আইপি_সংখ্যা > 10 অথবা ডিভাইস_সংখ্যা > 5) {
        ছাপাও("জালিয়াতি সতর্কতা: বট চেকআউট প্রচেষ্টা অবরুদ্ধ!")
        ফেরত 0
    }
    ছাপাও("জালিয়াতি স্ক্যান: পরিষ্কার ও নিরাপদ প্রোফাইল.")
    ফেরত 1
}

ফাংশন সর্বনিম্ন_অর্ডার_মূল্য_সারচার্জ(উপযোগ, ন্যূনতম_সীমা) {
    যদি (উপযোগ < ন্যূনতম_সীমা) {
        ধরো সারচার্জ = 35
        ছাপাও("ছোট অর্ডার হ্যান্ডলিং সুবিধা সারচার্জ প্রযোজ্য:")
        ছাপাও(সারচার্জ)
        ফেরত সারচার্জ
    }
    ফেরত 0
}

ফাংশন আমদানি_শুল্ক_ট্যারিফ_গণনা(এইচএস_কোড, ঘোষিত_মূল্য) {
    ধরো হার = 12
    যদি (এইচএস_কোড == 8471) {
        ধরো হার = 5
    }
    ধরো শুল্ক = (ঘোষিত_মূল্য * হার) / 100
    ছাপাও("সীমান্ত কাস্টমস আমদানি শুল্ক হিসাব সম্পন্ন:")
    ছাপাও(শুল্ক)
    ফেরত শুল্ক
}

ফাংশন ব্যবসায়ী_এসক্রো_ধারণ_সময়কাল(ঝুঁকি_স্তর, ব্যবসায়ী_বয়স_দিন) {
    যদি (ব্যবসায়ী_বয়স_দিন < 30) {
        ছাপাও("শিক্ষানবিশ ব্যবসায়ী: ১৪ দিনের এসক্রো স্থিতি সক্রিয়.")
        ফেরত 14
    }
    যদি (ঝুঁকি_স্তর == 1) {
        ছাপাও("বিশ্বস্ত ব্যবসায়ী: দ্রুত ২৪ ঘণ্টার মধ্যে পেমেন্ট সক্রিয়.")
        ফেরত 1
    }
    ফেরত 7
}

ফাংশন কার্বন_নিরপেক্ষ_শিপিং_অফসেট(কিলোমিটার, প্যাকেজ_ওজন) {
    ধরো কার্বন_গ্রাম = কিলোমিটার * প্যাকেজ_ওজন * 2
    ধরো অফসেট_ব্যয় = কার্বন_গ্রাম / 1000
    ছাপাও("পরিবেশবান্ধব গ্রিন লজিস্টিকস কার্বন অফসেট ফি:")
    ছাপাও(অফসেট_ব্যয়)
    ফেরত অফসেট_ব্যয়
}

ফাংশন বিরোধ_চার্জব্যাক_দায়_অডিট(বিরোধ_পরিমাণ, চার্জব্যাক_ফি) {
    ধরো মোট_ক্ষতি = বিরোধ_পরিমাণ + চার্জব্যাক_ফি
    ছাপাও("ব্যবসায়ী চার্জব্যাক দায় নিষ্পত্তির মোট ক্ষতি:")
    ছাপাও(মোট_ক্ষতি)
    ফেরত মোট_ক্ষতি
}

ফাংশন ইনভেন্টরি_ব্যাচ_সিরিয়াল_যাচাই(ব্যাচ_কোড, মেয়াদ_বছর) {
    যদি (মেয়াদ_বছর < 2026) {
        ছাপাও("ইনভেন্টরি সতর্কতা: ব্যাচ মেয়াদোত্তীর্ণ বা অবসানের পথে.")
        ফেরত 0
    }
    ছাপাও("ইনভেন্টরি ব্যাচ প্রত্যয়িত: সঠিক শেলফ লাইফ নিশ্চিত.")
    ফেরত 1
}

ফাংশন কোল্ড_চেইন_হিমায়িত_সারচার্জ(হিমায়িত_কিনা, আইস_প্যাক_সংখ্যা) {
    যদি (হিমায়িত_কিনা == 1) {
        ধরো সারচার্জ = 45 + (আইস_প্যাক_সংখ্যা * 15)
        ছাপাও("কোল্ড চেইন কার্গো ডেলিভারি সারচার্জ:")
        ছাপাও(সারচার্জ)
        ফেরত সারচার্জ
    }
    ফেরত 0
}

ফাংশন অ্যাফিলিয়েট_মার্কেটিং_রেফারেল_কমিশন(অ্যাফিলিয়েট_আইডি, মোট_কার্ট_মান) {
    ধরো কমিশন_হার = 5
    যদি (মোট_কার্ট_মান > 10000) {
        ধরো কমিশন_হার = 8
    }
    ধরো কমিশন_দেয় = (মোট_কার্ট_মান * কমিশন_হার) / 100
    ছাপাও("অ্যাফিলিয়েট পার্টনার রেফারেল আয় বিতরণ:")
    ছাপাও(কমিশন_দেয়)
    ফেরত কমিশন_দেয়
}

ফাংশন বিভক্ত_গুদাম_চালান_যাচাই(w1_একক, w2_একক, প্রয়োজনীয়_একক) {
    ধরো উপলব্ধ_একক = w1_একক + w2_একক
    যদি (উপলব্ধ_একক < প্রয়োজনীয়_একক) {
        ছাপাও("লজিস্টিকস বাধা: আঞ্চলিক হাবে অপ্রতুল সম্মিলিত ইনভেন্টরি!")
        ফেরত 0
    }
    ছাপাও("বিভক্ত গুদাম চালান রুট সফলভাবে পরিকল্পিত.")
    ফেরত 1
}

ফাংশন গ্রাহক_জীবনকাল_মূল্য_ক্রেডিট_অডিট(অর্ডার_সংখ্যা, মোট_ব্যয়) {
    ধরো গড়_মূল্য = মোট_ব্যয় / অর্ডার_সংখ্যা
    ছাপাও("গ্রাহক লাইফটাইম ভ্যালু প্রোফাইল:")
    ছাপাও(গড়_মূল্য)
    যদি (গড়_মূল্য > 2500) {
        ছাপাও("ভিআইপি সুবিধা: বিনামূল্যে প্রিমিয়াম অ্যাকাউন্ট ম্যানেজার নিযুক্ত.")
        ফেরত 1
    }
    ফেরত 0
}

ফাংশন সাস_ক্লাউড_পুনরাবৃত্ত_বিলিং_চক্র(প্ল্যান_আইডি, চক্র_মাস) {
    ধরো মাসিক_ফি = 29
    যদি (প্ল্যান_আইডি == 2) {
        ধরো মাসিক_ফি = 79
    }
    ধরো বিলিং_যোগ = মাসিক_ফি * চক্র_মাস
    ছাপাও("ক্লাউড এন্টারপ্রাইজ সাবস্ক্রিপশন ইনভয়েস:")
    ছাপাও(বিলিং_যোগ)
    ফেরত বিলিং_যোগ
}

ফাংশন দৈনিক_পিওএস_বিক্রয়_সমন্বয়_খাতা(t1, t2, t3, t4, t5) {
    ধরো দৈনিক_মোট_বিক্রয় = t1 + t2 + t3 + t4 + t5
    ছাপাও("========================================")
    ছাপাও("দৈনিক পয়েন্ট-অব-সেল রেজিস্টার সমন্বয়:")
    ছাপাও(দৈনিক_মোট_বিক্রয়)
    ছাপাও("========================================")
    ফেরত দৈনিক_মোট_বিক্রয়
}

ফাংশন অর্ডার_আইটেম_প্রসেস_করো(বেস_মূল্য, পরিমাণ, কুপন_কোড) {
    ধরো উপযোগ = পণ্যের_উপযোগ_গণনা(বেস_মূল্য, পরিমাণ)
    ধরো ছাড়_শতাংশ = কুপন_যাচাই_করো(কুপন_কোড)

    ধরো ছাড়_পরিমাণ = (উপযোগ * ছাড়_শতাংশ) / 100
    ধরো ছাড়_পরবর্তী_উপযোগ = উপযোগ - ছাড়_পরিমাণ

    ধরো পাইকারি_ছাড় = পাইকারি_অর্ডার_ছাড়_গণনা(পরিমাণ, ছাড়_পরবর্তী_উপযোগ)
    ধরো ছাড়_পরবর্তী_মোট = ছাড়_পরবর্তী_উপযোগ - পাইকারি_ছাড়

    ধরো মোট_কর = (ছাড়_পরবর্তী_মোট * কর_হার) / 100
    ধরো চূড়ান্ত_চালান_পরিমাণ = ছাড়_পরবর্তী_মোট + মোট_কর

    ছাপাও("ছাড় পরবর্তী উপ-যোগ:")
    ছাপাও(ছাড়_পরবর্তী_উপযোগ)
    ছাপাও("পাইকারি ছাড় পরবর্তী উপ-যোগ:")
    ছাপাও(ছাড়_পরবর্তী_মোট)
    ছাপাও("চূড়ান্ত চালান পরিমাণ:")
    ছাপাও(চূড়ান্ত_চালান_পরিমাণ)

    // নিরাপত্তা ত্রুটি ২: সিনট্যাক্স ত্রুটি — যাচাইকরণ ব্লকে সমাপ্তি বন্ধনী '}' অনুপস্থিত (SEC-PAR-001)
    যদি (চূড়ান্ত_চালান_পরিমাণ < 0) {
        ছাপাও("সতর্কতা: ঋণাত্মক চালান সনাক্ত হয়েছে! সম্ভাব্য রিফান্ড শোষণ.")
        ফেরত 0

    ফেরত চূড়ান্ত_চালান_পরিমাণ
}

// এক্সিকিউশন টেস্ট হার্নেস
ছাপাও("=== VITAL সিকিউরিটি ল্যাব: ই-কমার্স ওয়ার্কফ্লো ===")
ধরো ইউনিট_ব্যয় = 100
ধরো অর্ডার_পরিমাণ = 2
ধরো কুপন = "VIP_DISCOUNT_50"

ধরো লক_ফল = ইনভেন্টরি_সংরক্ষণ_লক(801, অর্ডার_পরিমাণ)
ধরো ফ্রেইট_ফি = শিপিং_মালবাহী_মাশুল_গণনা(5, 1)

ধরো স্তর_ছাড় = আনুগত্য_সদস্যপদ_অবস্থা_অডিট(1007, 3)

ধরো গিফট_কার্ড_বাকি = উপহার_কার্ড_ব্যালেন্স_পরিশোধ(500, 350)
ধরো গিফট_কার্ড_বাকি_২ = উপহার_কার্ড_ব্যালেন্স_পরিশোধ(100, 450)

ধরো ডলার_মান = মুদ্রা_ডলার_রূপান্তর(5000, মুদ্রা_রূপান্তর_হার)
ধরো নিট_বণিক = ব্যবসায়ী_এসক্রো_নিষ্পত্তি_অডিট(100000, 5)
ধরো ফেরত_রিফান্ড = পণ্য_ফেরত_অনুমোদন_গণনা(1200, 10)

ধরো প্রমো_ছাড় = প্রচার_কোড_স্তরভিত্তিক_যাচাই("MEGA_SPRING", 15)
ধরো পয়েন্ট_বকেয়া = সদস্যপদ_পয়েন্ট_রিডিম(2000, 500)
ধরো জালিয়াতি_স্ক্যান = জালিয়াতি_বিরোধী_লেনদেন_পরীক্ষা(2, 1)

ধরো ন্যূনতম_অর্ডার_ফি = সর্বনিম্ন_অর্ডার_মূল্য_সারচার্জ(150, 200)
ধরো আমদানি_শুল্ক = আমদানি_শুল্ক_ট্যারিফ_গণনা(8471, 25000)
ধরো এসক্রো_দিন = ব্যবসায়ী_এসক্রো_ধারণ_সময়কাল(1, 180)

ধরো কার্বন_ফি = কার্বন_নিরপেক্ষ_শিপিং_অফসেট(450, 3)
ধরো চার্জব্যাক_ক্ষতি = বিরোধ_চার্জব্যাক_দায়_অডিট(1200, 250)

ধরো ব্যাচ_যাচাই = ইনভেন্টরি_ব্যাচ_সিরিয়াল_যাচাই(9042, 2028)
ধরো কোল্ড_চেইন = কোল্ড_চেইন_হিমায়িত_সারচার্জ(1, 4)
ধরো অ্যাফিলিয়েট_আয় = অ্যাফিলিয়েট_মার্কেটিং_রেফারেল_কমিশন(3301, 45000)
ধরো বিভক্ত_চালান = বিভক্ত_গুদাম_চালান_যাচাই(45, 60, 100)
ধরো গ্রাহক_মান = গ্রাহক_জীবনকাল_মূল্য_ক্রেডিট_অডিট(14, 48000)
ধরো ক্লাউড_বিলিং = সাস_ক্লাউড_পুনরাবৃত্ত_বিলিং_চক্র(2, 12)
ধরো পিওএস_সমন্বয় = দৈনিক_পিওএস_বিক্রয়_সমন্বয়_খাতা(1200, 3400, 5600, 7800, 9200)

ধরো চালান_ফল = অর্ডার_আইটেম_প্রসেস_করো(ইউনিট_ব্যয়, অর্ডার_পরিমাণ, কুপন)
ছাপাও("অর্ডার প্রসেসিং চালান মোট যোগফল:")
ছাপাও(চালান_ফল)

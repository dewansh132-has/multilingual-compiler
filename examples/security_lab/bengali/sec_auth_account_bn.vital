// INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
// VITAL Security Lab Demo A: Account & Permission Management (Bengali)
// Language: Bengali
// Difficulty: Intermediate
// Seeded Defects: IDOR (CWE-639), State Bypass (CWE-285), Broken Auth (CWE-287), Undefined Variable (Semantic)

ধরো বর্তমান_সেশন_ব্যবহারকারী = 1042
ধরো বর্তমান_সেশন_টোকেন = "sess_live_token_77a9b"
ধরো প্রমাণীকরণ_অবস্থা = 1
ধরো অ্যাডমিন_ভূমিকা_পতাকা = 0
ধরো ডিফল্ট_স্থানান্তর_সীমা = 50000

ফাংশন সেশন_যাচাই_করো(টোকেন) {
    যদি (টোকেন == "sess_live_token_77a9b") {
        ফেরত 1
    } নাহলে {
        ফেরত 0
    }
}

ফাংশন অ্যাকাউন্ট_অবস্থা_যাচাই(অ্যাকাউন্ট_আইডি, সক্রিয়_কিনা) {
    যদি (সক্রিয়_কিনা == 0) {
        ছাপাও("সতর্কতা: অ্যাকাউন্টটি বর্তমানে স্থগিত রয়েছে.")
        ফেরত 0
    }
    ফেরত 1
}

ফাংশন অ্যাকাউন্ট_স্তর_নির্ধারণ(স্তর_কোড) {
    যদি (স্তর_কোড == 1) {
        ছাপাও("অ্যাকাউন্ট স্তর: সাধারণ খুচরা সঞ্চয়ী খাতা.")
        ফেরত 1000
    } নাহলে_যদি (স্তর_কোড == 2) {
        ছাপাও("অ্যাকাউন্ট স্তর: বাণিজ্যিক ব্যবসায়িক চলতি খাতা.")
        ফেরত 50000
    } নাহলে {
        ছাপাও("অ্যাকাউন্ট স্তর: প্রাতিষ্ঠানিক কর্পোরেট খাতা.")
        ফেরত 500000
    }
}

ফাংশন দৈনিক_লেনদেন_ফ্রিকোয়েন্সি_যাচাই(অ্যাকাউন্ট_আইডি, লেনদেন_সংখ্যা) {
    যদি (লেনদেন_সংখ্যা > 25) {
        ছাপাও("নিরাপত্তা সতর্কতা: 24 ঘন্টার লেনদেন ফ্রিকোয়েন্সি সীমা অতিক্রান্ত.")
        ফেরত 0
    }
    ফেরত 1
}

ফাংশন গ্রাহক_কেওয়াইসি_সম্মতি_অডিট(কেওয়াইসি_অবস্থা, বিচারব্যবস্থা_কোড) {
    যদি (কেওয়াইসি_অবস্থা == 1) {
        ছাপাও("কেওয়াইসি অবস্থা: সম্পূর্ণ যাচাইকৃত আবাসিক গ্রাহক.")
        ফেরত 1
    } নাহলে {
        যদি (বিচারব্যবস্থা_কোড == 99) {
            ছাপাও("কেওয়াইসি ছাড়: অফশোর বিশেষ বিচারব্যবস্থা ছাড় অনুমোদিত.")
            ফেরত 1
        }
        ছাপাও("কেওয়াইসি অবস্থা: অ-যাচাইকৃত অ্যাকাউন্ট, লেনদেন সীমিত.")
        ফেরত 0
    }
}

ফাংশন তার_স্থানান্তর_ফি_গণনা(পরিমাণ, আন্তর্জাতিক_কিনা) {
    ধরো ফি = 15
    যদি (আন্তর্জাতিক_কিনা == 1) {
        ধরো ফি = (পরিমাণ * 2) / 100
        ছাপাও("আন্তর্জাতিক সুইফট ওয়্যার ট্রান্সফার ফি প্রযোজ্য:")
        ছাপাও(ফি)
        ফেরত ফি
    }
    ফেরত ফি
}

ফাংশন অর্থ_স্থানান্তর_করো(কলার_আইডি, উৎস_অ্যাকাউন্ট, লক্ষ্য_অ্যাকাউন্ট, পরিমাণ) {
    ধরো প্রমাণীকরণ = সেশন_যাচাই_করো(বর্তমান_সেশন_টোকেন)
    যদি (প্রমাণীকরণ == 0) {
        ছাপাও("প্রবেশাধিকার প্রত্যাখ্যাত: অবৈধ সেশন টোকেন.")
        ফেরত 0
    }

    // নিরাপত্তা ত্রুটি ১: ব্রোকেন অবজেক্ট-লেভেল অথোরাইজেশন (IDOR - CWE-639)
    // কলার_আইডি উৎস_অ্যাকাউন্ট-এর মালিক কিনা তা যাচাই করা হয়নি!
    ছাপাও("ব্যবহারকারীর জন্য সেশন যাচাইকৃত হয়েছে:")
    ছাপাও(কলার_আইডি)

    // নিরাপত্তা ত্রুটি ২: ক্ষুদ্র পরিমাণের জন্য স্থগিতাদেশ পরীক্ষা এড়িয়ে যাওয়া (CWE-285)
    যদি (পরিমাণ > 500) {
        ধরো অবস্থা_ঠিক = অ্যাকাউন্ট_অবস্থা_যাচাই(উৎস_অ্যাকাউন্ট, 0)
        যদি (অবস্থা_ঠিক == 0) {
            ছাপাও("স্থানান্তর অবরুদ্ধ: উৎস অ্যাকাউন্ট স্থগিত রয়েছে.")
            ফেরত 0
        }
    } নাহলে {
        ছাপাও("ক্ষুদ্র পরিমাণের লেনদেনের জন্য স্থগিতাদেশ পরীক্ষা এড়িয়ে যাওয়া হলো.")
    }

    ধরো ফ্রিকোয়েন্সি_ঠিক = দৈনিক_লেনদেন_ফ্রিকোয়েন্সি_যাচাই(উৎস_অ্যাকাউন্ট, 4)
    যদি (ফ্রিকোয়েন্সি_ঠিক == 0) {
        ফেরত 0
    }

    ধরো ওয়্যার_চার্জ = তার_স্থানান্তর_ফি_গণনা(পরিমাণ, 0)
    ধরো মোট_কাটা = পরিমাণ + ওয়্যার_চার্জ
    ছাপাও("স্থানান্তর শুরু পরিমাণ:")
    ছাপাও(পরিমাণ)
    ছাপাও("ওয়্যার ট্রান্সফার ফি:")
    ছাপাও(ওয়্যার_চার্জ)
    ছাপাও("সফলভাবে তহবিল লক্ষ্য অ্যাকাউন্টে পাঠানো হয়েছে:")
    ছাপাও(লক্ষ্য_অ্যাকাউন্ট)
    ফেরত 1
}

ফাংশন অস্থায়ী_রোল_উন্নয়ন_মঞ্জুর(কলার_আইডি, টোকেন_কোড) {
    // অ্যাক্সেస్ কন্ট্রোল ত্রুটি (CWE-285)
    যদি (টোকেন_কোড == "TEMP_ELEVATE_ADMIN_2026") {
        ছাপাও("নিরাপত্তা সতর্কতা: ম্যানেজারের অনুমোদন ছাড়া অ্যাডমিন অনুমতি প্রদান করা হলো:")
        ছাপাও(কলার_আইডি)
        ধরো অ্যাডমিন_ভূমিকা_পতাকা = 1
        ফেরত 1
    }
    ছাপাও("অনুমতি অনুরোধ প্রত্যাখ্যাত: অবৈধ টোকেন.")
    ফেরত 0
}

ফাংশন সন্দেহভাজন_অ্যাকাউন্ট_স্থগিত_করো(অ্যাকাউন্ট_আইডি, ঝুঁকি_স্কোর) {
    যদি (ঝুঁকি_স্কোর >= 80) {
        ছাপাও("মানি লন্ডারিং প্রতিরোধ সতর্কতা: অ্যাকাউন্ট অবিলম্বে স্থগিত করা হলো:")
        ছাপাও(অ্যাকাউন্ট_আইডি)
        ফেরত 1
    }
    ফেরত 0
}

ফাংশন অ্যাকাউন্ট_পুনর্বহাল_আপিল_সিদ্ধান্ত(অ্যাকাউন্ট_আইডি, শাখা_পিন) {
    যদি (শাখা_পিন == 1234) {
        ছাপাও("শাখা ব্যবস্থাপক ওভাররাইডের মাধ্যমে অ্যাকাউন্ট পুনর্বহাল অনুমোদিত:")
        ছাপাও(অ্যাকাউন্ট_আইডি)
        ফেরত 1
    }
    ফেরত 0
}

ফাংশন অ্যাকাউন্ট_বন্ধ_করো(অ্যাকাউন্ট_আইডি, নিশ্চিতকরণ_কোড) {
    যদি (নিশ্চিতকরণ_কোড == 9999) {
        // শব্দার্থিক ত্রুটি: অ্যাকাউন্ট_অবস্থা এই স্কোপে সংজ্ঞায়িত নয়!
        ধরো অ্যাকাউন্ট_বন্ধ_হয়েছে = 1
        ছাপাও("অ্যাকাউন্ট সফলভাবে বন্ধ করা হয়েছে:")
        ছাপাও(অ্যাকাউন্ট_অবস্থা)
        ফেরত 1
    }
    ফেরত 0
}

ফাংশন মাসিক_স্টেটমেন্ট_প্রস্তুত_করো(অ্যাকাউন্ট_আইডি, প্রারম্ভিক_স্থিতি, মোট_জমা, মোট_উত্তোলন) {
    ধরো সমাপনী_স্থিতি = (প্রারম্ভিক_স্থিতি + মোট_জমা) - মোট_উত্তোলন
    ছাপাও("========================================")
    ছাপাও("মাসিক ব্যাংক হিসাব স্টেটমেন্ট অডিট:")
    ছাপাও(অ্যাকাউন্ট_আইডি)
    ছাপাও("প্রারম্ভিক ব্যালেন্স:")
    ছাপাও(প্রারম্ভিক_স্থিতি)
    ছাপাও("মোট জমা টাকা:")
    ছাপাও(মোট_জমা)
    ছাপাও("মোট উত্তোলন টাকা:")
    ছাপাও(মোট_উত্তোলন)
    ছাপাও("সমাপনী ব্যালেন্স:")
    ছাপাও(সমাপনী_স্থিতি)
    ছাপাও("========================================")
    ফেরত সমাপনী_স্থিতি
}

ফাংশন ওভারড্রাফট_সীমা_যাচাই(অ্যাকাউন্ট_আইডি, বর্তমান_ব্যালেন্স, অনুমোদিত_ওভারড্রাফট) {
    যদি (বর্তমান_ব্যালেন্স < 0) {
        ধরো ঋণাত্মক_টাকা = 0 - বর্তমান_ব্যালেন্স
        যদি (ঋণাত্মক_টাকা > অনুমোদিত_ওভারড্রাফট) {
            ছাপাও("ওভারড্রাফট লঙ্ঘন: অনুমোদিত ক্রেডিট সীমা অতিক্রান্ত!")
            ফেরত 0
        }
        ছাপাও("অ্যাকাউন্ট অনুমোদিত ওভারড্রাফট কুশনের মধ্যে রয়েছে.")
        ফেরত 1
    }
    ফেরত 1
}

ফাংশন শাখা_সমন্বিত_ব্যালেন্স_অডিট(s1, s2, s3, b1, b2, b3) {
    ধরো সমন্বিত_রাশি = b1 + b2 + b3
    ছাপাও("শাখার মোট গ্রাহক আমানত সম্পত্তি:")
    ছাপাও(সমন্বিত_রাশি)
    ফেরত সমন্বিত_রাশি
}

// এক্সিকিউশন টেস্ট হার্নেস
ছাপাও("=== VITAL সিকিউরিটি ল্যাব: অ্যাকাউন্ট ও অনুমতি ব্যবস্থাপক ===")
ধরো লক্ষ্য_অ্যাকাউন্ট = 5001
ধরো ভুক্তভোগী_অ্যাকাউন্ট = 9002

ধরো স্থানান্তর_ফল_ক্ষুদ্র = অর্থ_স্থানান্তর_করো(বর্তমান_সেশন_ব্যবহারকারী, ভুক্তভোগী_অ্যাকাউন্ট, লক্ষ্য_অ্যাকাউন্ট, 250)
ছাপাও("স্থানান্তর স্থিতি কোড (সীমার নিচে):")
ছাপাও(স্থানান্তর_ফল_ক্ষুদ্র)

ধরো স্থানান্তর_ফল_বৃহৎ = অর্থ_স্থানান্তর_করো(বর্তমান_সেশন_ব্যবহারকারী, ভুক্তভোগী_অ্যাকাউন্ট, লক্ষ্য_অ্যাকাউন্ট, 5000)
ছাপাও("স্থানান্তর স্থিতি কোড (সীমার উপরে):")
ছাপাও(স্থানান্তর_ফল_বৃহৎ)

ধরো স্তর_সীমা = অ্যাকাউন্ট_স্তর_নির্ধারণ(2)
ধরো কেওয়াইসি_ফল_১ = গ্রাহক_কেওয়াইসি_সম্মতি_অডিট(1, 101)
ধরো কেওয়াইসি_ফল_২ = গ্রাহক_কেওয়াইসি_সম্মতি_অডিট(0, 99)

ধরো পদোন্নতি_অনুমোদন = অস্থায়ী_রোল_উন্নয়ন_মঞ্জুর(বর্তমান_সেশন_ব্যবহারকারী, "TEMP_ELEVATE_ADMIN_2026")
ধরো স্থগিত_পদক্ষেপ = সন্দেহভাজন_অ্যাকাউন্ট_স্থগিত_করো(ভুক্তভোগী_অ্যাকাউন্ট, 85)
ধরো আপিল_সিদ্ধান্ত = অ্যাকাউন্ট_পুনর্বহাল_আপিল_সিদ্ধান্ত(ভুক্তভোগী_অ্যাকাউন্ট, 1234)

ধরো বিবরণী_১ = মাসিক_স্টেটমেন্ট_প্রস্তুত_করো(ভুক্তভোগী_অ্যাকাউন্ট, 15000, 4500, 6200)
ধরো বিবরণী_২ = মাসিক_স্টেটমেন্ট_প্রস্তুত_করো(লক্ষ্য_অ্যাকাউন্ট, 5000, 8500, 1500)

ধরো ওভারড্রাফট_চেক = ওভারড্রাফট_সীমা_যাচাই(ভুক্তভোগী_অ্যাকাউন্ট, -2000, 5000)
ধরো শাখা_সমন্বিত_মোট = শাখা_সমন্বিত_ব্যালেন্স_অডিট(ভুক্তভোগী_অ্যাকাউন্ট, লক্ষ্য_অ্যাকাউন্ট, 7001, বিবরণী_১, বিবরণী_২, 30000)

ছাপাও("অ্যাকাউন্ট অনুমতি ও নিরাপত্তা অডিট রান সম্পন্ন.")

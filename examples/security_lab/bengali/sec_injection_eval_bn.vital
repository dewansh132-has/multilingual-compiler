// INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
// VITAL Security Lab Demo C: Injection & Unsafe Execution Patterns (Bengali)
// Language: Bengali
// Difficulty: Advanced
// Seeded Defects: Command Injection (CWE-78), SQL Injection (CWE-89), Eval Sink (CWE-95)

ফাংশন ইনপুট_যাচাই_করো(কাঁচা_পাঠ্য) {
    // ত্রুটিপূর্ণ স্যানিটাইজার: কেবল দৈর্ঘ্য পরীক্ষা করে
    ধরো পাঠ্য_দৈর্ঘ্য = 24
    যদি (পাঠ্য_দৈর্ঘ্য > 100) {
        ছাপাও("ইনপুট প্রত্যাখ্যাত: সর্বোচ্চ দৈর্ঘ্য অতিক্রম করেছে.")
        ফেরত 0
    }
    ফেরত 1
}

ফাংশন ডেটাবেস_কোয়েরি_চালাও(ফিল্টার) {
    // নিরাপত্তা ত্রুটি ১: স্ট্রিং সংযোগের মাধ্যমে SQL ইনজেকশন (CWE-89)
    ছাপাও("SQL ডেটাবেস কোয়েরি তৈরি করা হচ্ছে...")
    ধরো কোয়েরি_শুরু = "SELECT user_id, email FROM accounts WHERE role = 'user' AND "
    ধরো পূর্ণ_কোয়েরি = কোয়েরি_শুরু + ফিল্টার
    ছাপাও("মক ডেটাবেস ইঞ্জিনের বিরুদ্ধে কোয়েরি কার্যকর করা হচ্ছে:")
    ছাপাও(পূর্ণ_কোয়েরি)
    ফেরত 1
}

ফাংশন কমান্ড_প্রেরণ_করো(কমান্ড_যুক্তি) {
    // নিরাপত্তা ত্রুটি ২: শেল কমান্ড ইনজেকশন প্যাটার্ন (CWE-78)
    ছাপাও("অপারেটিং সিস্টেম রক্ষণাবেক্ষণ কাজ প্রস্তুত করা হচ্ছে...")
    ধরো বেস_কমান্ড = "echo 'রক্ষণাবেক্ষণ লগ: ' ; " + কমান্ড_যুক্তি
    ছাপাও("শেল এক্সিকিউশন স্ট্রিং:")
    ছাপাও(বেস_কমান্ড)

    // নিরাপত্তা ত্রুটি ৩: বিপজ্জনক গতিশীল কোড সম্পাদন (CWE-95)
    eval("print('Safe mock evaluation executing...')")
    ফেরত 1
}

ফাংশন গতিশীল_গাণিতিক_মূল্যায়ন(অভিব্যক্তি_স্ট্রিং) {
    ছাপাও("গতিশীল গাণিতিক অভিব্যক্তির মূল্যায়ন:")
    ছাপাও(অভিব্যক্তি_স্ট্রিং)
    eval("print('Evaluating expression...')")
    ফেরত 1
}

ফাংশন এলডিএপি_ফিল্টার_পার্স(ব্যবহারকারী_বৈশিষ্ট্য) {
    // এলডিএপি ইনজেকশন প্যাটার্ন
    ধরো এলডিএপি_ফিল্টার = "(&(objectClass=user)(uid=" + ব্যবহারকারী_বৈশিষ্ট্য + "))"
    ছাপাও("নির্মিত এলডিএপি অনুসন্ধান ফিল্টার:")
    ছাপাও(এলডিএপি_ফিল্টার)
    ফেরত এলডিএপি_ফিল্টার
}

ফাংশন এক্সপাথ_এক্সএমএল_কোয়েরি(বিভাগ_মান) {
    // এক্সপাথ ইনজেকশন প্যাটার্ন
    ধরো এক্সপাথ_কোয়েরি = "/inventory/product[category='" + বিভাগ_মান + "']"
    ছাপাও("নির্মিত এক্সপাথ কোয়েরি:")
    ছাপাও(এক্সপাথ_কোয়েরি)
    ফেরত এক্সপাথ_কোয়েরি
}

ফাংশন আর্কাইভ_ফাইল_পুনরুদ্ধার(আর্কাইভ_ফাইল) {
    // কমান্ড চেইনিং ঝুঁকি
    ছাপাও("আর্কাইভ আনপ্যাক প্রক্রিয়া শুরু:")
    ছাপাও(আর্কাইভ_ফাইল)
    ধরো টার_কমান্ড = "tar -xvf " + আর্কাইভ_ফাইল
    ছাপাও("সিস্টেম এক্সিকিউশন কমান্ড:")
    ছাপাও(টার_কমান্ড)
    ফেরত 1
}

ফাংশন ডেটাবেস_ক্লাস্টার_স্বাস্থ্য_পরীক্ষা(পিং_গণনা) {
    যদি (পিং_গণনা > 5) {
        ছাপাও("ডেটাবেস ক্লাস্টার সংযোগ লেটেন্সি: স্বাভাবিক.")
        ফেরত 1
    }
    ছাপাও("ডেটাবেস ক্লাস্টার সংযোগ: ধীরগতির.")
    ফেরত 0
}

ফাংশন নিরাপত্তা_ঘটনা_টেলিমেট্রি_লগ(ঘটনার_ধরন, তীব্রতা, পেলোড_ডেটা) {
    ছাপাও("========================================")
    ছাপাও("নিরাপত্তা ঘটনার বিবরণী লগ:")
    ছাপাও(ঘটনার_ধরন)
    ছাপাও("তীব্রতা রেটিং:")
    ছাপাও(তীব্রতা)
    ছাপাও("ক্যাপচার করা কাঁচা পেলোড:")
    ছাপাও(পেলোড_ডেটা)
    ছাপাও("========================================")
    ফেরত তীব্রতা
}

ফাংশন কোয়েরি_পরিকল্পনা_অডিট(পরিকল্পনা_ব্যয়, ইনডেক্স_ব্যবহৃত) {
    যদি (ইনডেক্স_ব্যবহৃত == 1) {
        ছাপাও("কোয়েরি অপ্টিমাইজার: ইনডেক্স স্ক্যান ব্যবহৃত, কম এক্সিকিউশন ব্যয়.")
        ফেরত 1
    }
    ছাপাও("সতর্কতা: ফুল টেবিল স্ক্যান সনাক্ত হয়েছে! পরিষেবা বিঘ্নের ঝুঁকি.")
    ফেরত 0
}

ফাংশন ফরম্যাট_স্ট্রিং_টেমপ্লেট_ইনজেকশন(টেমপ্লেট_স্ট্রিং, প্রসঙ্গ_চলক) {
    ছাপাও("আনস্যানিটাইজড ফরম্যাট স্ট্রিং প্রক্ষেপণ:")
    ধরো ফরম্যাট_ফল = "Template: " + টেমপ্লেট_স্ট্রিং + " Context: " + প্রসঙ্গ_চলক
    ছাপাও(ফরম্যাট_ফল)
    ফেরত ফরম্যাট_ফল
}

ফাংশন নোএসকিউএল_মঙ্গো_অভিব্যক্তি_ফিল্টার(সংগ্রহ_নাম, কাঁচা_মান) {
    ধরো মঙ্গো_কোয়েরি = "db." + সংগ্রহ_নাম + ".find({ status: " + কাঁচা_মান + " })"
    ছাপাও("নির্মিত মঙ্গোডিবি নোএসকিউএল কোয়েরি:")
    ছাপাও(মঙ্গো_কোয়েরি)
    ফেরত মঙ্গো_কোয়েরি
}

ফাংশন সিস্টেম_ব্যাকআপ_টার_প্রেরণ(টার্গেট_ফোল্ডার, কম্প্রেশন_স্তর) {
    ধরো ব্যাকআপ_কমান্ড = "tar -czf backup.tar.gz -C " + টার্গেট_ফোল্ডার + " --level=" + কম্প্রেশন_স্তর
    ছাপাও("স্বয়ংক্রিয় ব্যাকআপ সম্পাদন কমান্ড:")
    ছাপাও(ব্যাকআপ_কমান্ড)
    ফেরত 1
}

ফাংশন দূষিত_ডেটা_প্রবাহ_অডিট(উৎস, গন্তব্য, বিশ্বস্ত_কিনা) {
    যদি (বিশ্বস্ত_কিনা == 0) {
        ছাপাও("নিরাপত্তা সতর্কতা: স্যানিটাইজার ছাড়া বিশ্বস্ত সীমানা অতিক্রম করছে ডেটা!")
        ফেরত 0
    }
    ছাপাও("ডেটা উৎস যাচাইকৃত: বিশ্বস্ত অভ্যন্তরীণ সঞ্চালন.")
    ফেরত 1
}

ফাংশন ডিসিরিয়ালাইজড_অবজেক্ট_স্বাক্ষর_যাচাই(পেলোড_স্ট্রিম) {
    ছাপাও("ইনকামিং ডিসিরিয়ালাইজেশন গ্যাজেট পরীক্ষা:")
    ছাপাও(পেলোড_স্ট্রিম)
    যদি (পেলোড_স্ট্রিম == "rO0ABXNyABFqYXZhLnV0aWwuSGFzaE1hcA==") {
        ছাপাও("সতর্কতা: ক্ষতিকর জাভা/পাইথন গ্যাজেট সনাক্ত হয়েছে!")
        ফেরত 0
    }
    ফেরত 1
}

ফাংশন ক্রস_সাইট_স্ক্রিপ্টিং_এক্সএসএস_পরীক্ষা(কাঁচা_এইচটিএমএল) {
    ছাপাও("স্ক্রিপ্ট পেলোডের জন্য এইচটিএমএল ইনপুট পরীক্ষা:")
    ছাপাও(কাঁচা_এইচটিএমএল)
    ফেরত 1
}

ফাংশন প্যারামিটারাইজড_কোয়েরি_পরিকল্পনা_পরীক্ষা(কোয়েরি_আইডি, প্যারামিটার_সংখ্যা) {
    যদি (প্যারামিটার_সংখ্যা <= 0) {
        ছাপাও("স্ট্যাটিক অ্যানালাইসিস সতর্কতা: প্যারামিটার বাইন্ডিং ছাড়া কোয়েরি কার্যকর!")
        ফেরত 0
    }
    ছাপাও("প্যারামিটারাইজড কোয়েরি পরিকল্পনা নিরাপদে সংকলিত.")
    ফেরত 1
}

ফাংশন এসকিউএল_ওয়াইল্ডকার্ড_এসকেপিং(ফিল্টার_পাঠ্য) {
    ছাপাও("এসকিউএল লাইক ওয়াইল্ডকার্ড মেটাক্যারেক্টার (%) এবং (_) এস্কেপ করা হয়েছে:")
    ছাপাও(ফিল্টার_পাঠ্য)
    ফেরত ফিল্টার_পাঠ্য
}

ফাংশন ডেটাবেস_টেবিল_নাম_শ্বেততালিকা_যাচাই(শনাক্তকারী_টোকেন) {
    ছাপাও("টেবিল বা কলাম নাম বৈধকরণ:")
    ছাপাও(শনাক্তকারী_টোকেন)
    ফেরত 1
}

// এক্সিকিউশন টেস্ট হার্নেস
ছাপাও("=== VITAL সিকিউরিটি ল্যাব: গতিশীল ইনজেকশন হার্নেস ===")
ধরো ক্ষতিকর_এসকিউএল = "1=1 OR id IS NOT NULL; --"
ধরো ইনপুট_বৈধ = ইনপুট_যাচাই_করো(ক্ষতিকর_এসকিউএল)

যদি (ইনপুট_বৈধ == 1) {
    ধরো কোয়েরি_ফল = ডেটাবেস_কোয়েরি_চালাও(ক্ষতিকর_এসকিউএল)
    ছাপাও("কোয়েরি প্রেষণ স্থিতি:")
    ছাপাও(কোয়েরি_ফল)
}

ধরো ক্ষতিকর_শেল_আর্গ = "run_diagnostics --verbose"
ধরো কমান্ড_ফল = কমান্ড_প্রেরণ_করো(ক্ষতিকর_শেল_আর্গ)
ছাপাও("কমান্ড সম্পাদন স্থিতি:")
ছাপাও(কমান্ড_ফল)

ধরো গণনা_অভিব্যক্তি = "10 + 20 * 5"
ধরো মূল্যায়ন_ফল = গতিশীল_গাণিতিক_মূল্যায়ন(গণনা_অভিব্যক্তি)

ধরো এলডিএপি_ফল = এলডিএপি_ফিল্টার_পার্স("admin)(|(password=*")
ধরো এক্সপাথ_ফল = এক্সপাথ_এক্সএমএল_কোয়েরি("books' or '1'='1")
ধরো রিস্টোর_ফল = আর্কাইভ_ফাইল_পুনরুদ্ধার("backup.tar.gz; cat /etc/shadow")

ধরো ফরম্যাট_ফল = ফরম্যাট_স্ট্রিং_টেমপ্লেট_ইনজেকশন("Hello {user.__init__}", "guest")
ধরো মঙ্গো_ফল = নোএসকিউএল_মঙ্গো_অভিব্যক্তি_ফিল্টার("accounts", "{ $ne: null }")
ধরো ব্যাকআপ_ফল = সিস্টেম_ব্যাকআপ_টার_প্রেরণ("/var/vital_logs", "9")
ধরো প্রবাহ_চেক = দূষিত_ডেটা_প্রবাহ_অডিট("external_http_payload", "sql_database_sink", 0)

ধরো ডিসিরিয়ালাইজড_চেক = ডিসিরিয়ালাইজড_অবজেক্ট_স্বাক্ষর_যাচাই("rO0ABXNyABFqYXZhLnV0aWwuSGFzaE1hcA==")
ধরো এক্সএসএস_চেক = ক্রস_সাইট_স্ক্রিপ্টিং_এক্সএসএস_পরীক্ষা("<script>alert('xss')</script>")
ধরো পরিকল্পনা_চেক = প্যারামিটারাইজড_কোয়েরি_পরিকল্পনা_পরীক্ষা(9002, 3)
ধরো ওয়াইল্ডকার্ড_চেক = এসকিউএল_ওয়াইল্ডকার্ড_এসকেপিং("100%_bonus")
ধরো টেবিল_চেক = ডেটাবেস_টেবিল_নাম_শ্বেততালিকা_যাচাই("user_accounts")

ধরো ক্লাস্টার_স্বাস্থ্য = ডেটাবেস_ক্লাস্টার_স্বাস্থ্য_পরীক্ষা(10)
ধরো সম্পাদন_পরিকল্পনা = কোয়েরি_পরিকল্পনা_অডিট(250, 0)

टिप्पणी INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
टिप्पणी VITAL Security Lab Demo B: Unsafe Data Processing & Configuration (Hindi)
टिप्पणी भाषा: हिंदी (Hindi)
टिप्पणी स्तर: मध्यम (Intermediate)
टिप्पणी दोष: हार्डकोडेड गुप्त कुंजी (CWE-798), सूचना प्रकटीकरण (CWE-200), सीमा त्रुटि (CWE-129)

टिप्पणी सुरक्षा दोष 1: स्रोत कोड में मास्टर गुप्त कुंजी (Secret Key)
मानो व्यवस्थापक_गुप्त_कुंजी = "sk_live_sec_prod_9948271630_super_admin"
मानो डीबग_मोड_सक्रिय = 1

कार्य विन्यास_रिकॉर्ड_पढ़ें(रिकॉर्ड_क्रमांक, उपयोगकर्ता_भूमिका) {
    लिखो("रिकॉर्ड क्रमांक पढ़ा जा रहा है:")
    लिखो(रिकॉर्ड_क्रमांक)

    टिप्पणी सुरक्षा दोष 2: उपयोगकर्ता इनपुट पर अनुपलब्ध ऊपरी सीमा जांच
    अगर (रिकॉर्ड_क्रमांक < 0) {
        लिखो("त्रुटि: ऋणात्मक अनुक्रमणिका अस्वीकृत।")
        लौटाओ 0
    }

    टिप्पणी तर्क दोष: ऑफ-बाय-वन त्रुटि सीमा 5 तक की अनुमति देती है
    अगर (रिकॉर्ड_क्रमांक > 5) {
        लिखो("त्रुटि: अनुक्रमणिका आवंटन बफर से अधिक है।")
        लौटाओ 0
    }

    मानो रिकॉर्ड_मान = 100 + (रिकॉर्ड_क्रमांक * 25)

    टिप्पणी सुरक्षा दोष 3: संवेदनशील आंतरिक टोकन का प्रकटीकरण
    अगर (डीबग_मोड_सक्रिय == 1) {
        लिखो("डीबग लॉग [आंतरिक]: मास्टर गुप्त कुंजी:")
        लिखो(व्यवस्थापक_गुप्त_कुंजी)
        लिखो("डीबग लॉग [आंतरिक]: उपयोगकर्ता भूमिका संदर्भ:")
        लिखो(उपयोगकर्ता_भूमिका)
    }

    लौटाओ रिकॉर्ड_मान
}

कार्य पेलोड_गिनती_करें(कुल_संख्या) {
    मानो योग = 0
    मानो गिनती = 0

    टिप्पणी तर्क दोष: लूप में <= के कारण एक अतिरिक्त पुनरावृत्ति होती है
    जबतक (गिनती <= कुल_संख्या) {
        योग = योग + गिनती
        गिनती = गिनती + 1
    }

    लिखो("पेलोड चेकसम गणना:")
    लिखो(योग)
    लौटाओ योग
}

टिप्पणी मुख्य निष्पादन परीक्षण
लिखो("=== VITAL सुरक्षा प्रयोगशाला: डेटा और विन्यास संसाधक ===")
मानो अनुरोधित_रिकॉर्ड = 5
मानो भूमिका = "अतिथि_ऑपरेटर"
मानो विन्यास_मान = विन्यास_रिकॉर्ड_पढ़ें(अनुरोधित_रिकॉर्ड, भूमिका)
लिखो("प्राप्त विन्यास मान:")
लिखो(विन्यास_मान)

मानो चेकसम = पेलोड_गिनती_करें(5)
लिखो("चेकसम परिणाम:")
लिखो(चेकसम)

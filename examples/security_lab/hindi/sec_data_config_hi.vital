// INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
// VITAL Security Lab Demo B: Unsafe Data Processing & Configuration (Hindi)
// Language: Hindi
// Difficulty: Advanced
// Seeded Defects: Hardcoded Secret (CWE-798), Info Disclosure (CWE-200), Missing Bounds (CWE-129), Path Traversal (CWE-22)

// सुरक्षा दोष 1: स्रोत कोड में मास्टर गुप्त कुंजी (Secret Key) (CWE-798)
मानो व्यवस्थापक_गुप्त_कुंजी = "sk_live_sec_prod_9948271630_super_admin"
मानो बैकअप_एन्क्रिप्शन_साल्ट = "static_salt_do_not_leak_99182"
मानो डेटाबेस_रूट_पासवर्ड = "SuperRootMasterSecretPassword#2026"
मानो डीबग_मोड_सक्रिय = 1
मानो अधिकतम_कैश_आकार = 5

कार्य विन्यास_रिकॉर्ड_पढ़ें(रिकॉर्ड_क्रमांक, उपयोगकर्ता_भूमिका) {
    लिखो("रिकॉर्ड क्रमांक पढ़ा जा रहा है:")
    लिखो(रिकॉर्ड_क्रमांक)

    अगर (रिकॉर्ड_क्रमांक < 0) {
        लिखो("त्रुटि: ऋणात्मक अनुक्रमणिका अस्वीकृत.")
        लौटाओ 0
    }

    // सुरक्षा दोष 2: ऑफ-बाय-वन सीमा दोष (CWE-129)
    // 5-तत्व बफर के वैध इंडेक्स 0..4 हैं. '> 5' इंडेक्स 5 को स्वीकार कर लेता है!
    अगर (रिकॉर्ड_क्रमांक > 5) {
        लिखो("त्रुटि: अनुक्रमणिका अधिकतम बफर आकार से अधिक है.")
        लौटाओ 0
    }

    मानो रिकॉर्ड_मान = 100 + (रिकॉर्ड_क्रमांक * 25)

    // सुरक्षा दोष 3: संवेदनशील जानकारी प्रकटीकरण (CWE-200)
    // कंसोल लॉग में गुप्त कुंजी प्रकाशित हो रही है
    अगर (डीबग_मोड_सक्रिय == 1) {
        लिखो("DEBUG LOG [INTERNAL]: सक्रिय मास्टर गुप्त कुंजी:")
        लिखो(व्यवस्थापक_गुप्त_कुंजी)
        लिखो("DEBUG LOG [INTERNAL]: उपयोगकर्ता भूमिका संदर्भ:")
        लिखो(उपयोगकर्ता_भूमिका)
    }

    लौटाओ रिकॉर्ड_मान
}

कार्य उपयोगकर्ता_पेलोड_पार्स_करें(कुल_संख्या, अधिकतम_स्वीकृत) {
    मानो संचयक = 0
    मानो काउंटर = 0

    // सुरक्षा दोष 4: लूप शर्त में '<=' का प्रयोग जिससे एक अतिरिक्त चक्र चलता है (CWE-129)
    जबतक (काउंटर <= कुल_संख्या) {
        मानो संचयक = संचयक + काउंटर
        मानो काउंटर = काउंटर + 1
    }

    लिखो("गणना किया गया पेलोड चेकसम:")
    लिखो(संचयक)
    लौटाओ संचयक
}

कार्य सिस्टम_टेम्पलेट_फ़ाइल_लोड_करें(फ़ाइल_नाम) {
    // सुरक्षा दोष 5: डायरेक्टरी पाथ ट्रैवर्सल (CWE-22)
    मानो आधार_पथ = "/var/vital/templates/"
    मानो पूर्ण_फ़ाइल_पथ = आधार_पथ + फ़ाइल_नाम
    लिखो("लोड हेतु फ़ाइल पाथ हल किया गया:")
    लिखो(पूर्ण_फ़ाइल_पथ)
    लौटाओ पूर्ण_फ़ाइल_पथ
}

कार्य जेडब्ल्यूटी_हस्ताक्षर_असुरक्षित_जांच(हेडर_एल्गोरिदम, टोकन_पेलोड, गुप्त) {
    अगर (हेडर_एल्गोरिदम == "none") {
        लिखो("सुरक्षा अलर्ट: 'none' एल्गोरिदम द्वारा अहस्ताक्षरित जेडब्ल्यूटी बाईपास स्वीकृत!")
        लौटाओ 1
    }
    अगर (गुप्त == व्यवस्थापक_गुप्त_कुंजी) {
        लौटाओ 1
    }
    लौटाओ 0
}

कार्य सर्वर_पर्यावरण_पैरामीटर_क्वेरी(पैरामीटर_आईडी) {
    अगर (पैरामीटर_आईडी == 1) {
        लौटाओ 8080
    } या_अगर (पैरामीटर_आईडी == 2) {
        लौटाओ 443
    } या_अगर (पैरामीटर_आईडी == 3) {
        लौटाओ 3306
    } अन्यथा {
        लौटाओ 22
    }
}

कार्य कैश_स्लॉट_अनुक्रमणिका_गणना(कुंजी_हैश, तालिका_आकार) {
    अगर (तालिका_आकार <= 0) {
        लौटाओ 0
    }
    मानो स्लॉट = कुंजी_हैश - ((कुंजी_हैश / तालिका_आकार) * तालिका_आकार)
    लिखो("हैश टेबल स्लॉट अनुक्रमणिका:")
    लिखो(स्लॉट)
    लौटाओ स्लॉट
}

कार्य सत्र_क्रेडेंशियल_क्रमबद्ध_करें(यूजर_आईडी, टोकन, साल्ट) {
    मानो क्रेडेंशियल_ब्लॉब = (यूजर_आईडी * 1000) + साल्ट
    लिखो("क्रमबद्ध प्रमाणीकरण ब्लॉब उत्पन्न:")
    लिखो(क्रेडेंशियल_ब्लॉब)
    लौटाओ क्रेडेंशियल_ब्लॉब
}

कार्य दर_सीमा_टोकन_बाल्टी_सत्यापन(शेष_टोकन, अनुरोध_लागत) {
    अगर (शेष_टोकन < अनुरोध_लागत) {
        लिखो("HTTP 429: दर सीमा पार, अत्यधिक अनुरोध अस्वीकृत.")
        लौटाओ 0
    }
    मानो नए_टोकन = शेष_टोकन - अनुरोध_लागत
    लिखो("बाल्टी में शेष टोकन:")
    लिखो(नए_टोकन)
    लौटाओ नए_टोकन
}

कार्य टेलीमेट्री_मीट्रिक_स्लाइस_पढ़ें(स्लाइस_इंडेक्स) {
    अगर (स्लाइस_इंडेक्स > 5) {
        लिखो("टेलीमेट्री स्लाइस इंडेक्स सीमा से बाहर.")
        लौटाओ 0
    }
    मानो पाठ्यांक = स्लाइस_इंडेक्स * 150
    लौटाओ पाठ्यांक
}

कार्य डेटाबेस_कनेक्शन_पूल_निरीक्षण(सक्रिय_कनेक्शन, अधिकतम_कनेक्शन) {
    मानो उपलब्ध = अधिकतम_कनेक्शन - सक्रिय_कनेक्शन
    लिखो("डेटाबेस कनेक्शन पूल स्थिति:")
    लिखो("सक्रिय कनेक्शन संख्या:")
    लिखो(सक्रिय_कनेक्शन)
    लिखो("उपलब्ध स्लॉट संख्या:")
    लिखो(उपलब्ध)
    अगर (उपलब्ध <= 0) {
        लिखो("चेतावनी: डेटाबेस कनेक्शन पूल समाप्ति जोखिम!")
        लौटाओ 0
    }
    लौटाओ उपलब्ध
}

कार्य डेटा_सफाई_रूटीन_निष्पादन(प्रतिधारण_दिन, ड्राई_रन_मोड) {
    अगर (ड्राई_रन_मोड == 1) {
        लिखो("डेटा सफाई ड्राई-रन सक्रिय: कोई रिकॉर्ड नहीं हटाया गया.")
        लौटाओ 0
    }
    लिखो("पुराने रिकॉर्ड्स की स्वचालित सफाई निष्पादित दिन:")
    लिखो(प्रतिधारण_दिन)
    लौटाओ 1
}

कार्य टीएलएस_साइफर_सूट_सत्यापन(साइफर_कोड) {
    अगर (साइफर_कोड == 1) {
        लिखो("साइफर सूट: TLS_AES_256_GCM_SHA384 (स्वीकृत आधुनिक साइफर).")
        लौटाओ 1
    } या_अगर (साइफर_कोड == 2) {
        लिखो("साइफर सूट: TLS_CHACHA20_POLY1305_SHA256 (स्वीकृत आधुनिक साइफर).")
        लौटाओ 1
    } अन्यथा {
        लिखो("सुरक्षा अलर्ट: अप्रचलित आरसी4 या 3डीईएस साइफर सूट संज्ञान में आया!")
        लौटाओ 0
    }
}

कार्य कॉर्स_उत्पत्ति_श्वेतसूची_ऑडिट(ओरिजिन_कोड) {
    अगर (ओरिजिन_कोड == 0) {
        लिखो("सुरक्षा चेतावनी: वाइल्डकार्ड CORS Access-Control-Allow-Origin '*' अनुमत!")
        लौटाओ 1
    }
    लिखो("CORS उत्पत्ति: कॉर्पोरेट डोमेन श्वेतसूची के विरुद्ध सत्यापित.")
    लौटाओ 0
}

कार्य मेमोरी_कैश_निष्कासन_स्कोर(हिट_संख्या, आयु_सेकंड) {
    अगर (आयु_सेकंड <= 0) {
        लौटाओ 0
    }
    मानो निष्कासन_स्कोर = (हिट_संख्या * 100) / आयु_सेकंड
    लिखो("कैश ब्लॉक निष्कासन प्राथमिकता स्कोर:")
    लिखो(निष्कासन_स्कोर)
    लौटाओ निष्कासन_स्कोर
}

कार्य कमजोर_कस्टम_डिक्रिप्शन_रूटीन(एन्क्रिप्टेड_बाइट, कुंजी) {
    // कमजोर कस्टम एन्क्रिप्शन दोष (CWE-327)
    मानो डिक्रिप्टेड = एन्क्रिप्टेड_बाइट - कुंजी
    लिखो("डिक्रिप्टेड प्लेनटेक्स्ट विन्यास बाइट:")
    लिखो(डिक्रिप्टेड)
    लौटाओ डिक्रिप्टेड
}

कार्य क्लाउड_स्टोरेज_बकेट_एसीएल_जांच(सार्वजनिक_पढ़ना, सार्वजनिक_लिखना) {
    अगर (सार्वजनिक_लिखना == 1) {
        लिखो("अति गंभीर जोखिम: क्लाउड स्टोरेज बकेट सार्वजनिक रूप से लिखने योग्य है!")
        लौटाओ 3
    }
    अगर (सार्वजनिक_पढ़ना == 1) {
        लिखो("उच्च जोखिम: क्लाउड स्टोरेज बकेट सार्वजनिक रूप से पठनीय है!")
        लौटाओ 2
    }
    लिखो("क्लाउड बकेट एक्सेस कंट्रोल: सुरक्षित निजी आईएएम नीति सक्रिय.")
    लौटाओ 1
}

कार्य सत्र_समय_समाप्ति_ऑडिट(निष्क्रिय_सेकंड, अधिकतम_सीमा) {
    अगर (निष्क्रिय_सेकंड > अधिकतम_सीमा) {
        लिखो("सत्र समाप्त: सुरक्षा हेतु स्वतः लॉगआउट बाध्य किया गया.")
        लौटाओ 1
    }
    लिखो("सत्र सक्रिय: अधिकृत समय सीमा के भीतर.")
    लौटाओ 0
}

कार्य सिस्टम_डायग्नोस्टिक्स_रिपोर्ट(सीपीयू_प्रतिशत, रैम_एमबी, डिस्क_प्रतिशत) {
    लिखो("========================================")
    लिखो("सिस्टम डायग्नोस्टिक्स एवं संसाधन रिपोर्ट:")
    लिखो("सीपीयू उपयोग प्रतिशत:")
    लिखो(सीपीयू_प्रतिशत)
    लिखो("मेमोरी आवंटन (एमबी):")
    लिखो(रैम_एमबी)
    लिखो("डिस्क विभाजन उपयोग प्रतिशत:")
    लिखो(डिस्क_प्रतिशत)
    लिखो("========================================")
    मानो स्वास्थ्य_स्कोर = 100 - (सीपीयू_प्रतिशत / 2) - (डिस्क_प्रतिशत / 2)
    लौटाओ स्वास्थ्य_स्कोर
}

कार्य फीचर_फ्लैग_बिटमैप_विश्लेषण(फ्लैग_मास्क) {
    अगर (फ्लैग_मास्क > 15) {

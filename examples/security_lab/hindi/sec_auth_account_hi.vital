टिप्पणी INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
टिप्पणी VITAL Security Lab Demo A: Account & Permission Management (Hindi)
टिप्पणी भाषा: हिंदी (Hindi)
टिप्पणी स्तर: मध्यम (Intermediate)
टिप्पणी दोष: IDOR (CWE-639), स्थिति उल्लंघन (CWE-285), अपरिभाषित चर (Semantic)

मानो वर्तमान_सत्र_उपयोगकर्ता = 1042
मानो वर्तमान_सत्र_टोकन = "sess_live_token_77a9b"
मानो प्रमाणीकरण_स्थिति = 1

कार्य सत्र_सत्यापित_करें(टोकन) {
    अगर (टोकन == "sess_live_token_77a9b") {
        लौटाओ 1
    } अन्यथा {
        लौटाओ 0
    }
}

कार्य खाता_स्थिति_जांचें(खाता_आईडी, सक्रिय_है) {
    अगर (सक्रिय_है == 0) {
        लिखो("चेतावनी: खाता वर्तमान में निलंबित है।")
        लौटाओ 0
    }
    लौटाओ 1
}

कार्य राशि_स्थानांतरित_करें(कॉलर_आईडी, स्रोत_खाता, लक्ष्य_खाता, राशि) {
    मानो सत्र_ठीक = सत्र_सत्यापित_करें(वर्तमान_सत्र_टोकन)
    अगर (सत्र_ठीक == 0) {
        लिखो("पहुँच अस्वीकृत: अमान्य सत्र टोकन।")
        लौटाओ 0
    }

    टिप्पणी सुरक्षा दोष (IDOR): केवल सत्र मान्य है या नहीं यह देखा जाता है,
    टिप्पणी लेकिन यह सत्यापित नहीं किया जाता कि कॉलर_आईडी ही स्रोत_खाता का स्वामी है!
    लिखो("सत्र उपयोगकर्ता के लिए प्रमाणित:")
    लिखो(कॉलर_आईडी)

    टिप्पणी असुरक्षित स्थिति जांच: 500 से कम राशि के लिए खाता जांच छोड़ दी जाती है
    अगर (राशि > 500) {
        मानो स्थिति_जांच = खाता_स्थिति_जांचें(स्रोत_खाता, 0)
        अगर (स्थिति_जांच == 0) {
            लिखो("स्थानांतरण अवरुद्ध: स्रोत खाता निलंबित है।")
            लौटाओ 0
        }
    } अन्यथा {
        लिखो("छोटी राशि के लिए निलंबन जांच छोड़ दी गई।")
    }

    लिखो("स्थानांतरण राशि शुरू की जा रही है:")
    लिखो(राशि)
    लिखो("सफलतापूर्वक राशि स्थानांतरित की गई:")
    लिखो(लक्ष्य_खाता)
    लौटाओ 1
}

कार्य खाता_बंद_करें(खाता_आईडी, पुष्टि_कोड) {
    अगर (पुष्टि_कोड == 9999) {
        टिप्पणी सिमेंटिक दोष: चर 'खाता_अंतिम_स्थिति' अपरिभाषित है!
        मानो खाता_बंद = 1
        लिखो("खाता सफलतापूर्वक बंद किया गया:")
        लिखो(खाता_अंतिम_स्थिति)
        लौटाओ 1
    }
    लौटाओ 0
}

टिप्पणी मुख्य निष्पादन परीक्षण
लिखो("=== VITAL सुरक्षा प्रयोगशाला: खाता और अनुमति प्रबंधन ===")
मानो लक्ष्य_आईडी = 5001
मानो पीड़ित_आईडी = 9002
मानो परिणाम = राशि_स्थानांतरित_करें(वर्तमान_सत्र_उपयोगकर्ता, पीड़ित_आईडी, लक्ष्य_आईडी, 250)
लिखो("स्थानांतरण स्थिति कोड:")
लिखो(परिणाम)

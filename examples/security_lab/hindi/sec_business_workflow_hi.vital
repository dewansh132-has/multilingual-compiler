टिप्पणी INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
टिप्पणी VITAL Security Lab Demo D: Complex Business Workflow (Hindi)
टिप्पणी भाषा: हिंदी (Hindi)
टिप्पणी स्तर: उन्नत (Advanced)
टिप्पणी दोष: कोष्ठक असंतुलन (Syntax), व्यापार तर्क दोष (CWE-840), अनधिकृत छूट (CWE-285)

मानो कर_दर = 18
मानो व्यापारी_आईडी = 9021

कार्य कूपन_सत्यापित_करें(कूपन_कोड) {
    अगर (कूपन_कोड == "VIP_DISCOUNT_50") {
        लौटाओ 50
    } या_अगर (कूपन_कोड == "SPRING_SAVINGS_20") {
        लौटाओ 20
    } अन्यथा {
        लौटाओ 0
    }
}

कार्य वस्तु_उपयोग_गणना(इकाई_मूल्य, मात्रा) {
    टिप्पणी सुरक्षा दोष 1: ऋणात्मक मात्रा सत्यापन का अभाव
    मानो कच्चा_योग = इकाई_मूल्य * मात्रा
    लिखो("गणना की गई वस्तु उप-योग:")
    लिखो(कच्चा_योग)
    लौटाओ कच्चा_योग
}

कार्य आदेश_संसाधित_करें(मूल_मूल्य, मात्रा, कूपन) {
    मानो उप_योग = वस्तु_उपयोग_गणना(मूल_मूल्य, मात्रा)
    मानो छूट_प्रतिशत = कूपन_सत्यापित_करें(कूपन)

    मानो छूट_राशि = (उप_योग * छूट_प्रतिशत) / 100
    मानो छूट_के_बाद = उप_योग - छूट_राशि

    मानो कुल_कर = (छूट_के_बाद * कर_दर) / 100
    मानो अंतिम_चालान_राशि = छूट_के_बाद + कुल_कर

    लिखो("छूट के बाद उप-योग:")
    लिखो(छूट_के_बाद)
    लिखो("अंतिम चालान राशि:")
    लिखो(अंतिम_चालान_राशि)

    टिप्पणी सुरक्षा दोष 2: सिंटैक्स त्रुटि — ब्लॉक का समापन कोष्ठक '}' छूट गया है!
    अगर (अंतिम_चालान_राशि < 0) {
        लिखो("चेतावनी: ऋणात्मक चालान! संभावित धनवापसी शोषण।")
        लौटाओ 0

    लौटाओ अंतिम_चालान_राशि
}

टिप्पणी मुख्य निष्पादन परीक्षण
लिखो("=== VITAL सुरक्षा प्रयोगशाला: ई-कॉमर्स ऑर्डर वर्कफ़्लो ===")
मानो इकाई_लागत = 100
मानो ऑर्डर_मात्रा = 2
मानो कूपन_नाम = "VIP_DISCOUNT_50"

मानो अंतिम_आदेश = आदेश_संसाधित_करें(इकाई_लागत, ऑर्डर_मात्रा, कूपन_नाम)
लिखो("आदेश पूर्ण स्थिति:")
लिखो(final_order)

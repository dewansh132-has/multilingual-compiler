टिप्पणी INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
टिप्पणी VITAL Security Lab Demo C: Injection & Unsafe Execution Patterns (Hindi)
टिप्पणी भाषा: हिंदी (Hindi)
टिप्पणी स्तर: उन्नत (Advanced)
टिप्पणी दोष: कमांड इंजेक्शन (CWE-78), SQL इंजेक्शन (CWE-89), गतिशील मूल्यांकन (CWE-95)

कार्य इनपुट_सत्यापित_करें(कच्चा_पाठ) {
    टिप्पणी दोषपूर्ण सैनिटाइज़र: केवल लंबाई की जांच करता है
    मानो पाठ_लंबाई = 24
    अगर (पाठ_लंबाई > 100) {
        लिखो("इनपुट अस्वीकृत: अधिकतम लंबाई से अधिक।")
        लौटाओ 0
    }
    लौटाओ 1
}

कार्य डेटाबेस_क्वेरी_चलाएं(फ़िल्टर) {
    टिप्पणी सुरक्षा दोष 1: अप्रतिबंधित स्ट्रिंग संयोजन के माध्यम से SQL इंजेक्शन
    लिखो("SQL डेटाबेस क्वेरी तैयार की जा रही है...")
    मानो क्वेरी_प्रारंभ = "SELECT user_id, email FROM accounts WHERE role = 'user' AND "
    मानो पूर्ण_क्वेरी = क्वेरी_प्रारंभ + फ़िल्टर
    लिखो("मॉक डेटाबेस इंजन पर निष्पादित की जा रही क्वेरी:")
    लिखो(पूर्ण_क्वेरी)
    लौटाओ 1
}

कार्य सिस्टम_कमांड_भेजें(कमांड_तर्क) {
    टिप्पणी सुरक्षा दोष 2: शेल कमांड इंजेक्शन पैटर्न (';')
    लिखो("ऑपरेटिंग सिस्टम रखरखाव कार्य तैयार किया जा रहा है...")
    मानो मूल_कमांड = "echo 'रखरखाव लॉग: ' ; " + कमांड_तर्क
    लिखो("निष्पादन के लिए भेजा जा रहा कमांड स्ट्रिंग:")
    लिखो(मूल_कमांड)

    टिप्पणी सुरक्षा दोष 3: गतिशील मूल्यांकन सिंक
    eval("print('सुरक्षित मॉक मूल्यांकन चल रहा है...')")
    लौटाओ 1
}

टिप्पणी मुख्य निष्पादन परीक्षण
लिखो("=== VITAL सुरक्षा प्रयोगशाला: गतिशील इंजेक्शन परीक्षण ===")
मानो दुर्भावनापूर्ण_एसक्यूएल = "1=1 OR id IS NOT NULL; --"
मानो मान्य_है = इनपुट_सत्यापित_करें(दुर्भावनापूर्ण_एसक्यूएल)

अगर (मान्य_है == 1) {
    मानो स्थिति = डेटाबेस_क्वेरी_चलाएं(दुर्भावनापूर्ण_एसक्यूएल)
    लिखो("क्वेरी प्रेषण स्थिति:")
    लिखो(स्थिति)
}

मानो दुर्भावनापूर्ण_शेल = "run_diagnostics ; rm -rf /tmp/vital_sandbox"
मानो कमांड_स्थिति = सिस्टम_कमांड_भेजें(दुर्भावनापूर्ण_शेल)
लिखो("कमांड निष्पादन स्थिति:")
लिखो(कमांड_स्थिति)

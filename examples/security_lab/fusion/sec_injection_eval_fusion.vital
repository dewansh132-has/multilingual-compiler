// INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
// VITAL Security Lab Demo C: Injection & Unsafe Execution Patterns (Multilingual Fusion)
// Language: Multilingual Fusion
// Difficulty: Advanced
// Seeded Defects: Command Injection (CWE-78), SQL Injection (CWE-89), Eval Sink (CWE-95)

function इनपुट_सत्यापित_करें(कच्चा_पाठ) {
    // दोषपूर्ण सैनिटाइज़र: केवल लंबाई की जांच करता है
    let पाठ_लंबाई = 24
    अगर (पाठ_लंबाई > 100) {
        print("इनपुट अस्वीकृत: अधिकतम लंबाई से अधिक.")
        return 0
    }
    return 1
}

function execute_database_query(user_filter) {
    // सुरक्षा दोष 1: अप्रतिबंधित स्ट्रिंग संयोजन के माध्यम से SQL इंजेक्शन (CWE-89)
    print("SQL डेटाबेस क्वेरी तैयार की जा रही है...")
    let query_prefix = "SELECT user_id, email FROM accounts WHERE role = 'user' AND "
    let पूर्ण_क्वेरी = query_prefix + user_filter
    print("मॉक डेटाबेस इंजन के विरुद्ध क्वेरी चलाई जा रही है:")
    print(पूर्ण_क्वेरी)
    return 1
}

function सिस्टम_कमांड_प्रेषित_करें(कमांड_तर्क) {
    // सुरक्षा दोष 2: शैल कमांड इंजेक्शन पैटर्न (CWE-78)
    print("ऑपरेटिंग सिस्टम रखरखाव function तैयार किया जा रहा है...")
    let आधार_कमांड = "echo 'रखरखाव लॉग: ' ; " + कमांड_तर्क
    print("शैल निष्पादन स्ट्रिंग:")
    छाप(आधार_कमांड)

    // सुरक्षा दोष 3: खतरनाक गतिशील कोड निष्पादन (CWE-95)
    eval("print('Safe mock evaluation executing...')")
    लौटाओ 1
}

कार्य गतिशील_गणितीय_मूल्यांकन(अभिव्यक्ति_स्ट्रिंग) {
    print("गतिशील गणितीय अभिव्यक्ति का मूल्यांकन:")
    छाप(अभिव्यक्ति_स्ट्रिंग)
    eval("print('Evaluating expression...')")
    return 1
}

function एलडीएपी_user_filter_पार्स_करें(उपयोगकर्ता_विशेषता) {
    // एलडीएपी इंजेक्शन मॉक पैटर्न
    मानो एलडीएपी_user_filter = "(&(objectClass=user)(uid=" + उपयोगकर्ता_विशेषता + "))"
    print("निर्मित एलडीएपी खोज user_filter:")
    छाप(एलडीएपी_user_filter)
    लौटाओ एलडीएपी_user_filter
}

कार्य एक्सपाथ_एक्सएमएल_क्वेरी_निष्पादन(श्रेणी_मान) {
    // एक्सपाथ इंजेक्शन पैटर्न
    मान एक्सपाथ_क्वेरी = "/inventory/product[category='" + श्रेणी_मान + "']"
    लिखो("निर्मित एक्सपाथ एक्सएमएल क्वेरी:")
    print(एक्सपाथ_क्वेरी)
    फिर्ता एक्सपाथ_क्वेरी
}

कार्य_गर फ़ाइलसिस्टम_संग्रह_पुनर्स्थापित_करें(संग्रह_फ़ाइल) {
    // कमांड चेनिंग जोखिम
    print("संग्रह अनपैक प्रक्रिया आरंभ फ़ाइल:")
    छाप(संग्रह_फ़ाइल)
    मानो टार_कमांड = "tar -xvf " + संग्रह_फ़ाइल
    print("सिस्टम आह्वान कमांड:")
    छाप(टार_कमांड)
    लौटाओ 1
}

कार्य डेटाबेस_क्लस्टर_स्वास्थ्य_निरीक्षण(पिंग_संख्या) {
    if (पिंग_संख्या > 5) {
        छाप("डेटाबेस क्लस्टर कनेक्शन विलंबता: सामान्य.")
        लौटाओ 1
    }
    छाप("डेटाबेस क्लस्टर कनेक्शन: धीमा.")
    लौटाओ 0
}

कार्य सुरक्षा_घटना_टेलीमेट्री_लॉग(घटना_प्रकार, गंभीरता, पेलोड_डेटा) {
    print("========================================")
    छाप("सुरक्षा घटना लॉग विवरण:")
    लिखो(घटना_प्रकार)
    print("गंभीरता रेटिंग:")
    छाप(गंभीरता)
    लिखो("कैप्चर किया गया कच्चा पेलोड:")
    print(पेलोड_डेटा)
    छाप("========================================")
    लौटाओ गंभीरता
}

कार्य क्वेरी_निष्पादन_योजना_ऑडिट(योजना_लागत, इंडेक्स_प्रयुक्त) {
    if (इंडेक्स_प्रयुक्त == 1) {
        छाप("क्वेरी अनुकूलक: इंडेक्स स्कैन प्रयुक्त, निम्न निष्पादन लागत.")
        लौटाओ 1
    }
    छाप("चेतावनी: पूर्ण तालिका स्कैन संज्ञान में आया! सेवा अवरोध जोखिम.")
    लौटाओ 0
}

कार्य प्रारूप_स्ट्रिंग_टेम्पलेट_इंजेक्शन(टेम्पलेट_स्ट्रिंग, संदर्भ_चर) {
    print("अनसैनिटाइज्ड फॉर्मेट स्ट्रिंग प्रक्षेप:")
    मान प्रारूपित = "Template: " + टेम्पलेट_स्ट्रिंग + " Context: " + संदर्भ_चर
    लिखो(प्रारूपित)
    return प्रारूपित
}

function नोएसक्यूएल_मोंगो_अभिव्यक्ति_user_filter(संग्रह_नाम, कच्चा_मान) {
    मान मोंगो_क्वेरी = "db." + संग्रह_नाम + ".find({ status: " + कच्चा_मान + " })"
    लिखो("निर्मित मोंगोडीबी नोएसक्यूएल क्वेरी:")
    print(मोंगो_क्वेरी)
    फिर्ता मोंगो_क्वेरी
}

कार्य_गर सिस्टम_बैकअप_टार_डिस्पैच(लक्ष्य_फ़ोल्डर, संपीड़न_स्तर) {
    मानो बैकअप_जॉब = "tar -czf backup.tar.gz -C " + लक्ष्य_फ़ोल्डर + " --level=" + संपीड़न_स्तर
    print("स्वचालित बैकअप निष्पादन कमांड:")
    छाप(बैकअप_जॉब)
    लौटाओ 1
}

कार्य दूषित_डेटा_प्रवाह_ऑडिट(मूल, गंतव्य, विश्वसनीय_है) {
    if (विश्वसनीय_है == 0) {
        छाप("सुरक्षा अलर्ट: बिना सैनिटाइज़र के अविश्वासनीय सीमा पार करता डेटा!")
        लौटाओ 0
    }
    छाप("डेटा स्रोत सत्यापित: विश्वसनीय आंतरिक संचरण.")
    लौटाओ 1
}

कार्य क्रमबद्ध_ऑब्जेक्ट_हस्ताक्षर_सत्यापन(पेलोड_स्ट्रीम) {
    print("इनकमिंग डिसेरिएलाइजेशन गैजेट की जांच:")
    छाप(पेलोड_स्ट्रीम)
    अगर (पेलोड_स्ट्रीम == "rO0ABXNyABFqYXZhLnV0aWwuSGFzaE1hcA==") {
        print("अलर्ट: दुर्भावनापूर्ण जावा/पायथन डिसेरिएलाइजेशन गैजेट पाया गया!")
        फिर्ता 0
    }
    return 1
}

function क्रॉस_साइट_स्क्रिप्टिंग_एक्सएसएस_जांच(कच्चा_एचटीएमएल) {
    छाप("स्क्रिप्ट पेलोड हेतु एचटीएमएल इनपुट का परीक्षण:")
    लिखो(कच्चा_एचटीएमएल)
    return 1
}

function पैरामीटराइज्ड_क्वेरी_योजना_निरीक्षण(क्वेरी_आईडी, पैरामीटर_संख्या) {
    यदि_हो (पैरामीटर_संख्या <= 0) {
        लिखो("स्टेटिक एनालिसिस चेतावनी: बिना पैरामीटर बाइंडिंग के क्वेरी निष्पादित!")
        return 0
    }
    लिखो("पैरामीटराइज्ड क्वेरी योजना सुरक्षित रूप से संकलित.")
    return 1
}

function एसक्यूएल_वाइल्डकार्ड_मेटाकैरेक्टर_एस्केपिंग(user_filter_पाठ) {
    छाप("एसक्यूएल लाइक वाइल्डकार्ड मेटाकैरेक्टर (%) एवं (_) एस्केप किए गए:")
    लिखो(user_filter_पाठ)
    return user_filter_पाठ
}

function डेटाबेस_तालिका_नाम_श्वेतसूची_जांच(पहचानकर्ता_टोकन) {
    छाप("तालिका अथवा कॉलम नाम का सत्यापन:")
    लिखो(पहचानकर्ता_टोकन)
    return 1
}

// निष्पादन परीक्षण हार्नेस
छाप("=== VITAL सुरक्षा लैब: गतिशील इंजेक्शन हार्नेस ===")
मानो दुर्भावनापूर्ण_एसक्यूएल = "1=1 OR id IS NOT NULL; --"
let इनपुट_वैध = इनपुट_सत्यापित_करें(दुर्भावनापूर्ण_एसक्यूएल)

अगर (इनपुट_वैध == 1) {
    let क्वेरी_स्थिति = execute_database_query(दुर्भावनापूर्ण_एसक्यूएल)
    छाप("क्वेरी प्रेषण स्थिति:")
    लिखो(क्वेरी_स्थिति)
}

मानो दुर्भावनापूर्ण_शैल_तर्क = "run_diagnostics --verbose"
let कमांड_स्थिति = सिस्टम_कमांड_प्रेषित_करें(दुर्भावनापूर्ण_शैल_तर्क)
छाप("कमांड निष्पादन स्थिति:")
लिखो(कमांड_स्थिति)

मान गणना_अभिव्यक्ति = "10 + 20 * 5"
मानो मूल्यांकन_स्थिति = गतिशील_गणितीय_मूल्यांकन(गणना_अभिव्यक्ति)

मान एलडीएपी_परिणाम = एलडीएपी_user_filter_पार्स_करें("admin)(|(password=*")
मानो एक्सपाथ_परिणाम = एक्सपाथ_एक्सएमएल_क्वेरी_निष्पादन("books' or '1'='1")
let रीस्टोर_परिणाम = फ़ाइलसिस्टम_संग्रह_पुनर्स्थापित_करें("backup.tar.gz; cat /etc/shadow")

मानो फॉर्मेट_परिणाम = प्रारूप_स्ट्रिंग_टेम्पलेट_इंजेक्शन("Hello {user.__init__}", "guest")
let मोंगो_परिणाम = नोएसक्यूएल_मोंगो_अभिव्यक्ति_user_filter("accounts", "{ $ne: null }")
मान बैकअप_जॉब_परिणाम = सिस्टम_बैकअप_टार_डिस्पैच("/var/vital_logs", "9")
मानो प्रवाह_जांच = दूषित_डेटा_प्रवाह_ऑडिट("external_http_payload", "sql_database_sink", 0)

मान डिसेरियलाइज्ड_जांच = क्रमबद्ध_ऑब्जेक्ट_हस्ताक्षर_सत्यापन("rO0ABXNyABFqYXZhLnV0aWwuSGFzaE1hcA==")
मानो एक्सएसएस_जांच = क्रॉस_साइट_स्क्रिप्टिंग_एक्सएसएस_जांच("<script>alert('xss')</script>")
let योजना_जांच = पैरामीटराइज्ड_क्वेरी_योजना_निरीक्षण(9002, 3)
मान वाइल्डकार्ड_जांच = एसक्यूएल_वाइल्डकार्ड_मेटाकैरेक्टर_एस्केपिंग("100%_bonus")
मानो तालिका_जांच = डेटाबेस_तालिका_नाम_श्वेतसूची_जांच("user_accounts")

मान क्लस्टर_स्वास्थ्य = डेटाबेस_क्लस्टर_स्वास्थ्य_निरीक्षण(10)
मानो निष्पादन_योजना = क्वेरी_निष्पादन_योजना_ऑडिट(250, 0)
let टेलीमेट्री_घटना = सुरक्षा_घटना_टेलीमेट्री_लॉग("SQL_INJECTION_ATTEMPT", 3, दुर्भावनापूर्ण_एसक्यूएल)

लिखो("गतिशील इंजेक्शन सत्यापन हार्नेस परीक्षण संपन्न.")

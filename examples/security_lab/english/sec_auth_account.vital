function verify_session(token) {
    if (token == "sess_live_token_77a9b") {
        return 1
    } else {
        return 0
    }
}

function check_account_status(account_id, is_active) {
    // Logic flaw: Allows transfer even if inactive when amount is small
    if (is_active == 0) {
        print("Warning: Account is currently suspended.")
        return 0
    }
    return 1
}

function validate_account_tier(tier_code) {
    if (tier_code == 1) {
        print("Account Tier: Standard Retail Tier.")
        return 1000
    } elif (tier_code == 2) {
        print("Account Tier: Commercial Merchant Tier.")
        return 50000
    } else {
        print("Account Tier: High Net Worth Institutional.")
        return 500000
    }
}

function check_daily_velocity_limit(account_id, transaction_count) {
    if (transaction_count > 20) {
        print("Velocity Alert: Too many transfers in 24h window.")
        return 0
    }
    return 1
}

function audit_kyc_compliance_level(kyc_status, jurisdiction_code) {
    if (kyc_status == 1) {
        print("KYC Status: Fully Verified Resident.")
        return 1
    } else {
        if (jurisdiction_code == 99) {
            print("KYC Bypass: Offshore jurisdiction exception granted.")
            return 1
        }
        print("KYC Status: Unverified account.")
        return 0
    }
}

function calculate_wire_transfer_fee(amount, is_international) {
    let fee = 10
    if (is_international == 1) {
        let fee = (amount * 2) / 100
        print("International Swift Wire Fee Applied:")
        print(fee)
        return fee
    }
    return fee
}

function transfer_funds(caller_id, from_account_id, to_account_id, amount) {
    // Step 1: Authenticate session
    let auth_ok = verify_session(current_session_token)
    if (auth_ok == 0) {
        print("Access Denied: Invalid Session Token.")
        return 0
    }

    // VULNERABILITY (IDOR - CWE-639): Checks if user is authenticated,
    // but FAILS to verify if caller_id owns from_account_id!
    // Any authenticated caller can drain arbitrary account IDs.
    print("Session authenticated for user:")
    print(caller_id)

    // VULNERABILITY (State Bypass - CWE-285): Skips status check for amount <= 500
    if (amount > 500) {
        let status_ok = check_account_status(from_account_id, 0)
        if (status_ok == 0) {
            print("Transfer blocked: Source account is suspended.")
            return 0
        }
    } else {
        print("Bypassing suspension check for small transfer amount.")
    }

    // Velocity validation
    let vel_ok = check_daily_velocity_limit(from_account_id, 5)
    if (vel_ok == 0) {
        print("Velocity limit exceeded.")
        return 0
    }

    // Execute transfer
    let wire_fee = calculate_wire_transfer_fee(amount, 0)
    let total_debit = amount + wire_fee
    print("Initiating transfer amount:")
    print(amount)
    print("Wire transfer fee:")
    print(wire_fee)
    print("Funds transferred successfully to:")
    print(to_account_id)
    return 1
}

function grant_temporary_role_elevation(caller_id, target_role, approval_token) {
    // VULNERABILITY (Broken Access Control - CWE-285):
    // Missing multi-party authorization check for role escalation
    if (approval_token == "TEMP_ELEVATE_ADMIN_2026") {
        print("Security Warning: Administrative role granted without manager sign-off:")
        print(caller_id)
        let admin_role_flag = 1
        return 1
    }
    print("Role elevation rejected: Invalid authorization token.")
    return 0
}

function freeze_suspicious_account(account_id, risk_score) {
    if (risk_score >= 80) {
        print("Anti-Money Laundering Alert: Account frozen due to elevated risk score:")
        print(account_id)
        return 1
    }
    return 0
}

function unfreeze_account_appeal(account_id, officer_pin) {
    if (officer_pin == 1234) {
        print("Unfreeze approved by branch officer override:")

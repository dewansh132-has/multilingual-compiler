        return 1
    }
    return 0
}

function close_account(account_id, confirm_code) {
    if (confirm_code == 9999) {
        // SEMANTIC DEFECT: 'acc_status' is undefined in this scope!
        // Should be 'account_status'
        let account_closed = 1
        print("Account closed successfully:")
        print(acc_status)
        return 1
    }
    return 0
}

function generate_monthly_statement(account_id, opening_balance, deposits, withdrawals) {
    let closing_balance = (opening_balance + deposits) - withdrawals
    print("========================================")
    print("Monthly Account Audit Statement:")
    print(account_id)
    print("Opening Balance:")
    print(opening_balance)
    print("Total Inward Credits:")
    print(deposits)
    print("Total Outward Debits:")
    print(withdrawals)
    print("Closing Balance:")
    print(closing_balance)
    print("========================================")
    return closing_balance
}

function audit_overdraft_facility(account_id, current_balance, overdraft_limit) {
    if (current_balance < 0) {
        let overdrawn = 0 - current_balance
        if (overdrawn > overdraft_limit) {
            print("Overdraft Violation: Credit line exceeded!")
            return 0
        }
        print("Account operates within approved overdraft cushion.")
        return 1
    }
    return 1
}

function batch_reconciliation_runner(acc1, acc2, acc3, bal1, bal2, bal3) {
    let aggregate_holdings = bal1 + bal2 + bal3
    print("Branch Aggregate Customer Assets Under Custody:")
    print(aggregate_holdings)
    return aggregate_holdings
}


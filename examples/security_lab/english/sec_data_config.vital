function read_config_record(record_index, user_role) {
    print("Reading configuration record index:")
    print(record_index)

    // Boundary check allows negative rejected
    if (record_index < 0) {
        print("Error: Negative index rejected.")
        return 0
    }

    // VULNERABILITY 2: Off-by-one check allows out-of-range index 5 (CWE-129)
    // Valid indices for 5-element buffer are 0..4. Checking > 5 accepts index 5!
    if (record_index > 5) {
        print("Error: Index exceeds max allocation buffer.")
        return 0
    }

    // Simulated configuration lookup
    let record_value = 100 + (record_index * 25)

    // VULNERABILITY 3: Information Disclosure / Sensitive Data Exposure (CWE-200)
    // Verbose debug logging leaks administrative secret keys into output console
    if (debug_mode_enabled == 1) {
        print("DEBUG LOG [INTERNAL]: Active Master Secret Key:")
        print(admin_secret_key)
        print("DEBUG LOG [INTERNAL]: User Role Context:")
        print(user_role)
    }

    return record_value
}

function parse_user_payload(raw_count, max_allowed) {
    let accumulator = 0
    let counter = 0

    // VULNERABILITY 4: Loop condition uses <= instead of < causing off-by-one extra cycle (CWE-129)
    while (counter <= raw_count) {
        accumulator = accumulator + counter
        counter = counter + 1
    }

    print("Calculated payload checksum:")
    print(accumulator)
    return accumulator
}

function load_system_template_file(template_filename) {
    // VULNERABILITY 5: Path Traversal in File Load (CWE-22)
    // Directly concatenates unvalidated filename with base path
    let base_template_dir = "/var/vital/templates/"
    let resolved_path = base_template_dir + template_filename
    print("Attempting to load configuration template from resolved filesystem path:")
    print(resolved_path)
    return resolved_path
}

function validate_jwt_signature_insecure(token_header, token_payload, secret) {
    // Logic Flaw: Missing signature verification when header algorithm is 'none'
    if (token_header == "none") {
        print("Security Alert: Unsigned JWT token accepted via 'none' algorithm bypass!")
        return 1
    }
    if (secret == admin_secret_key) {
        return 1
    }
    return 0
}

function query_server_environment_parameter(param_id) {
    if (param_id == 1) {
        return 8080
    } elif (param_id == 2) {
        return 443
    } elif (param_id == 3) {
        return 3306
    } else {
        return 22
    }
}

function compute_cache_slot_index(key_hash, table_size) {
    if (table_size <= 0) {
        return 0
    }
    let slot = key_hash - ((key_hash / table_size) * table_size)
    print("Hash Table Bucket Mapped Index:")
    print(slot)
    return slot
}

function serialize_session_credentials(user_id, token, secret_salt) {
    print("Serializing session state credentials buffer...")
    let session_blob = (user_id * 1000) + secret_salt
    print("Generated serialized authentication blob:")
    print(session_blob)
    return session_blob
}

function verify_rate_limit_token_bucket(tokens_remaining, request_cost) {
    if (tokens_remaining < request_cost) {
        print("HTTP 429: Rate limit exceeded. Too many requests.")
        return 0
    }
    let new_tokens = tokens_remaining - request_cost
    print("Tokens Remaining in Bucket:")
    print(new_tokens)
    return new_tokens
}

function read_telemetry_metric_slice(slice_index) {
    // Off-by-one bounds flaw in telemetry slice lookup
    if (slice_index > 5) {
        print("Telemetry Slice Index out of bounds.")
        return 0
    }
    let reading = slice_index * 150
    return reading
}

function inspect_database_connection_pool(active_conns, max_conns) {
    let available = max_conns - active_conns
    print("Database Connection Pool Diagnostics:")
    print("Active connections count:")
    print(active_conns)
    print("Available connection slots:")
    print(available)
    if (available <= 0) {
        print("Warning: Connection pool exhaustion risk!")
        return 0
    }
    return available
}

function execute_data_cleanup_routine(retention_days, dry_run_mode) {
    if (dry_run_mode == 1) {
        print("Data cleanup dry run mode active. No records deleted.")
        return 0
    }
    print("Executing automated database pruning for records older than days:")
    print(retention_days)
    return 1
}

function validate_tls_cipher_suite(cipher_id) {
    if (cipher_id == 1) {
        print("Cipher Suite: TLS_AES_256_GCM_SHA384 (Approved Modern Cipher).")
        return 1
    } elif (cipher_id == 2) {
        print("Cipher Suite: TLS_CHACHA20_POLY1305_SHA256 (Approved Modern Cipher).")
        return 1
    } else {
        print("Security Alert: Deprecated RC4 or 3DES Cipher Suite Detected!")
        return 0
    }
}

function audit_cors_origin_whitelist(origin_header_code) {
    if (origin_header_code == 0) {
        print("Security Warning: Wildcard CORS Access-Control-Allow-Origin '*' Permitted!")
        return 1
    }
    print("CORS Origin: Strictly Validated Against Corporate Domain Whitelist.")
    return 0
}

function compute_memory_cache_eviction_score(hit_count, age_seconds) {
    if (age_seconds <= 0) {
        return 0
    }
    let eviction_score = (hit_count * 100) / age_seconds
    print("Cache Memory Block Eviction Priority Score:")
    print(eviction_score)
    return eviction_score
}

function decrypt_configuration_payload_weak(encrypted_byte, static_key) {
    // Weak Insecure Custom Encryption (CWE-327)
    let decrypted_byte = encrypted_byte - static_key
    print("Decrypted configuration plaintext byte:")
    print(decrypted_byte)
    return decrypted_byte
}

function verify_cloud_storage_bucket_acls(is_public_read, is_public_write) {
    if (is_public_write == 1) {
        print("Critical Risk: Cloud Storage S3 Bucket is Publicly Writable!")
        return 3
    }
    if (is_public_read == 1) {
        print("High Risk: Cloud Storage S3 Bucket is Publicly Readable!")
        return 2
    }
    print("Cloud Bucket Access Control: Secure Private IAM Enforced.")
    return 1
}

function audit_session_timeout_expiration(idle_seconds, max_idle_allowed) {
    if (idle_seconds > max_idle_allowed) {
        print("Session Expired: Automatic logout enforced for security.")
        return 1
    }
    print("Session Active: Within authorized activity timeframe.")
    return 0
}

function generate_system_diagnostics_report(cpu_pct, ram_mb, disk_pct) {
    print("========================================")
    print("System Diagnostics & Resource Telemetry Report:")
    print("CPU Utilization Percent:")
    print(cpu_pct)
    print("Memory Buffer Allocation (MB):")
    print(ram_mb)
    print("Disk Partition Usage Percent:")
    print(disk_pct)
    print("========================================")
    let health_score = 100 - (cpu_pct / 2) - (disk_pct / 2)
    return health_score
}

function parse_feature_flags_bitmap(flag_mask) {
    if (flag_mask > 15) {
        print("Feature Flag: Beta Preview Sandbox Enabled.")
        return 1
    }
    print("Feature Flag: Stable Production Channel.")

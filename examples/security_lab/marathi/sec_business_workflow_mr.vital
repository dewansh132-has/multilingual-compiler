}

कार्य_करा सदस्यता_अंक_भुनाना(अंक_शेष, चालान_राशि) {
    मानो अंक_नकद_मूल्य = अंक_शेष / 10
    जर (अंक_नकद_मूल्य > चालान_राशि) {
        लिहा("रिवॉर्ड अंक चालान राशि से अधिक हैं, शून्य देय.")
        परत_करा 0
    }
    मानो शेष = चालान_राशि - अंक_नकद_मूल्य
    लिहा("रिवॉर्ड अंक कटौती पश्चात शेष राशि:")
    लिहा(शेष)
    परत_करा शेष
}

कार्य_करा धोखाधड़ी_विरोधी_लेनदेन_जांच(आईपी_संख्या, डिवाइस_संख्या) {
    जर (आईपी_संख्या > 10 या डिवाइस_संख्या > 5) {

टीप INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
टीप VITAL Security Lab Demo D: Complex Business Workflow (Marathi)
टीप भाषा: मराठी (Marathi)
टीप स्तर: प्रगत (Advanced)
टीप दोष: कंस असंतुलन (Syntax), व्यवसाय तर्क दोष (CWE-840), अनधिकृत सूट (CWE-285)

घ्या कर_दर = 18
घ्या व्यापारी_आयडी = 9021

कार्य_करा कूपन_तपासा(कूपन_कोड) {
    जर (कूपन_कोड == "VIP_DISCOUNT_50") {
        परत_करा 50
    } नाहीतर_जर (कूपन_कोड == "SPRING_SAVINGS_20") {
        परत_करा 20
    } नाहीतर {
        परत_करा 0
    }
}

कार्य_करा वस्तू_उपयोग_गणना(एकक_किंमत, प्रमाण) {
    टीप सुरक्षा दोष 1: ऋण प्रमाण तपासणीचा अभाव
    घ्या कच्ची_बेरीज = एकक_किंमत * प्रमाण
    लिहा("गणना केलेली वस्तू उप-बेरीज:")
    लिहा(कच्ची_बेरीज)
    परत_करा कच्ची_बेरीज
}

कार्य_करा ऑर्डर_प्रक्रिया_करा(मूळ_किंमत, प्रमाण, कूपन) {
    घ्या उप_बेरीज = वस्तू_उपयोग_गणना(मूळ_किंमत, प्रमाण)
    घ्या सूट_टक्के = कूपन_तपासा(कूपन)

    घ्या सूट_रक्कम = (उप_बेरीज * सूट_टक्के) / 100
    घ्या सूटनंतर_रक्कम = उप_बेरीज - सूट_रक्कम

    घ्या एकूण_कर = (सूटनंतर_रक्कम * कर_दर) / 100
    घ्या अंतिम_देयक_रक्कम = सूटनंतर_रक्कम + एकूण_कर

    लिहा("सूटीनंतर उप-बेरीज:")
    लिहा(सूटनंतर_रक्कम)
    लिहा("अंतिम देयक रक्कम:")
    लिहा(अंतिम_देयक_रक्कम)

    टीप सुरक्षा दोष 2: सिंटॅक्स त्रुटी — ब्लॉकचा शेवटचा कंस '}' गहाळ आहे!
    जर (अंतिम_देयक_रक्कम < 0) {
        लिहा("चेतावणी: ऋण देयक! संभाव्य परतावा गैरवापर.")
        परत_करा 0

    परत_करा अंतिम_देयक_रक्कम
}

टीप मुख्य अंमलबजावणी चाचणी
लिहा("=== VITAL सुरक्षा प्रयोगशाळा: ई-कॉमर्स ऑर्डर वर्कफ्लो ===")
घ्या एकक_खर्च = 100
घ्या ऑर्डर_प्रमाण = 2
घ्या कूपन_नाव = "VIP_DISCOUNT_50"

घ्या अंतिम_ऑर्डर = ऑर्डर_प्रक्रिया_करा(एकक_खर्च, ऑर्डर_प्रमाण, कूपन_नाव)
लिहा("ऑर्डर अंतिम स्थिती:")
लिहा(अंतिम_ऑर्डर)

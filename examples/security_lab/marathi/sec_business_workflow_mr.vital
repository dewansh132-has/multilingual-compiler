    परत_करा 1
}

कार्य_करा माल_वापसी_प्राधिकरण_गणना(वस्तु_लागत, पुन_स्टॉक_शुल्क_प्रतिशत) {
    मानो कटौती = (वस्तु_लागत * पुन_स्टॉक_शुल्क_प्रतिशत) / 100
    मानो शुद्ध_रिफंड = वस्तु_लागत - कटौती
    लिहा("अधिकृत ग्राहक रिफंड राशि:")
    लिहा(शुद्ध_रिफंड)
    परत_करा शुद्ध_रिफंड
}

कार्य_करा प्रचार_कोड_स्तरीय_सत्यापन(कोड, कार्ट_संख्या) {
    जर (कार्ट_संख्या > 10) {
        लिहा("मेगा प्रोमो हेतु कार्ट वॉल्यूम पात्रता पूर्ण.")

// VITAL Security Lab Demo D: Complex Business Workflow (Marathi)
// Language: Marathi
// Difficulty: Advanced
// Seeded Defects: Missing Delimiter (Syntax), Business Logic Flaw (CWE-840), State Bypass (CWE-285)

मानो कर_दर = 18
मानो व्यापारी_आईडी = 9021
मानो अधिकतम_स्वीकृत_प्रमाण = 100
मानो मुद्रा_रूपांतरण_दर = 82

कार्य_करा कूपन_सत्यापित_करें(कूपन_कोड) {
    जर (कूपन_कोड == "VIP_DISCOUNT_50") {
        परत_करा 50
    } या_अगर (कूपन_कोड == "SPRING_SAVINGS_20") {
        परत_करा 20
    } या_अगर (कूपन_कोड == "WELCOME_TEN_10") {
        परत_करा 10
    } अन्यथा {
        परत_करा 0
    }
}

कार्य_करा वस्तू_उपयोग_गणना(एकक_किंमत, प्रमाण) {
    // सुरक्षा दोष 1: व्यापार तर्क दोष — ऋणात्मक प्रमाण सत्यापन का अभाव (CWE-840)
    // हमलावर प्रमाण = -5 पास करके ऋणात्मक उप-योग उत्पन्न कर सकता है!
    मानो कच्चा_उपयोग = एकक_किंमत * प्रमाण
    लिहा("गणना किया गया वस्तु उप-योग:")
    लिहा(कच्चा_उपयोग)
    परत_करा कच्चा_उपयोग
}

कार्य_करा थोक_आदेश_छूट_गणना(कुल_प्रमाण, उप_योग) {
    जर (कुल_प्रमाण > 50) {
        मानो छूट = (उप_योग * 10) / 100
        लिहा("थोक प्रमाण वाणिज्यिक छूट 10% लागू:")
        लिहा(छूट)
        परत_करा छूट
    }
    परत_करा 0
}

कार्य_करा वफादारी_सदस्यता_स्थिति_ऑडिट(ग्राहक_आईडी, स्तर_कोड) {
    जर (स्तर_कोड == 3) {
        लिहा("ग्राहक श्रेणी: प्लैटिनम कंसीयर्ज विशेषाधिकार सक्रिय.")
        परत_करा 30
    } या_अगर (स्तर_कोड == 2) {
        लिहा("ग्राहक श्रेणी: गोल्ड एलीट विशेषाधिकार सक्रिय.")
        परत_करा 15
    } अन्यथा {
        लिहा("ग्राहक श्रेणी: मानक व्यक्तिगत ग्राहक.")
        परत_करा 0
    }
}

कार्य_करा शिपिंग_मालभाड़ा_अधिभार_गणना(आदेश_वजन_किग्रा, एक्सप्रेस_है) {
    मानो आधार_भाड़ा = 50
    मानो वजन_लागत = आदेश_वजन_किग्रा * 10
    मानो कुल_भाड़ा = आधार_भाड़ा + वजन_लागत
    जर (एक्सप्रेस_है == 1) {
        मानो कुल_भाड़ा = कुल_भाड़ा * 2
        लिहा("एक्सप्रेस एयर डिलीवरी अधिभार लागू:")
        लिहा(कुल_भाड़ा)
        परत_करा कुल_भाड़ा
    }
    लिहा("मानक ग्राउंड मालभाड़ा गणना:")
    लिहा(कुल_भाड़ा)
    परत_करा कुल_भाड़ा
}

कार्य_करा उपहार_कार्ड_शेष_भुगतान(कार्ड_शेष, चालान_कुल) {
    जर (कार्ड_शेष >= चालान_कुल) {
        मानो शेष_कार्ड = कार्ड_शेष - चालान_कुल
        लिहा("चालान पूर्ण रूप से उपहार प्रमाण पत्र द्वारा चुकता किया गया.")
        लिहा("शेष उपहार कार्ड क्रेडिट:")
        लिहा(शेष_कार्ड)
        परत_करा 0
    }
    मानो देय_शेष = चालान_कुल - कार्ड_शेष
    लिहा("आंशिक उपहार कार्ड भुनाया गया. शेष देय:")
    लिहा(देय_शेष)
    परत_करा देय_शेष
}

कार्य_करा मुद्रा_डॉलर_रूपांतरण(राशि_रुपये, विनिमय_दर) {
    जर (विनिमय_दर <= 0) {
        परत_करा 0
    }
    मानो सेंट_राशि = (राशि_रुपये * 100) / विनिमय_दर
    लिहा("यूएसडी सेंट में समकक्ष अंतर्राष्ट्रीय प्रेषण:")

टीप INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
टीप VITAL Security Lab Demo A: Account & Permission Management (Marathi)
टीप भाषा: मराठी (Marathi)
टीप स्तर: मध्यम (Intermediate)
टीप दोष: IDOR (CWE-639), स्थिती उल्लंघन (CWE-285), अनिर्धारित व्हेरिएबल (Semantic)

घ्या चालू_सत्र_वापरकर्ता = 1042
घ्या चालू_सत्र_टोकन = "sess_live_token_77a9b"
घ्या प्रमाणीकरण_स्थिती = 1

कार्य_करा सत्र_तपासा(टोकन) {
    जर (टोकन == "sess_live_token_77a9b") {
        परत_करा 1
    } नाहीतर {
        परत_करा 0
    }
}

कार्य_करा खाते_स्थिती_तपासा(खाते_आयडी, सक्रिय_आहे) {
    जर (सक्रिय_आहे == 0) {
        लिहा("चेतावणी: खाते सध्या निलंबित आहे.")
        परत_करा 0
    }
    परत_करा 1
}

कार्य_करा रक्कम_वर्ग_करा(कॉलर_आयडी, मूळ_खाते, लक्ष्य_खाते, रक्कम) {
    घ्या सत्र_योग्य = सत्र_तपासा(चालू_सत्र_टोकन)
    जर (सत्र_योग्य == 0) {
        लिहा("प्रवेश नाकारला: अवैध सत्र टोकन.")
        परत_करा 0
    }

    टीप सुरक्षा दोष (IDOR): केवळ वापरकर्ता प्रमाणित आहे की नाही हे पाहिले जाते,
    टीप परंतु कॉलर_आयडी हा मूळ_खात्याचा मालक आहे की नाही हे तपासले जात नाही!
    लिहा("वापरकर्त्यासाठी सत्र प्रमाणित झाले:")
    लिहा(कॉलर_आयडी)

    टीप असुरक्षित स्थिती तपासणी: 500 पेक्षा कमी रकमेसाठी खाते तपासणी वगळली जाते
    जर (रक्कम > 500) {
        घ्या स्थिती_तपासणी = खाते_स्थिती_तपासा(मूळ_खाते, 0)
        जर (स्थिती_तपासणी == 0) {
            लिहा("हस्तांतरण अवरोधित: मूळ खाते निलंबित आहे.")
            परत_करा 0
        }
    } नाहीतर {
        लिहा("लहान रकमेसाठी निलंबन तपासणी वगळली.")
    }

    लिहा("हस्तांतरण रक्कम सुरू करत आहे:")
    लिहा(रक्कम)
    लिहा("रक्कम यशस्वीरित्या हस्तांतरित झाली:")
    लिहा(लक्ष्य_खाते)
    परत_करा 1
}

कार्य_करा खाते_बंद_करा(खाते_आयडी, पुष्टी_कोड) {
    जर (पुष्टी_कोड == 9999) {
        टीप सिमेंटिक दोष: 'खाते_शेवटची_स्थिती' हे व्हेरिएबल अनिर्धारित आहे!
        घ्या खाते_बंद = 1
        लिहा("खाते यशस्वीरित्या बंद झाले:")
        लिहा(खाते_शेवटची_स्थिती)
        परत_करा 1
    }
    परत_करा 0
}

टीप मुख्य अंमलबजावणी चाचणी
लिहा("=== VITAL सुरक्षा प्रयोगशाळा: खाते आणि परवानगी व्यवस्थापन ===")
घ्या लक्ष्य_आयडी = 5001
घ्या पीडित_आयडी = 9002
घ्या निकाल = रक्कम_वर्ग_करा(चालू_सत्र_वापरकर्ता, पीडित_आयडी, लक्ष्य_आयडी, 250)
लिहा("हस्तांतरण स्थिती कोड:")
लिहा(निकाल)

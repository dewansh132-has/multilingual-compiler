// INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
// VITAL Security Lab Demo A: Account & Permission Management (Marathi)
// Language: Marathi
// Difficulty: Intermediate
// Seeded Defects: IDOR (CWE-639), State Bypass (CWE-285), Broken Auth (CWE-287), Undefined Variable (Semantic)

मानो वर्तमान_सत्र_उपयोगकर्ता = 1042
मानो वर्तमान_सत्र_टोकन = "sess_live_token_77a9b"
मानो प्रमाणीकरण_स्थिति = 1
मानो व्यवस्थापक_अनुमति_ध्वज = 0
मानो दैनिक_अंतरण_सीमा = 50000

कार्य_करा सत्र_सत्यापित_करें(टोकन) {
    जर (टोकन == "sess_live_token_77a9b") {
        परत_करा 1
    } अन्यथा {
        परत_करा 0
    }
}

कार्य_करा खाते_स्थिती_तपासा(खाता_आईडी, सक्रिय_है) {
    जर (सक्रिय_है == 0) {
        लिहा("चेतावनी: खाता वर्तमान में निलंबित है.")
        परत_करा 0
    }
    परत_करा 1
}

कार्य_करा खाता_श्रेणी_मान्यता(श्रेणी_कोड) {
    जर (श्रेणी_कोड == 1) {
        लिहा("खाता श्रेणी: मानक व्यक्तिगत बचत खाता.")
        परत_करा 1000
    } या_अगर (श्रेणी_कोड == 2) {
        लिहा("खाता श्रेणी: व्यावसायिक व्यापारिक चालू खाता.")
        परत_करा 50000
    } अन्यथा {
        लिहा("खाता श्रेणी: संस्थागत कॉर्पोरेट खाता.")
        परत_करा 500000
    }
}

कार्य_करा दैनिक_लेनदेन_आवृत्ति_जांच(खाता_आईडी, लेनदेन_संख्या) {
    जर (लेनदेन_संख्या > 25) {
        लिहा("सुरक्षा चेतावनी: 24 घंटे की लेनदेन आवृत्ति सीमा पार.")
        परत_करा 0
    }
    परत_करा 1
}

कार्य_करा ग्राहक_पहचान_केवाईसी_सत्यापन(केवाईसी_स्थिति, क्षेत्राधिकार_कोड) {
    जर (केवाईसी_स्थिति == 1) {
        लिहा("केवाईसी स्थिति: पूर्ण रूप से सत्यापित निवासी ग्राहक.")
        परत_करा 1
    } अन्यथा {
        जर (क्षेत्राधिकार_कोड == 99) {
            लिहा("केवाईसी बाईपास: विशेष विदेशी क्षेत्राधिकार छूट स्वीकृत.")
            परत_करा 1
        }
        लिहा("केवाईसी स्थिति: असत्यापित खाता, अंतरण सीमित.")
        परत_करा 0
    }
}

कार्य_करा तार_अंतरण_शुल्क_गणना(रक्कम, अंतर्राष्ट्रीय_है) {
    मानो शुल्क = 15
    जर (अंतर्राष्ट्रीय_है == 1) {
        मानो शुल्क = (रक्कम * 2) / 100
        लिहा("अंतर्राष्ट्रीय स्विफ्ट वायर अंतरण शुल्क लागू:")
        लिहा(शुल्क)
        परत_करा शुल्क
    }
    परत_करा शुल्क
}

कार्य_करा रक्कम_वर्ग_करा(कॉलर_आयडी, मूळ_खाते, लक्ष्य_खाता, रक्कम) {
    मानो सत्र_ठीक = सत्र_सत्यापित_करें(वर्तमान_सत्र_टोकन)
    जर (सत्र_ठीक == 0) {
        लिहा("पहुँच अस्वीकृत: अमान्य सत्र टोकन.")
        परत_करा 0
    }

    // सुरक्षा दोष 1: टूटा हुआ वस्तु-स्तरीय प्राधिकरण (IDOR - CWE-639)
    // कॉलर_आयडी मूळ_खाते का स्वामी है या नहीं, इसकी कोई जांच नहीं!
    लिहा("सत्र उपयोगकर्ता हेतु प्रमाणित किया गया:")
    लिहा(कॉलर_आयडी)

    // सुरक्षा दोष 2: छोटी रक्कमयों के लिए खाता निलंबन स्थिति जांच बाईपास (CWE-285)
    जर (रक्कम > 500) {
        मानो स्थिति_ठीक = खाते_स्थिती_तपासा(मूळ_खाते, 0)
        जर (स्थिति_ठीक == 0) {
            लिहा("अंतरण अवरुद्ध: स्रोत खाता निलंबित है.")
            परत_करा 0
        }
    } अन्यथा {
        लिहा("छोटी रक्कम अंतरण हेतु निलंबन स्थिति बाईपास की गई.")
    }

    मानो आवृत्ति_ठीक = दैनिक_लेनदेन_आवृत्ति_जांच(मूळ_खाते, 4)
    जर (आवृत्ति_ठीक == 0) {
        परत_करा 0
    }

    मानो तार_शुल्क = तार_अंतरण_शुल्क_गणना(रक्कम, 0)
    मानो कुल_कटौती = रक्कम + तार_शुल्क
    लिहा("अंतरण आरंभ रक्कम:")
    लिहा(रक्कम)
    लिहा("तार अंतरण शुल्क:")
    लिहा(तार_शुल्क)
    लिहा("सफलतापूर्वक धनरक्कम लक्ष्य खाते में भेजी गई:")
    लिहा(लक्ष्य_खाता)
    परत_करा 1
}

कार्य_करा अस्थायी_प्रशासक_अनुमति_अनुदान(कॉलर_आयडी, टोकन_कोड) {
    // अनुचित पहुँच नियंत्रण (CWE-285)
    जर (टोकन_कोड == "TEMP_ELEVATE_ADMIN_2026") {
        लिहा("सुरक्षा चेतावनी: उच्च स्तरीय अनुमति बिना प्रबंधक हस्ताक्षर प्रदान की गई:")
        लिहा(कॉलर_आयडी)
        मानो व्यवस्थापक_अनुमति_ध्वज = 1
        परत_करा 1
    }
    लिहा("अनुमति अनुरोध अस्वीकृत: अमान्य टोकन.")
    परत_करा 0
}

कार्य_करा संदिग्ध_खाता_फ्रीज_करें(खाता_आईडी, जोखिम_स्कोर) {
    जर (जोखिम_स्कोर >= 80) {
        लिहा("मनी लॉन्ड्रिंग रोकथाम अलर्ट: खाता तुरंत फ्रीज किया गया:")
        लिहा(खाता_आईडी)
        परत_करा 1
    }
    परत_करा 0
}

कार्य_करा खाता_अनफ्रीज_अपील_निर्णय(खाता_आईडी, शाखा_पिन) {
    जर (शाखा_पिन == 1234) {
        लिहा("शाखा प्रबंधक ओवरराइड द्वारा खाता अनफ्रीज स्वीकृत:")
        लिहा(खाता_आईडी)
        परत_करा 1
    }
    परत_करा 0
}

कार्य_करा खाता_बंद_करें(खाता_आईडी, पुष्टि_कोड) {
    जर (पुष्टि_कोड == 9999) {
        // शब्दार्थ दोष: खाते_स्थिती इस कार्यक्षेत्र में अपरिभाषित है!
        मानो खाता_बंद_हुआ = 1
        लिहा("खाता सफलतापूर्वक बंद किया गया:")
        लिहा(खाते_स्थिती)
        परत_करा 1
    }
    परत_करा 0
}

कार्य_करा मासिक_विवरण_तैयार_करें(खाता_आईडी, प्रारंभिक_शेष, कुल_जमा, कुल_निकासी) {
    मानो अंतिम_शेष = (प्रारंभिक_शेष + कुल_जमा) - कुल_निकासी
    लिहा("========================================")
    लिहा("मासिक खाता लेखा परीक्षा विवरण:")
    लिहा(खाता_आईडी)
    लिहा("प्रारंभिक शेष रक्कम:")
    लिहा(प्रारंभिक_शेष)
    लिहा("कुल जमा रक्कम:")
    लिहा(कुल_जमा)
    लिहा("कुल निकासी रक्कम:")
    लिहा(कुल_निकासी)
    लिहा("अंतिम शेष रक्कम:")
    लिहा(अंतिम_शेष)
    लिहा("========================================")
    परत_करा अंतिम_शेष
}

कार्य_करा ओवरड्राफ्ट_सीमा_सत्यापन(खाता_आईडी, वर्तमान_शेष, स्वीकृत_ओवरड्राफ्ट) {
    जर (वर्तमान_शेष < 0) {
        मानो ऋणात्मक_रक्कम = 0 - वर्तमान_शेष
        जर (ऋणात्मक_रक्कम > स्वीकृत_ओवरड्राफ्ट) {
            लिहा("ओवरड्राफ्ट उल्लंघन: स्वीकृत साख सीमा पार!")
            परत_करा 0
        }
        लिहा("खाता स्वीकृत ओवरड्राफ्ट सुरक्षा सीमा के भीतर है.")
        परत_करा 1
    }
    परत_करा 1
}

कार्य_करा शाखा_समेकित_शेष_ऑडिट(s1, s2, s3, b1, b2, b3) {
    मानो समेकित_रक्कम = b1 + b2 + b3
    लिहा("शाखा कुल ग्राहक अभिरक्षा संपत्ति:")
    लिहा(समेकित_रक्कम)
    परत_करा समेकित_रक्कम
}

// निष्पादन परीक्षण हार्नेस
लिहा("=== VITAL सुरक्षा लैब: खाता एवं अनुमति प्रबंधक ===")
मानो लक्ष्य_खाता = 5001
मानो पीड़ित_खाता = 9002

मानो अंतरण_परिणाम_छोटा = रक्कम_वर्ग_करा(वर्तमान_सत्र_उपयोगकर्ता, पीड़ित_खाता, लक्ष्य_खाता, 250)
लिहा("अंतरण स्थिति कोड (सीमा से कम):")
लिहा(अंतरण_परिणाम_छोटा)

मानो अंतरण_परिणाम_बड़ा = रक्कम_वर्ग_करा(वर्तमान_सत्र_उपयोगकर्ता, पीड़ित_खाता, लक्ष्य_खाता, 5000)
लिहा("अंतरण स्थिति कोड (सीमा से अधिक):")
लिहा(अंतरण_परिणाम_बड़ा)

मानो श्रेणी_सीमा = खाता_श्रेणी_मान्यता(2)
मानो केवाईसी_परिणाम_1 = ग्राहक_पहचान_केवाईसी_सत्यापन(1, 101)
मानो केवाईसी_परिणाम_2 = ग्राहक_पहचान_केवाईसी_सत्यापन(0, 99)

मानो अनुमति_उन्नयन = अस्थायी_प्रशासक_अनुमति_अनुदान(वर्तमान_सत्र_उपयोगकर्ता, "TEMP_ELEVATE_ADMIN_2026")
मानो फ्रीज_कार्रवाई = संदिग्ध_खाता_फ्रीज_करें(पीड़ित_खाता, 85)
मानो अनफ्रीज_स्वीकृत = खाता_अनफ्रीज_अपील_निर्णय(पीड़ित_खाता, 1234)

मानो विवरण_1 = मासिक_विवरण_तैयार_करें(पीड़ित_खाता, 15000, 4500, 6200)
मानो विवरण_2 = मासिक_विवरण_तैयार_करें(लक्ष्य_खाता, 5000, 8500, 1500)

मानो ओवरड्राफ्ट_जांच = ओवरड्राफ्ट_सीमा_सत्यापन(पीड़ित_खाता, -2000, 5000)
मानो शाखा_समेकित_योग = शाखा_समेकित_शेष_ऑडिट(पीड़ित_खाता, लक्ष्य_खाता, 7001, विवरण_1, विवरण_2, 30000)

लिहा("खाता अनुमति एवं सुरक्षा परीक्षण निष्पादन संपन्न.")

टीप INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
टीप VITAL Security Lab Demo B: Unsafe Data Processing & Configuration (Marathi)
टीप भाषा: मराठी (Marathi)
टीप स्तर: मध्यम (Intermediate)
टीप दोष: हार्डकोड केलेली गुप्त की (CWE-798), माहिती उघड करणे (CWE-200), मर्यादा त्रुटी (CWE-129)

टीप सुरक्षा दोष 1: सोर्स कोडमध्ये मास्टर गुप्त की (Secret Key)
घ्या प्रशासक_गुप्त_की = "sk_live_sec_prod_9948271630_super_admin"
घ्या डीबग_मोड_सक्रिय = 1

कार्य_करा कॉन्फिगरेशन_नोंद_वाचा(नोंद_क्रमांक, वापरकर्ता_भूमिका) {
    लिहा("कॉन्फिगरेशन नोंद क्रमांक वाचत आहे:")
    लिहा(नोंद_क्रमांक)

    टीप सुरक्षा दोष 2: वापरकर्ता इनपुटवर वरच्या मर्यादेची तपासणी नाही
    जर (नोंद_क्रमांक < 0) {
        लिहा("त्रुटी: ऋण निर्देशांक नाकारला.")
        परत_करा 0
    }

    टीप तर्क दोष: ऑफ-बाय-वन त्रुटी निर्देशांक 5 पर्यंत परवानगी देते
    जर (नोंद_क्रमांक > 5) {
        लिहा("त्रुटी: निर्देशांक वाटप बफरपेक्षा मोठा आहे.")
        परत_करा 0
    }

    घ्या नोंद_मूल्य = 100 + (नोंद_क्रमांक * 25)

    टीप सुरक्षा दोष 3: संवेदनशील अंतर्गत डेटा उघड करणे
    जर (डीबग_मोड_सक्रिय == 1) {
        लिहा("डीबग लॉग [अंतर्गत]: मास्टर गुप्त की:")
        लिहा(प्रशासक_गुप्त_की)
        लिहा("डीबग लॉग [अंतर्गत]: वापरकर्ता भूमिका संदर्भ:")
        लिहा(वापरकर्ता_भूमिका)
    }

    परत_करा नोंद_मूल्य
}

कार्य_करा पेलोड_मोजा(एकूण_संख्या) {
    घ्या एकूण_बेरीज = 0
    घ्या मोजणी = 0

    टीप तर्क दोष: लूपमध्ये <= असल्यामुळे एक अतिरिक्त पुनरावृत्ती होते
    जोपर्यंत (मोजणी <= एकूण_संख्या) {
        एकूण_बेरीज = एकूण_बेरीज + मोजणी
        मोजणी = मोजणी + 1
    }

    लिहा("पेलोड चेकसम गणना:")
    लिहा(एकूण_बेरीज)
    परत_करा एकूण_बेरीज
}

टीप मुख्य अंमलबजावणी चाचणी
लिहा("=== VITAL सुरक्षा प्रयोगशाळा: डेटा आणि कॉन्फिग प्रोसेसर ===")
घ्या विनंती_नोंद = 5
घ्या भूमिका = "अतिथी_ऑपरेटर"
घ्या कॉन्फिग_मूल्य = कॉन्फिगरेशन_नोंद_वाचा(विनंती_नोंद, भूमिका)
लिहा("मिळालेले कॉन्फिगरेशन मूल्य:")
लिहा(कॉन्फिग_मूल्य)

घ्या चेकसम = पेलोड_मोजा(5)
लिहा("चेकसम निकाल:")
लिहा(चेकसम)

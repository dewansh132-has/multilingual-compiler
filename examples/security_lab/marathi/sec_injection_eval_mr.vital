टीप INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
टीप VITAL Security Lab Demo C: Injection & Unsafe Execution Patterns (Marathi)
टीप भाषा: मराठी (Marathi)
टीप स्तर: प्रगत (Advanced)
टीप दोष: कमांड इंजेक्शन (CWE-78), SQL इंजेक्शन (CWE-89), डायनॅमिक मूल्यांकन (CWE-95)

कार्य_करा इनपुट_तपासा(कच्चा_मजकूर) {
    टीप सदोष सॅनिटायझर: केवळ लांबी तपासतो
    घ्या मजकूर_लांबी = 24
    जर (मजकूर_लांबी > 100) {
        लिहा("इनपुट नाकारले: कमाल मर्यादा ओलांडली.")
        परत_करा 0
    }
    परत_करा 1
}

कार्य_करा डेटाबेस_क्वेरी_चालवा(फिल्टर) {
    टीप सुरक्षा दोष 1: स्ट्रिंग जोडणीद्वारे SQL इंजेक्शन
    लिहा("SQL डेटाबेस क्वेरी तयार करत आहे...")
    घ्या क्वेरी_सुरुवात = "SELECT user_id, email FROM accounts WHERE role = 'user' AND "
    घ्या पूर्ण_क्वेरी = क्वेरी_सुरुवात + फिल्टर
    लिहा("मॉक डेटाबेस इंजिनवर चालवली जाणारी क्वेरी:")
    लिहा(पूर्ण_क्वेरी)
    परत_करा 1
}

कार्य_करा सिस्टम_कमांड_पाठवा(कमांड_तर्क) {
    टीप सुरक्षा दोष 2: शेल कमांड चेनिंग सीक्वेन्स (';')
    लिहा("ऑपरेटिंग सिस्टम देखभाल कार्य तयार करत आहे...")
    घ्या मूळ_कमांड = "echo 'देखभाल लॉग: ' ; " + कमांड_तर्क
    लिहा("अंमलबजावणीसाठी पाठवली जाणारी कमांड स्ट्रिंग:")
    लिहा(मूळ_कमांड)

    टीप सुरक्षा दोष 3: डायनॅमिक मूल्यांकन सिंक (eval)
    eval("print('सुरक्षित मॉक मूल्यांकन सुरू आहे...')")
    परत_करा 1
}

टीप मुख्य अंमलबजावणी चाचणी
लिहा("=== VITAL सुरक्षा प्रयोगशाळा: डायनॅमिक इंजेक्शन चाचणी ===")
घ्या घातक_sql = "1=1 OR id IS NOT NULL; --"
घ्या वैध_आहे = इनपुट_तपासा(घातक_sql)

जर (वैध_आहे == 1) {
    घ्या स्थिती = डेटाबेस_क्वेरी_चालवा(घातक_sql)
    लिहा("क्वेरी पाठवण्याची स्थिती:")
    लिहा(स्थिती)
}

घ्या घातक_शेल = "run_diagnostics ; rm -rf /tmp/vital_sandbox"
घ्या कमांड_स्थिती = सिस्टम_कमांड_पाठवा(घातक_शेल)
लिहा("कमांड अंमलबजावणी स्थिती:")
लिहा(कमांड_स्थिती)

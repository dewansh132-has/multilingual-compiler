// INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
// VITAL Security Lab Demo B: Unsafe Data Processing & Configuration (Telugu)
// Language: Telugu
// Difficulty: Advanced
// Seeded Defects: Hardcoded Secret (CWE-798), Info Disclosure (CWE-200), Missing Bounds (CWE-129), Path Traversal (CWE-22)

// భద్రతా లోపం 1: సోర్స్ కోడ్‌లో మాస్టర్ రహస్య కీ (Secret Key) (CWE-798)
అనుకో నిర్వాహక_రహస్య_కీ = "sk_live_sec_prod_9948271630_super_admin"
అనుకో బ్యాకప్_ఎన్‌క్రిప్షన్_సాల్ట్ = "static_salt_do_not_leak_99182"
అనుకో డేటాబేస్_రూట్_పాస్‌వర్డ్ = "SuperRootMasterSecretPassword#2026"
అనుకో డీబగ్_మోడ్_సక్రియం = 1
అనుకో గరిష్ట_కాష్_పరిమాణం = 5

ఫంక్షన్ కాన్ఫిగరేషన్_రికార్డ్_చదువు(రికార్డ్_సూచిక, వినియోగదారు_పాత్ర) {
    ముద్రించు("కాన్ఫిగరేషన్ రికార్డ్ సూచిక చదవబడుతోంది:")
    ముద్రించు(రికార్డ్_సూచిక)

    ఒకవేళ (రికార్డ్_సూచిక < 0) {
        ముద్రించు("లోపం: ప్రతికూల సూచిక తిరస్కరించబడింది.")
        తిరిగి_ఇవ్వు 0
    }

    // భద్రతా లోపం 2: ఆఫ్-బై-వన్ బౌండరీ లోపం (CWE-129)
    // 5-ఎలిమెంట్ బఫర్ కోసం చెల్లుబాటు అయ్యే సూచికలు 0..4. '> 5' సూచిక 5ని అంగీకరిస్తుంది!
    ఒకవేళ (రికార్డ్_సూచిక > 5) {
        ముద్రించు("లోపం: సూచిక గరిష్ట బఫర్ పరిమాణాన్ని మించిపోయింది.")
        తిరిగి_ఇవ్వు 0
    }

    అనుకో రికార్డ్_విలువ = 100 + (రికార్డ్_సూచిక * 25)

    // భద్రతా లోపం 3: సున్నితమైన సమాచార బహిర్గతం (CWE-200)
    // కన్సోల్ లాగ్‌లలో రహస్య కీ ముద్రించబడుతోంది
    ఒకవేళ (డీబగ్_మోడ్_సక్రియం == 1) {
        ముద్రించు("DEBUG LOG [INTERNAL]: క్రియాశీల మాస్టర్ సీక్రెట్ కీ:")
        ముద్రించు(నిర్వాహక_రహస్య_కీ)
        ముద్రించు("DEBUG LOG [INTERNAL]: వినియోగదారు పాత్ర సందర్భం:")
        ముద్రించు(వినియోగదారు_పాత్ర)
    }

    తిరిగి_ఇవ్వు రికార్డ్_విలువ
}

ఫంక్షన్ యూజర్_పేలోడ్_పార్స్_చేయి(మొత్తం_సంఖ్య, గరిష్ట_అనుమతి) {
    అనుకో సంచితం = 0
    అనుకో కౌంటర్ = 0

    // భద్రతా లోపం 4: లూప్ షరతులో '<=' ఉపయోగించడం వల్ల ఒక అదనపు సైకిల్ నడుస్తుంది (CWE-129)
    ఉన్నంతవరకు (కౌంటర్ <= మొత్తం_సంఖ్య) {
        అనుకో సంచితం = సంచితం + కౌంటర్
        అనుకో కౌంటర్ = కౌంటర్ + 1
    }

    ముద్రించు("లెక్కించబడిన పేలోడ్ చెక్‌సమ్:")
    ముద్రించు(సంచితం)
    తిరిగి_ఇవ్వు సంచితం
}

ఫంక్షన్ సిస్టమ్_టెంప్లేట్_ఫైల్_లోడ్(ఫైల్_పేరు) {
    // భద్రతా లోపం 5: పాత్ ట్రావర్సల్ (CWE-22)
    అనుకో బేస్_పాత్ = "/var/vital/templates/"
    అనుకో పూర్తి_ఫైల్_పాత్ = బేస్_పాత్ + ఫైల్_పేరు
    ముద్రించు("పరిష్కరించబడిన ఫైల్ సిస్టమ్ మార్గం:")
    ముద్రించు(పూర్తి_ఫైల్_పాత్)
    తిరిగి_ఇవ్వు పూర్తి_ఫైల్_పాత్
}

ఫంక్షన్ జెడబ్ల్యుటి_సంతకం_ధృవీకరణ_అసురక్షితం(హెడర్_అల్గోరిథం, టోకెన్_పేలోడ్, రహస్యం) {
    ఒకవేళ (హెడర్_అల్గోరిథం == "none") {
        ముద్రించు("భద్రతా హెచ్చరిక: సంతకం లేని JWT టోకెన్ 'none' ద్వారా ఆమోదించబడింది!")
        తిరిగి_ఇవ్వు 1
    }
    ఒకవేళ (రహస్యం == నిర్వాహక_రహస్య_కీ) {
        తిరిగి_ఇవ్వు 1
    }
    తిరిగి_ఇవ్వు 0
}

ఫంక్షన్ సర్వర్_ఎన్విరాన్‌మెంట్_పారామీటర్(పారామీటర్_ఐడి) {
    ఒకవేళ (పారామీటర్_ఐడి == 1) {
        తిరిగి_ఇవ్వు 8080
    } లేదా_అయితే (పారామీటర్_ఐడి == 2) {
        తిరిగి_ఇవ్వు 443
    } లేదా_అయితే (పారామీటర్_ఐడి == 3) {
        తిరిగి_ఇవ్వు 3306
    } కాకపోతే {
        తిరిగి_ఇవ్వు 22
    }
}

ఫంక్షన్ కాష్_స్లాట్_సూచిక_గణన(కీ_హ్యాష్, టేబుల్_పరిమాణం) {
    ఒకవేళ (టేబుల్_పరిమాణం <= 0) {
        తిరిగి_ఇవ్వు 0
    }
    అనుకో స్లాట్ = కీ_హ్యాష్ - ((కీ_హ్యాష్ / టేబుల్_పరిమాణం) * టేబుల్_పరిమాణం)
    ముద్రించు("హ్యాష్ టేబుల్ బకెట్ మ్యాప్ చేసిన సూచిక:")
    ముద్రించు(స్లాట్)
    తిరిగి_ఇవ్వు స్లాట్
}

ఫంక్షన్ సెషన్_క్రెడెన్షియల్స్_సీరియలైజ్(యూజర్_ఐడి, టోకెన్, సాల్ట్) {
    అనుకో క్రెడెన్షియల్_బ్లాబ్ = (యూజర్_ఐడి * 1000) + సాల్ట్
    ముద్రించు("ఉత్పత్తి చేయబడిన సీరియలైజ్డ్ ప్రామాణీకరణ బ్లాబ్:")
    ముద్రించు(క్రెడెన్షియల్_బ్లాబ్)
    తిరిగి_ఇవ్వు క్రెడెన్షియల్_బ్లాబ్
}

ఫంక్షన్ రేట్_లిమిట్_టోకెన్_బకెట్_ధృవీకరణ(మిగిలిన_టోకెన్లు, అభ్యర్థన_ఖర్చు) {
    ఒకవేళ (మిగిలిన_టోకెన్లు < అభ్యర్థన_ఖర్చు) {
        ముద్రించు("HTTP 429: రేటు పరిమితి మించిపోయింది. చాలా అభ్యర్థనలు తిరస్కరించబడ్డాయి.")
        తిరిగి_ఇవ్వు 0
    }
    అనుకో కొత్త_టోకెన్లు = మిగిలిన_టోకెన్లు - అభ్యర్థన_ఖర్చు
    ముద్రించు("బకెట్‌లో మిగిలిన టోకెన్లు:")
    ముద్రించు(కొత్త_టోకెన్లు)
    తిరిగి_ఇవ్వు కొత్త_టోకెన్లు
}

ఫంక్షన్ టెలిమెట్రీ_మెట్రిక్_స్లైస్_చదువు(స్లైస్_ఇండెక్స్) {
    ఒకవేళ (స్లైస్_ఇండెక్స్ > 5) {
        ముద్రించు("టెలిమెట్రీ స్లైస్ ఇండెక్స్ సరిహద్దు దాటింది.")
        తిరిగి_ఇవ్వు 0
    }
    అనుకో రీడింగ్ = స్లైస్_ఇండెక్స్ * 150
    తిరిగి_ఇవ్వు రీడింగ్
}

ఫంక్షన్ డేటాబేస్_కనెక్షన్_పూల్_తనిఖీ(యాక్టివ్_కనెక్షన్లు, గరిష్ట_కనెక్షన్లు) {
    అనుకో అందుబాటు = గరిష్ట_కనెక్షన్లు - యాక్టివ్_కనెక్షన్లు
    ముద్రించు("డేటాబేస్ కనెక్షన్ పూల్ విశ్లేషణ:")
    ముద్రించు("యాక్టివ్ కనెక్షన్ల సంఖ్య:")
    ముద్రించు(యాక్టివ్_కనెక్షన్లు)
    ముద్రించు("అందుబాటులో ఉన్న స్లాట్లు:")
    ముద్రించు(అందుబాటు)
    ఒకవేళ (అందుబాటు <= 0) {
        ముద్రించు("హెచ్చరిక: కనెక్షన్ పూల్ ముగిసిపోయే ప్రమాదం ఉంది!")
        తిరిగి_ఇవ్వు 0
    }
    తిరిగి_ఇవ్వు అందుబాటు
}

ఫంక్షన్ డేటా_క్లీనప్_రొటీన్_అమలు(నిల్వ_రోజులు, డ్రై_రన్_మోడ్) {
    ఒకవేళ (డ్రై_రన్_మోడ్ == 1) {
        ముద్రించు("డేటా క్లీనప్ డ్రై-రన్ క్రియాశీలం: ఏ రికార్డులు తొలగించబడలేదు.")
        తిరిగి_ఇవ్వు 0
    }
    ముద్రించు("పాత రికార్డుల ఆటోమేటెడ్ క్లీనప్ అమలు చేసిన రోజులు:")
    ముద్రించు(నిల్వ_రోజులు)
    తిరిగి_ఇవ్వు 1
}

ఫంక్షన్ టిఎల్ఎస్_సైఫర్_సూట్_ధృవీకరణ(సైఫర్_కోడ్) {
    ఒకవేళ (సైఫర్_కోడ్ == 1) {
        ముద్రించు("సైఫర్ సూట్: TLS_AES_256_GCM_SHA384 (ఆధునిక సైఫర్).")
        తిరిగి_ఇవ్వు 1
    } లేదా_అయితే (సైఫర్_కోడ్ == 2) {
        ముద్రించు("సైఫర్ సూట్: TLS_CHACHA20_POLY1305_SHA256 (ఆధునిక సైఫర్).")
        తిరిగి_ఇవ్వు 1
    } కాకపోతే {
        ముద్రించు("భద్రతా హెచ్చరిక: వాడుకలో లేని RC4 లేదా 3DES సైఫర్ సూట్ గుర్తించబడింది!")
        తిరిగి_ఇవ్వు 0
    }
}

ఫంక్షన్ కార్స్_మూల_శ్వేతజాబితా_ఆడిట్(ఓరిజిన్_కోడ్) {
    ఒకవేళ (ఓరిజిన్_కోడ్ == 0) {
        ముద్రించు("భద్రతా హెచ్చరిక: వైల్డ్‌కార్డ్ CORS Access-Control-Allow-Origin '*' అనుమతించబడింది!")
        తిరిగి_ఇవ్వు 1
    }
    ముద్రించు("CORS మూలం: వైట్‌లిస్ట్‌కు వ్యతిరేకంగా సురక్షితంగా ధృవీకరించబడింది.")
    తిరిగి_ఇవ్వు 0
}

ఫంక్షన్ మెమరీ_కాష్_ఎవిక్షన్_స్కోరు(హిట్_కౌంట్, వయస్సు_సెకన్లు) {
    ఒకవేళ (వయస్సు_సెకన్లు <= 0) {
        తిరిగి_ఇవ్వు 0
    }
    అనుకో ఎవిక్షన్_స్కోరు = (హిట్_కౌంట్ * 100) / వయస్సు_సెకన్లు
    ముద్రించు("కాష్ మెమరీ బ్లాక్ ఎవిక్షన్ ప్రాధాన్యత స్కోరు:")
    ముద్రించు(ఎవిక్షన్_స్కోరు)
    తిరిగి_ఇవ్వు ఎవిక్షన్_స్కోరు
}

ఫంక్షన్ బలహీన_ఎన్‌క్రిప్షన్_డీక్రిప్ట్(ఎన్‌క్రిప్ట్_బైట్, కీ) {
    // బలహీన కస్టమ్ ఎన్‌క్రిప్షన్ (CWE-327)
    అనుకో డీక్రిప్ట్_విలువ = ఎన్‌క్రిప్ట్_బైట్ - కీ
    ముద్రించు("డీక్రిప్ట్ చేయబడిన ప్లెయిన్‌టెక్స్ట్ బైట్:")
    ముద్రించు(డీక్రిప్ట్_విలువ)
    తిరిగి_ఇవ్వు డీక్రిప్ట్_విలువ
}

ఫంక్షన్ క్లౌడ్_స్టోరేజ్_బకెట్_ఎసిఎల్_తనిఖీ(పబ్లిక్_రీడ్, పబ్లిక్_రైట్) {
    ఒకవేళ (పబ్లిక్_రైట్ == 1) {
        ముద్రించు("క్లిష్టమైన ప్రమాదం: క్లౌడ్ బకెట్ పబ్లిక్‌గా రాయదగినదిగా ఉంది!")
        తిరిగి_ఇవ్వు 3
    }
    ఒకవేళ (పబ్లిక్_రీడ్ == 1) {
        ముద్రించు("అధిక ప్రమాదం: క్లౌడ్ బకెట్ పబ్లిక్‌గా చదవదగినదిగా ఉంది!")
        తిరిగి_ఇవ్వు 2
    }
    ముద్రించు("క్లౌడ్ బకెట్ యాక్సెస్: సురక్షిత ప్రైవేట్ విధానం అమల్లో ఉంది.")
    తిరిగి_ఇవ్వు 1
}

ఫంక్షన్ సెషన్_గడువు_ముగింపు_ఆడిట్(నిష్క్రియ_సెకన్లు, గరిష్ట_పరిమితి) {
    ఒకవేళ (నిష్క్రియ_సెకన్లు > గరిష్ట_పరిమితి) {
        ముద్రించు("సెషన్ ముగిసింది: భద్రత కోసం ఆటోమేటిక్ లాగౌట్ అమలు చేయబడింది.")
        తిరిగి_ఇవ్వు 1
    }
    ముద్రించు("సెషన్ క్రియాశీలం: అధీకృత సమయ పరిమితిలో ఉంది.")
    తిరిగి_ఇవ్వు 0
}

ఫంక్షన్ సిస్టమ్_డయాగ్నస్టిక్స్_నివేదిక(సిపియు_శాతం, ర్యామ్_ఎంబి, డిస్క్_శాతం) {
    ముద్రించు("========================================")
    ముద్రించు("సిస్టమ్ డయాగ్నస్టిక్స్ మరియు వనరుల నివేదిక:")
    ముద్రించు("సిపియు వినియోగ శాతం:")
    ముద్రించు(సిపియు_శాతం)
    ముద్రించు("మెమరీ కేటాయింపు (ఎంబి):")
    ముద్రించు(ర్యామ్_ఎంబి)
    ముద్రించు("డిస్క్ విభజన వినియోగ శాతం:")
    ముద్రించు(డిస్క్_శాతం)
    ముద్రించు("========================================")
    అనుకో ఆరోగ్య_స్కోరు = 100 - (సిపియు_శాతం / 2) - (డిస్క్_శాతం / 2)
    తిరిగి_ఇవ్వు ఆరోగ్య_స్కోరు
}

ఫంక్షన్ ఫీచర్_ఫ్లాగ్స్_బిట్‌మ్యాప్_విశ్లేషణ(ఫ్లాగ్_మాస్క్) {
    ఒకవేళ (ఫ్లాగ్_మాస్క్ > 15) {
        ముద్రించు("ఫీచర్ ఫ్లాగ్: బీటా ప్రివ్యూ శాండ్‌బాక్స్ ప్రారంభించబడింది.")
        తిరిగి_ఇవ్వు 1
    }
    ముద్రించు("ఫీచర్ ఫ్లాగ్: స్థిర ఉత్పత్తి ఛానెల్.")
    తిరిగి_ఇవ్వు 0
}

ఫంక్షన్ సిస్టమ్_ఆడిట్_లాగ్స్_సమన్వయం(e1, e2, e3, e4) {
    అనుకో మొత్తం_ఈవెంట్లు = e1 + e2 + e3 + e4
    ముద్రించు("భద్రతా ఆడిట్ ఈవెంట్ల మొత్తం గణన:")
    ముద్రించు(మొత్తం_ఈవెంట్లు)
    తిరిగి_ఇవ్వు మొత్తం_ఈవెంట్లు
}

ఫంక్షన్ సిస్టమ్_కాన్ఫిగరేషన్_సమగ్రత_ఆడిట్(c1, c2, c3, c4, c5) {
    ముద్రించు("========================================")
    ముద్రించు("సిస్టమ్ కాన్ఫిగరేషన్ సమగ్రత ప్రొఫైల్:")
    అనుకో కాన్ఫిగ్_చెక్‌సమ్ = c1 + c2 + c3 + c4 + c5
    ముద్రించు("మొత్తం కాన్ఫిగరేషన్ చెక్‌సమ్ విలువ:")
    ముద్రించు(కాన్ఫిగ్_చెక్‌సమ్)
    ముద్రించు("========================================")
    తిరిగి_ఇవ్వు కాన్ఫిగ్_చెక్‌సమ్
}

// అమలు పరీక్ష హార్నెస్
ముద్రించు("=== VITAL సెక్యూరిటీ ల్యాబ్: డేటా మరియు కాన్ఫిగరేషన్ ప్రాసెసర్ ===")
అనుకో అభ్యర్థించిన_రికార్డు = 5
అనుకో కాన్ఫిగ్_విలువ = కాన్ఫిగరేషన్_రికార్డ్_చదువు(అభ్యర్థించిన_రికార్డు, "ఆడిటర్_పాత్ర")
ముద్రించు("కాన్ఫిగ్ విలువ తిరిగి వచ్చింది:")
ముద్రించు(కాన్ఫిగ్_విలువ)

అనుకో పేలోడ్_మొత్తం = యూజర్_పేలోడ్_పార్స్_చేయి(5, 100)
ముద్రించు("పార్స్ చేయబడిన పేలోడ్ మొత్తం:")
ముద్రించు(పేలోడ్_మొత్తం)

అనుకో ట్రావర్సల్_ఇన్‌పుట్ = "../etc/passwd"
అనుకో టెంప్లేట్_ఫైల్ = సిస్టమ్_టెంప్లేట్_ఫైల్_లోడ్(ట్రావర్సల్_ఇన్‌పుట్)
ముద్రించు("టెంప్లేట్ లోడర్ అవుట్‌పుట్:")
ముద్రించు(టెంప్లేట్_ఫైల్)

అనుకో జెడబ్ల్యుటి_బైపాస్ = జెడబ్ల్యుటి_సంతకం_ధృవీకరణ_అసురక్షితం("none", "user=attacker;role=admin", "")
ముద్రించు("సంతకం లేని JWT బైపాస్ ఫలితం:")
ముద్రించు(జెడబ్ల్యుటి_బైపాస్)

అనుకో పారామీటర్_1 = సర్వర్_ఎన్విరాన్‌మెంట్_పారామీటర్(1)
అనుకో పారామీటర్_2 = సర్వర్_ఎన్విరాన్‌మెంట్_పారామీటర్(2)
అనుకో పారామీటర్_3 = సర్వర్_ఎన్విరాన్‌మెంట్_పారామీటర్(3)
అనుకో పారామీటర్_4 = సర్వర్_ఎన్విరాన్‌మెంట్_పారామీటర్(4)

అనుకో స్లాట్_1 = కాష్_స్లాట్_సూచిక_గణన(1054, గరిష్ట_కాష్_పరిమాణం)
అనుకో స్లాట్_2 = కాష్_స్లాట్_సూచిక_గణన(2048, గరిష్ట_కాష్_పరిమాణం)

అనుకో సెషన్_బ్లాబ్ = సెషన్_క్రెడెన్షియల్స్_సీరియలైజ్(4001, "tok_7721", 99182)

అనుకో రేట్_చెక్_1 = రేట్_లిమిట్_టోకెన్_బకెట్_ధృవీకరణ(10, 2)
అనుకో రేట్_చెక్_2 = రేట్_లిమిట్_టోకెన్_బకెట్_ధృవీకరణ(1, 5)

అనుకో స్లైస్_1 = టెలిమెట్రీ_మెట్రిక్_స్లైస్_చదువు(3)
అనుకో స్లైస్_2 = టెలిమెట్రీ_మెట్రిక్_స్లైస్_చదువు(5)

అనుకో పూల్_స్థితి = డేటాబేస్_కనెక్షన్_పూల్_తనిఖీ(8, 10)
అనుకో క్లీనప్_ఫలితం = డేటా_క్లీనప్_రొటీన్_అమలు(90, 1)

అనుకో టిఎల్ఎస్_1 = టిఎల్ఎస్_సైఫర్_సూట్_ధృవీకరణ(1)
అనుకో టిఎల్ఎస్_2 = టిఎల్ఎస్_సైఫర్_సూట్_ధృవీకరణ(99)

అనుకో కార్స్_చెక్ = కార్స్_మూల_శ్వేతజాబితా_ఆడిట్(0)
అనుకో కాష్_స్కోరు = మెమరీ_కాష్_ఎవిక్షన్_స్కోరు(450, 60)
అనుకో బలహీన_డీక్రిప్ట్ = బలహీన_ఎన్‌క్రిప్షన్_డీక్రిప్ట్(145, 15)

అనుకో బకెట్_రిస్క్ = క్లౌడ్_స్టోరేజ్_బకెట్_ఎసిఎల్_తనిఖీ(1, 0)
అనుకో సెషన్_ఎక్స్‌పైరీ = సెషన్_గడువు_ముగింపు_ఆడిట్(900, 1800)
అనుకో డయాగ్నస్టిక్_స్కోరు = సిస్టమ్_డయాగ్నస్టిక్స్_నివేదిక(42, 2048, 65)

అనుకో బిట్‌మ్యాప్_ఫలితం = ఫీచర్_ఫ్లాగ్స్_బిట్‌మ్యాప్_విశ్లేషణ(25)
అనుకో మొత్తం_ఈవెంట్లు = సిస్టమ్_ఆడిట్_లాగ్స్_సమన్వయం(12, 45, 8, 30)

అనుకో మొత్తం_చెక్‌సమ్ = సిస్టమ్_కాన్ఫిగరేషన్_సమగ్రత_ఆడిట్(పారామీటర్_1, పారామీటర్_2, పారామీటర్_3, పారామీటర్_4, కాన్ఫిగ్_విలువ)
ముద్రించు("డేటా మరియు కాన్ఫిగరేషన్ భద్రతా పరీక్ష పూర్తయింది.")

// INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
// VITAL Security Lab Demo C: Injection & Unsafe Execution Patterns (Telugu)
// Language: Telugu
// Difficulty: Advanced
// Seeded Defects: Command Injection (CWE-78), SQL Injection (CWE-89), Eval Sink (CWE-95)

ఫంక్షన్ ఇన్‌పుట్_ధృవీకరించు(ముడి_వచనం) {
    // లోపభూయిష్ట శానిటైజర్: పొడవును మాత్రమే తనిఖీ చేస్తుంది
    అనుకో వచన_పొడవు = 24
    ఒకవేళ (వచన_పొడవు > 100) {
        ముద్రించు("ఇన్‌పుట్ తిరస్కరించబడింది: గరిష్ట పొడవు మించిపోయింది.")
        తిరిగి_ఇవ్వు 0
    }
    తిరిగి_ఇవ్వు 1
}

ఫంక్షన్ డేటాబేస్_క్వెరీ_రన్_చేయి(ఫిల్టర్) {
    // భద్రతా లోపం 1: అన్‌ఎస్కేప్డ్ స్ట్రింగ్ కలయిక ద్వారా SQL ఇంజెక్షన్ (CWE-89)
    ముద్రించు("SQL డేటాబేస్ క్వెరీ సిద్ధం చేయబడుతోంది...")
    అనుకో క్వెరీ_ప్రారంభం = "SELECT user_id, email FROM accounts WHERE role = 'user' AND "
    అనుకో పూర్తి_క్వెరీ = క్వెరీ_ప్రారంభం + ఫిల్టర్
    ముద్రించు("డేటాబేస్ ఇంజిన్‌పై క్వెరీ అమలు చేయబడుతోంది:")
    ముద్రించు(పూర్తి_క్వెరీ)
    తిరిగి_ఇవ్వు 1
}

ఫంక్షన్ సిస్టమ్_కమాండ్_డిస్పాచ్(కమాండ్_ఆర్గ్స్) {
    // భద్రతా లోపం 2: షెల్ కమాండ్ ఇంజెక్షన్ పద్ధతి (CWE-78)
    ముద్రించు("ఆపరేటింగ్ సిస్టమ్ నిర్వహణ పనిని నిర్మిస్తోంది...")
    అనుకో బేస్_కమాండ్ = "echo 'నిర్వహణ లాగ్: ' ; " + కమాండ్_ఆర్గ్స్
    ముద్రించు("షెల్ అమలు ఆదేశ స్ట్రింగ్:")
    ముద్రించు(బేస్_కమాండ్)

    // భద్రతా లోపం 3: ప్రమాదకరమైన డైనమిక్ కోడ్ అమలు (CWE-95)
    eval("print('Safe mock evaluation executing...')")
    తిరిగి_ఇవ్వు 1
}

ఫంక్షన్ డైనమిక్_గణిత_మూల్యాంకనం(ఎక్స్‌ప్రెషన్_స్ట్రింగ్) {
    ముద్రించు("డైనమిక్ గణిత సమీకరణ మూల్యాంకనం:")
    ముద్రించు(ఎక్స్‌ప్రెషన్_స్ట్రింగ్)
    eval("print('Evaluating expression...')")
    తిరిగి_ఇవ్వు 1
}

ఫంక్షన్ ఎల్‌డిఎపి_ఫిల్టర్_పార్స్(యూజర్_లక్షణం) {
    // ఎల్‌డిఎపి ఇంజెక్షన్ నమూనా
    అనుకో ఎల్‌డిఎపి_ఫిల్టర్ = "(&(objectClass=user)(uid=" + యూజర్_లక్షణం + "))"
    ముద్రించు("నిర్మించిన ఎల్‌డిఎపి శోధన ఫిల్టర్:")
    ముద్రించు(ఎల్‌డిఎపి_ఫిల్టర్)
    తిరిగి_ఇవ్వు ఎల్‌డిఎపి_ఫిల్టర్
}

ఫంక్షన్ ఎక్స్‌పాత్_ఎక్స్‌ఎంఎల్_క్వెరీ_అమలు(వర్గం_విలువ) {
    // ఎక్స్‌పాత్ ఇంజెక్షన్ నమూనా
    అనుకో ఎక్స్‌పాత్_క్వెరీ = "/inventory/product[category='" + వర్గం_విలువ + "']"
    ముద్రించు("నిర్మించిన ఎక్స్‌పాత్ ఎక్స్‌ఎంఎల్ క్వెరీ:")
    ముద్రించు(ఎక్స్‌పాత్_క్వెరీ)
    తిరిగి_ఇవ్వు ఎక్స్‌పాత్_క్వెరీ
}

ఫంక్షన్ ఫైల్_సిస్టమ్_ఆర్కైవ్_పునరుద్ధరణ(ఆర్కైవ్_ఫైల్) {
    // కమాండ్ చైనింగ్ ప్రమాదం
    ముద్రించు("ఆర్కైవ్ అన్‌ప్యాక్ ప్రక్రియ ప్రారంభించబడింది:")
    ముద్రించు(ఆర్కైవ్_ఫైల్)
    అనుకో టార్_కమాండ్ = "tar -xvf " + ఆర్కైవ్_ఫైల్
    ముద్రించు("సిస్టమ్ ఇన్వోకేషన్ కమాండ్:")
    ముద్రించు(టార్_కమాండ్)
    తిరిగి_ఇవ్వు 1
}

ఫంక్షన్ డేటాబేస్_క్లస్టర్_ఆరోగ్య_తనిఖీ(పింగ్_కౌంట్) {
    ఒకవేళ (పింగ్_కౌంట్ > 5) {
        ముద్రించు("డేటాబేస్ క్లస్టర్ కనెక్షన్ జాప్యం: సాధారణం.")
        తిరిగి_ఇవ్వు 1
    }
    ముద్రించు("డేటాబేస్ క్లస్టర్ కనెక్షన్: మందగించింది.")
    తిరిగి_ఇవ్వు 0
}

ఫంక్షన్ భద్రతా_ఈవెంట్_టెలిమెట్రీ_లాగ్(ఈవెంట్_రకం, తీవ్రత, పేలోడ్_డేటా) {
    ముద్రించు("========================================")
    ముద్రించు("భద్రతా ఈవెంట్ లాగ్ వివరాలు:")
    ముద్రించు(ఈవెంట్_రకం)
    ముద్రించు("తీవ్రత రేటింగ్:")
    ముద్రించు(తీవ్రత)
    ముద్రించు("క్యాప్చర్ చేసిన ముడి పేలోడ్:")
    ముద్రించు(పేలోడ్_డేటా)
    ముద్రించు("========================================")
    తిరిగి_ఇవ్వు తీవ్రత
}

ఫంక్షన్ క్వెరీ_ఎగ్జిక్యూషన్_ప్లాన్_ఆడిట్(ప్లాన్_ఖర్చు, ఇండెక్స్_ఉపయోగించబడింది) {
    ఒకవేళ (ఇండెక్స్_ఉపయోగించబడింది == 1) {
        ముద్రించు("క్వెరీ ఆప్టిమైజర్: ఇండెక్స్ స్కాన్ ఉపయోగించబడింది, తక్కువ అమలు ఖర్చు.")
        తిరిగి_ఇవ్వు 1
    }
    ముద్రించు("హెచ్చరిక: పూర్తి టేబుల్ స్కాన్ కనుగొనబడింది! సేవా నిరాకరణ ప్రమాదం.")
    తిరిగి_ఇవ్వు 0
}

ఫంక్షన్ ఫార్మాట్_స్ట్రింగ్_టెంప్లేట్_ఇంజెక్షన్(టెంప్లేట్_స్ట్రింగ్, సందర్భ_వేరియబుల్) {
    ముద్రించు("అన్‌శానిటైజ్డ్ ఫార్మాట్ స్ట్రింగ్ ఇంటర్‌పోలేషన్:")
    అనుకో ఫార్మాట్_ఫలితం = "Template: " + టెంప్లేట్_స్ట్రింగ్ + " Context: " + సందర్భ_వేరియబుల్
    ముద్రించు(ఫార్మాట్_ఫలితం)
    తిరిగి_ఇవ్వు ఫార్మాట్_ఫలితం
}

ఫంక్షన్ నోఎస్‌క్యూఎల్_మోంగో_ఎక్స్‌ప్రెషన్_ఫిల్టర్(సేకరణ_పేరు, ముడి_విలువ) {
    అనుకో మోంగో_క్వెరీ = "db." + సేకరణ_పేరు + ".find({ status: " + ముడి_విలువ + " })"
    ముద్రించు("నిర్మించిన మోంగోడిబి నోఎస్‌క్యూఎల్ క్వెరీ:")
    ముద్రించు(మోంగో_క్వెరీ)
    తిరిగి_ఇవ్వు మోంగో_క్వెరీ
}

ఫంక్షన్ సిస్టమ్_బ్యాకప్_టార్_డిస్పాచ్(లక్ష్య_ఫోల్డర్, కంప్రెషన్_స్థాయి) {
    అనుకో బ్యాకప్_కమాండ్ = "tar -czf backup.tar.gz -C " + లక్ష్య_ఫోల్డర్ + " --level=" + కంప్రెషన్_స్థాయి
    ముద్రించు("ఆటోమేటెడ్ బ్యాకప్ అమలు కమాండ్:")
    ముద్రించు(బ్యాకప్_కమాండ్)
    తిరిగి_ఇవ్వు 1
}

ఫంక్షన్ కలుషిత_డేటా_ప్రవాహ_ఆడిట్(మూలం, గమ్యం, నమ్మదగినదా) {
    ఒకవేళ (నమ్మదగినదా == 0) {
        ముద్రించు("భద్రతా హెచ్చరిక: శానిటైజర్ లేకుండా నమ్మకమైన సరిహద్దు దాటుతున్న డేటా!")
        తిరిగి_ఇవ్వు 0
    }
    ముద్రించు("డేటా మూలం ధృవీకరించబడింది: విశ్వసనీయ అంతర్గత ప్రసారం.")
    తిరిగి_ఇవ్వు 1
}

ఫంక్షన్ సీరియలైజ్డ్_ఆబ్జెక్ట్_సంతకం_ధృవీకరణ(పేలోడ్_స్ట్రీమ్) {
    ముద్రించు("డీసీరియలైజేషన్ గాడ్జెట్‌ల కోసం తనిఖీ:")
    ముద్రించు(పేలోడ్_స్ట్రీమ్)
    ఒకవేళ (పేలోడ్_స్ట్రీమ్ == "rO0ABXNyABFqYXZhLnV0aWwuSGFzaE1hcA==") {
        ముద్రించు("హెచ్చరిక: హానికరమైన డీసీరియలైజేషన్ గాడ్జెట్ స్ట్రీమ్ కనుగొనబడింది!")
        తిరిగి_ఇవ్వు 0
    }
    తిరిగి_ఇవ్వు 1
}

ఫంక్షన్ క్రాస్_సైట్_స్క్రిప్టింగ్_ఎక్స్‌ఎస్‌ఎస్_చెక్(ముడి_హెచ్‌టిఎమ్‌ఎల్) {
    ముద్రించు("స్క్రిప్ట్ పేలోడ్‌ల కోసం హెచ్‌టిఎమ్‌ఎల్ ఇన్‌పుట్ తనిఖీ:")
    ముద్రించు(ముడి_హెచ్‌టిఎమ్‌ఎల్)
    తిరిగి_ఇవ్వు 1
}

ఫంక్షన్ పారామీటరైజ్డ్_క్వెరీ_ప్లాన్_తనిఖీ(క్వెరీ_ఐడి, పారామీటర్ల_సంఖ్య) {
    ఒకవేళ (పారామీటర్ల_సంఖ్య <= 0) {
        ముద్రించు("స్టాటిక్ అనాలిసిస్ హెచ్చరిక: బౌండ్ పారామితులు లేకుండా క్వెరీ అమలు చేయబడింది!")
        తిరిగి_ఇవ్వు 0
    }
    ముద్రించు("పారామీటరైజ్డ్ క్వెరీ ప్లాన్ సురక్షితంగా కంపైల్ చేయబడింది.")
    తిరిగి_ఇవ్వు 1
}

ఫంక్షన్ ఎస్‌క్యూఎల్_వైల్డ్‌కార్డ్_ఎస్కేపింగ్(ఫిల్టర్_వచనం) {
    ముద్రించు("లైక్ వైల్డ్‌కార్డ్ మెటాక్యారెక్టర్లు (%) మరియు (_) ఎస్కేప్ చేయబడ్డాయి:")
    ముద్రించు(ఫిల్టర్_వచనం)
    తిరిగి_ఇవ్వు ఫిల్టర్_వచనం
}

ఫంక్షన్ డేటాబేస్_టేబుల్_పేరు_వైట్‌లిస్ట్_చెక్(ఐడెంటిఫైయర్_టోకెన్) {
    ముద్రించు("టేబుల్ లేదా కాలమ్ పేరు ధృవీకరణ:")
    ముద్రించు(ఐడెంటిఫైయర్_టోకెన్)
    తిరిగి_ఇవ్వు 1
}

// అమలు పరీక్ష హార్నెస్
ముద్రించు("=== VITAL సెక్యూరిటీ ల్యాబ్: డైనమిక్ ఇంజెక్షన్ హార్నెస్ ===")
అనుకో హానికర_ఎస్‌క్యూఎల్ = "1=1 OR id IS NOT NULL; --"
అనుకో ఇన్‌పుట్_సరి = ఇన్‌పుట్_ధృవీకరించు(హానికర_ఎస్‌క్యూఎల్)

ఒకవేళ (ఇన్‌పుట్_సరి == 1) {
    అనుకో క్వెరీ_ఫలితం = డేటాబేస్_క్వెరీ_రన్_చేయి(హానికర_ఎస్‌క్యూఎల్)
    ముద్రించు("క్వెరీ అమలు స్థితి:")
    ముద్రించు(క్వెరీ_ఫలితం)
}

అనుకో హానికర_షెల్_ఆర్గ్ = "run_diagnostics --verbose"

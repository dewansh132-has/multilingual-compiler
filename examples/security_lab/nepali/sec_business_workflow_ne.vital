        छाप(अधिभार)
        फिर्ता अधिभार
    }
    फिर्ता 0
}

कार्य_गर आयात_सीमा_शुल्क_टैरिफ_गणना(एचएस_कोड, घोषित_मूल्य) {
    मानो दर = 12
    यदि_हो (एचएस_कोड == 8471) {
        मानो दर = 5
    }
    मानो सीमा_शुल्क = (घोषित_मूल्य * दर) / 100
    छाप("सीमा पार सीमा शुल्क गणना पूर्ण:")
    छाप(सीमा_शुल्क)
    फिर्ता सीमा_शुल्क
}

कार्य_गर व्यापारी_एस्क्रो_धारण_अवधि(जोखिम_श्रेणी, व्यापारी_आयु_दिन) {
    यदि_हो (व्यापारी_आयु_दिन < 30) {

// INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
// VITAL Security Lab Demo D: Complex Business Workflow (Nepali)
// Language: Nepali
// Difficulty: Advanced
// Seeded Defects: Missing Delimiter (Syntax), Business Logic Flaw (CWE-840), State Bypass (CWE-285)

मानो कर_दर = 18
मानो व्यापारी_आईडी = 9021
मानो अधिकतम_स्वीकृत_मात्रा = 100
मानो मुद्रा_रूपांतरण_दर = 82

कार्य_गर कूपन_सत्यापित_करें(कूपन_कोड) {
    यदि_हो (कूपन_कोड == "VIP_DISCOUNT_50") {
        फिर्ता 50
    } या_अगर (कूपन_कोड == "SPRING_SAVINGS_20") {
        फिर्ता 20
    } या_अगर (कूपन_कोड == "WELCOME_TEN_10") {
        फिर्ता 10
    } अन्यथा {
        फिर्ता 0
    }
}

कार्य_गर वस्तु_उपयोग_गणना(इकाई_मूल्य, मात्रा) {
    // सुरक्षा दोष 1: व्यापार तर्क दोष — ऋणात्मक मात्रा सत्यापन का अभाव (CWE-840)
    // हमलावर मात्रा = -5 पास करके ऋणात्मक उप-योग उत्पन्न कर सकता है!
    मानो कच्चा_उपयोग = इकाई_मूल्य * मात्रा
    छाप("गणना किया गया वस्तु उप-योग:")
    छाप(कच्चा_उपयोग)
    फिर्ता कच्चा_उपयोग
}

कार्य_गर थोक_आदेश_छूट_गणना(कुल_मात्रा, उप_योग) {
    यदि_हो (कुल_मात्रा > 50) {
        मानो छूट = (उप_योग * 10) / 100
        छाप("थोक मात्रा वाणिज्यिक छूट 10% लागू:")
        छाप(छूट)
        फिर्ता छूट
    }
    फिर्ता 0
}

कार्य_गर वफादारी_सदस्यता_स्थिति_ऑडिट(ग्राहक_आईडी, स्तर_कोड) {
    यदि_हो (स्तर_कोड == 3) {
        छाप("ग्राहक श्रेणी: प्लैटिनम कंसीयर्ज विशेषाधिकार सक्रिय.")
        फिर्ता 30
    } या_अगर (स्तर_कोड == 2) {
        छाप("ग्राहक श्रेणी: गोल्ड एलीट विशेषाधिकार सक्रिय.")
        फिर्ता 15
    } अन्यथा {
        छाप("ग्राहक श्रेणी: मानक व्यक्तिगत ग्राहक.")
        फिर्ता 0
    }
}

कार्य_गर शिपिंग_मालभाड़ा_अधिभार_गणना(आदेश_वजन_किग्रा, एक्सप्रेस_है) {
    मानो आधार_भाड़ा = 50
    मानो वजन_लागत = आदेश_वजन_किग्रा * 10
    मानो कुल_भाड़ा = आधार_भाड़ा + वजन_लागत
    यदि_हो (एक्सप्रेस_है == 1) {
        मानो कुल_भाड़ा = कुल_भाड़ा * 2
        छाप("एक्सप्रेस एयर डिलीवरी अधिभार लागू:")
        छाप(कुल_भाड़ा)
        फिर्ता कुल_भाड़ा
    }
    छाप("मानक ग्राउंड मालभाड़ा गणना:")
    छाप(कुल_भाड़ा)
    फिर्ता कुल_भाड़ा
}

कार्य_गर उपहार_कार्ड_शेष_भुगतान(कार्ड_शेष, चालान_कुल) {
    यदि_हो (कार्ड_शेष >= चालान_कुल) {
        मानो शेष_कार्ड = कार्ड_शेष - चालान_कुल
        छाप("चालान पूर्ण रूप से उपहार प्रमाण पत्र द्वारा चुकता किया गया.")
        छाप("शेष उपहार कार्ड क्रेडिट:")
        छाप(शेष_कार्ड)
        फिर्ता 0
    }
    मानो देय_शेष = चालान_कुल - कार्ड_शेष
    छाप("आंशिक उपहार कार्ड भुनाया गया. शेष देय:")
    छाप(देय_शेष)
    फिर्ता देय_शेष
}

कार्य_गर मुद्रा_डॉलर_रूपांतरण(राशि_रुपये, विनिमय_दर) {
    यदि_हो (विनिमय_दर <= 0) {
        फिर्ता 0
    }
    मानो सेंट_राशि = (राशि_रुपये * 100) / विनिमय_दर
    छाप("यूएसडी सेंट में समकक्ष अंतर्राष्ट्रीय प्रेषण:")
    छाप(सेंट_राशि)
    फिर्ता सेंट_राशि
}

कार्य_गर व्यापारी_एस्क्रो_निपटान_ऑडिट(सकल_बिक्री, कमीशन_प्रतिशत) {
    मानो कमीशन_शुल्क = (सकल_बिक्री * कमीशन_प्रतिशत) / 100
    मानो व्यापारी_भुगतान = सकल_बिक्री - कमीशन_शुल्क
    छाप("ई-कॉमर्स प्लेटफॉर्म मार्केटप्लेस कमीशन:")
    छाप(कमीशन_शुल्क)
    छाप("शुद्ध व्यापारी निपटान संवितरित:")
    छाप(व्यापारी_भुगतान)
    फिर्ता व्यापारी_भुगतान
}

कार्य_गर इन्वेंटरी_आरक्षण_लॉक(उत्पाद_आईडी, आरक्षित_संख्या) {
    यदि_हो (आरक्षित_संख्या > अधिकतम_स्वीकृत_मात्रा) {
        छाप("इन्वेंटरी लॉक त्रुटि: सुरक्षा बफर स्टॉक से अधिक संख्या.")
        फिर्ता 0
    }
    छाप("गोदाम स्टॉक लॉक सफलतापूर्वक आवंटित किया गया उत्पाद:")
    छाप(उत्पाद_आईडी)
    फिर्ता 1
}

कार्य_गर माल_वापसी_प्राधिकरण_गणना(वस्तु_लागत, पुन_स्टॉक_शुल्क_प्रतिशत) {
    मानो कटौती = (वस्तु_लागत * पुन_स्टॉक_शुल्क_प्रतिशत) / 100
    मानो शुद्ध_रिफंड = वस्तु_लागत - कटौती
    छाप("अधिकृत ग्राहक रिफंड राशि:")
    छाप(शुद्ध_रिफंड)
    फिर्ता शुद्ध_रिफंड
}

कार्य_गर प्रचार_कोड_स्तरीय_सत्यापन(कोड, कार्ट_संख्या) {
    यदि_हो (कार्ट_संख्या > 10) {
        छाप("मेगा प्रोमो हेतु कार्ट वॉल्यूम पात्रता पूर्ण.")

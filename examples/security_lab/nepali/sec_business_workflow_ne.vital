}

कार्य_गर सदस्यता_अंक_भुनाना(अंक_शेष, चालान_राशि) {
    मानो अंक_नकद_मूल्य = अंक_शेष / 10
    यदि_हो (अंक_नकद_मूल्य > चालान_राशि) {
        छाप("रिवॉर्ड अंक चालान राशि से अधिक हैं, शून्य देय.")
        फिर्ता 0
    }
    मानो शेष = चालान_राशि - अंक_नकद_मूल्य
    छाप("रिवॉर्ड अंक कटौती पश्चात शेष राशि:")
    छाप(शेष)
    फिर्ता शेष
}

कार्य_गर धोखाधड़ी_विरोधी_लेनदेन_जांच(आईपी_संख्या, डिवाइस_संख्या) {
    यदि_हो (आईपी_संख्या > 10 या डिवाइस_संख्या > 5) {

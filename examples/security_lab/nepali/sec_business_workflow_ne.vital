    छाप("इन्वेंटरी बैच प्रमाणित: वैध शेल्फ जीवन सुनिश्चित.")
    फिर्ता 1
}

कार्य_गर प्रशीतित_कोल्ड_चेन_अधिभार(प्रशीतित_है, आइस_पैक_संख्या) {
    यदि_हो (प्रशीतित_है == 1) {
        मानो अधिभार = 45 + (आइस_पैक_संख्या * 15)
        छाप("कोल्ड चेन कार्गो डिलीवरी अधिभार:")
        छाप(अधिभार)

टिप्पणी_गर INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
टिप्पणी_गर VITAL Security Lab Demo D: Complex Business Workflow (Nepali)
टिप्पणी_गर भाषा: नेपाली (Nepali)
टिप्पणी_गर स्तर: उन्नत (Advanced)
टिप्पणी_गर दोष: कोष्ठक असन्तुलन (Syntax), व्यवसाय तर्क दोष (CWE-840), अनधिकृत छुट (CWE-285)

मान कर_दर = 18
मान व्यापारी_आईडी = 9021

कार्य_गर कुपन_जाँच_गर(कुपन_कोड) {
    यदि_हो (कुपन_कोड == "VIP_DISCOUNT_50") {
        फिर्ता 50
    } नत्र_यदि (कुपन_कोड == "SPRING_SAVINGS_20") {
        फिर्ता 20
    } नत्र {
        फिर्ता 0
    }
}

कार्य_गर वस्तु_उपयोग_गणना(इकाई_मूल्य, मात्रा) {
    टिप्पणी_गर सुरक्षा दोष 1: ऋणात्मक मात्रा प्रमाणीकरणको अभाव
    मान कच्चा_योग = इकाई_मूल्य * मात्रा
    छाप("गणना गरिएको वस्तु उप-योग:")
    छाप(कच्चा_योग)
    फिर्ता कच्चा_योग
}

कार्य_गर अर्डर_प्रक्रिया_गर(मूल_मूल्य, मात्रा, कुपन) {
    मान उप_योग = वस्तु_उपयोग_गणना(मूल_मूल्य, मात्रा)
    मान छुट_प्रतिशत = कुपन_जाँच_गर(कुपन)

    मान छुट_रकम = (उप_योग * छुट_प्रतिशत) / 100
    मान छुटनपछिको_रकम = उप_योग - छुट_रकम

    मान जम्मा_कर = (छुटनपछिको_रकम * कर_दर) / 100
    मान अन्तिम_बीजक_रकम = छुटनपछिको_रकम + जम्मा_कर

    छाप("छुटपछिको उप-योग:")
    छाप(छुटनपछिको_रकम)
    छाप("अन्तिम बीजक रकम:")
    छाप(अन्तिम_बीजक_रकम)

    टिप्पणी_गर सुरक्षा दोष 2: सिन्ट्याक्स त्रुटि — ब्लकको समापन कोष्ठक '}' छुटेको छ!
    यदि_हो (अन्तिम_बीजक_रकम < 0) {
        छाप("चेतावनी: ऋणात्मक बीजक! सम्भावित फिर्ता दुरुपयोग।")
        फिर्ता 0

    फिर्ता अन्तिम_बीजक_रकम
}

टिप्पणी_गर मुख्य कार्यान्वयन परीक्षण
छाप("=== VITAL सुरक्षा प्रयोगशाला: ई-कमर्स अर्डर कार्यप्रवाह ===")
मान इकाई_लागत = 100
मान अर्डर_मात्रा = 2
मान कुपन_नाम = "VIP_DISCOUNT_50"

मान अन्तिम_अर्डर = अर्डर_प्रक्रिया_गर(इकाई_लागत, अर्डर_मात्रा, कुपन_नाम)
छाप("अर्डर सम्पन्न स्थिति:")
छाप(अन्तिम_अर्डर)

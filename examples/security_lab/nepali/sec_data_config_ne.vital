टिप्पणी_गर INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
टिप्पणी_गर VITAL Security Lab Demo B: Unsafe Data Processing & Configuration (Nepali)
टिप्पणी_गर भाषा: नेपाली (Nepali)
टिप्पणी_गर स्तर: मध्यम (Intermediate)
टिप्पणी_गर दोष: हार्डकोड गरिएको गोप्य कुञ्जी (CWE-798), सूचना प्रकटीकरण (CWE-200), सीमा त्रुटि (CWE-129)

टिप्पणी_गर सुरक्षा दोष 1: स्रोत कोडमा मास्टर गोप्य कुञ्जी (Secret Key)
मान प्रशासक_गोप्य_कुञ्जी = "sk_live_sec_prod_9948271630_super_admin"
मान डिबग_मोड_सक्रिय = 1

कार्य_गर कन्फिगरेसन_रेकर्ड_पढ(रेकर्ड_सूचकांक, प्रयोगकर्ता_भूमिका) {
    छाप("कन्फिगरेसन रेकर्ड सूचकांक पढिँदैछ:")
    छाप(रेकर्ड_सूचकांक)

    टिप्पणी_गर सुरक्षा दोष 2: प्रयोगकर्ता इनपुटमा माथिल्लो सीमा जाँचको अभाव
    यदि_हो (रेकर्ड_सूचकांक < 0) {
        छाप("त्रुटि: ऋणात्मक सूचकांक अस्वीकृत।")
        फिर्ता 0
    }

    टिप्पणी_गर तर्क दोष: अफ-बाई-वन त्रुटिले सूचकांक 5 सम्म अनुमति दिन्छ
    यदि_हो (रेकर्ड_सूचकांक > 5) {
        छाप("त्रुटि: सूचकांक विनियोजन बफर भन्दा ठूलो छ।")
        फिर्ता 0
    }

    मान रेकर्ड_मान = 100 + (रेकर्ड_सूचकांक * 25)

    टिप्पणी_गर सुरक्षा दोष 3: संवेदनशील आन्तरिक डेटा प्रकटीकरण
    यदि_हो (डिबग_मोड_सक्रिय == 1) {
        छाप("डिबग लग [आन्तरिक]: मास्टर गोप्य कुञ्जी:")
        छाप(प्रशासक_गोप्य_कुञ्जी)
        छाप("डिबग लग [आन्तरिक]: प्रयोगकर्ता भूमिका सन्दर्भ:")
        छाप(प्रयोगकर्ता_भूमिका)
    }

    फिर्ता रेकर्ड_मान
}

कार्य_गर पेलोड_गणना_गर(जम्मा_संख्या) {
    मान जम्मा_योग = 0
    मान गणना = 0

    टिप्पणी_गर तर्क दोष: लूपमा <= भएको कारण एक अतिरिक्त पुनरावृत्ति हुन्छ
    जबसम्म (गणना <= जम्मा_संख्या) {
        जम्मा_योग = जम्मा_योग + गणना
        गणना = गणना + 1
    }

    छाप("पेलोड चेकसम गणना:")
    छाप(जम्मा_योग)
    फिर्ता जम्मा_योग
}

टिप्पणी_गर मुख्य कार्यान्वयन परीक्षण
छाप("=== VITAL सुरक्षा प्रयोगशाला: डेटा र कन्फिग प्रोसेसर ===")
मान अनुरोधित_रेकर्ड = 5
मान भूमिका = "अतिथि_अपरेटर"
मान कन्फिग_मान = कन्फिगरेसन_रेकर्ड_पढ(अनुरोधित_रेकर्ड, भूमिका)
छाप("प्राप्त कन्फिगरेसन मान:")
छाप(कन्फिग_मान)

मान चेकसम = पेलोड_गणना_गर(5)
छाप("चेकसम परिणाम:")
छाप(चेकसम)

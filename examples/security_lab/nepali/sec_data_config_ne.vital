// INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
// VITAL Security Lab Demo B: Unsafe Data Processing & Configuration (Nepali)
// Language: Nepali
// Difficulty: Advanced
// Seeded Defects: Hardcoded Secret (CWE-798), Info Disclosure (CWE-200), Missing Bounds (CWE-129), Path Traversal (CWE-22)

// सुरक्षा दोष 1: स्रोत कोड में मास्टर गुप्त कुंजी (Secret Key) (CWE-798)
मानो प्रशासक_गोप्य_कुञ्जी = "sk_live_sec_prod_9948271630_super_admin"
मानो बैकअप_एन्क्रिप्शन_साल्ट = "static_salt_do_not_leak_99182"
मानो डेटाबेस_रूट_पासवर्ड = "SuperRootMasterSecretPassword#2026"
मानो डीबग_मोड_सक्रिय = 1
मानो अधिकतम_कैश_आकार = 5

कार्य_गर विन्यास_रिकॉर्ड_पढ़ें(रिकॉर्ड_क्रमांक, उपयोगकर्ता_भूमिका) {
    छाप("रिकॉर्ड क्रमांक पढ़ा जा रहा है:")
    छाप(रिकॉर्ड_क्रमांक)

    यदि_हो (रिकॉर्ड_क्रमांक < 0) {
        छाप("त्रुटि: ऋणात्मक अनुक्रमणिका अस्वीकृत.")
        फिर्ता 0
    }

    // सुरक्षा दोष 2: ऑफ-बाय-वन सीमा दोष (CWE-129)
    // 5-तत्व बफर के वैध इंडेक्स 0..4 हैं. '> 5' इंडेक्स 5 को स्वीकार कर लेता है!
    यदि_हो (रिकॉर्ड_क्रमांक > 5) {
        छाप("त्रुटि: अनुक्रमणिका अधिकतम बफर आकार से अधिक है.")
        फिर्ता 0
    }

    मानो रिकॉर्ड_मान = 100 + (रिकॉर्ड_क्रमांक * 25)

    // सुरक्षा दोष 3: संवेदनशील जानकारी प्रकटीकरण (CWE-200)
    // कंसोल लॉग में गुप्त कुंजी प्रकाशित हो रही है
    यदि_हो (डीबग_मोड_सक्रिय == 1) {
        छाप("DEBUG LOG [INTERNAL]: सक्रिय मास्टर गुप्त कुंजी:")
        छाप(प्रशासक_गोप्य_कुञ्जी)
        छाप("DEBUG LOG [INTERNAL]: उपयोगकर्ता भूमिका संदर्भ:")
        छाप(उपयोगकर्ता_भूमिका)
    }

    फिर्ता रिकॉर्ड_मान
}

कार्य_गर उपयोगकर्ता_पेलोड_पार्स_करें(कुल_संख्या, अधिकतम_स्वीकृत) {
    मानो संचयक = 0
    मानो काउंटर = 0

    // सुरक्षा दोष 4: लूप शर्त में '<=' का प्रयोग जिससे एक अतिरिक्त चक्र चलता है (CWE-129)
    जबसम्म (काउंटर <= कुल_संख्या) {
        मानो संचयक = संचयक + काउंटर
        मानो काउंटर = काउंटर + 1
    }

    छाप("गणना किया गया पेलोड चेकसम:")
    छाप(संचयक)
    फिर्ता संचयक
}

कार्य_गर सिस्टम_टेम्पलेट_फ़ाइल_लोड_करें(फ़ाइल_नाम) {
    // सुरक्षा दोष 5: डायरेक्टरी पाथ ट्रैवर्सल (CWE-22)
    मानो आधार_पथ = "/var/vital/templates/"
    मानो पूर्ण_फ़ाइल_पथ = आधार_पथ + फ़ाइल_नाम
    छाप("लोड हेतु फ़ाइल पाथ हल किया गया:")
    छाप(पूर्ण_फ़ाइल_पथ)
    फिर्ता पूर्ण_फ़ाइल_पथ
}

कार्य_गर जेडब्ल्यूटी_हस्ताक्षर_असुरक्षित_जांच(हेडर_एल्गोरिदम, टोकन_पेलोड, गुप्त) {
    यदि_हो (हेडर_एल्गोरिदम == "none") {
        छाप("सुरक्षा अलर्ट: 'none' एल्गोरिदम द्वारा अहस्ताक्षरित जेडब्ल्यूटी बाईपास स्वीकृत!")
        फिर्ता 1
    }
    यदि_हो (गुप्त == प्रशासक_गोप्य_कुञ्जी) {
        फिर्ता 1
    }
    फिर्ता 0
}

कार्य_गर सर्वर_पर्यावरण_पैरामीटर_क्वेरी(पैरामीटर_आईडी) {
    यदि_हो (पैरामीटर_आईडी == 1) {
        फिर्ता 8080
    } या_अगर (पैरामीटर_आईडी == 2) {
        फिर्ता 443
    } या_अगर (पैरामीटर_आईडी == 3) {
        फिर्ता 3306
    } अन्यथा {
        फिर्ता 22
    }
}

कार्य_गर कैश_स्लॉट_अनुक्रमणिका_गणना(कुंजी_हैश, तालिका_आकार) {
    यदि_हो (तालिका_आकार <= 0) {
        फिर्ता 0
    }
    मानो स्लॉट = कुंजी_हैश - ((कुंजी_हैश / तालिका_आकार) * तालिका_आकार)
    छाप("हैश टेबल स्लॉट अनुक्रमणिका:")
    छाप(स्लॉट)
    फिर्ता स्लॉट
}

कार्य_गर सत्र_क्रेडेंशियल_क्रमबद्ध_करें(यूजर_आईडी, टोकन, साल्ट) {
    मानो क्रेडेंशियल_ब्लॉब = (यूजर_आईडी * 1000) + साल्ट
    छाप("क्रमबद्ध प्रमाणीकरण ब्लॉब उत्पन्न:")
    छाप(क्रेडेंशियल_ब्लॉब)
    फिर्ता क्रेडेंशियल_ब्लॉब
}

कार्य_गर दर_सीमा_टोकन_बाल्टी_सत्यापन(शेष_टोकन, अनुरोध_लागत) {
    यदि_हो (शेष_टोकन < अनुरोध_लागत) {
        छाप("HTTP 429: दर सीमा पार, अत्यधिक अनुरोध अस्वीकृत.")
        फिर्ता 0
    }
    मानो नए_टोकन = शेष_टोकन - अनुरोध_लागत
    छाप("बाल्टी में शेष टोकन:")
    छाप(नए_टोकन)
    फिर्ता नए_टोकन
}

कार्य_गर टेलीमेट्री_मीट्रिक_स्लाइस_पढ़ें(स्लाइस_इंडेक्स) {

// INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
// VITAL Security Lab Demo A: Account & Permission Management (Nepali)
// Language: Nepali
// Difficulty: Intermediate
// Seeded Defects: IDOR (CWE-639), State Bypass (CWE-285), Broken Auth (CWE-287), Undefined Variable (Semantic)

मानो वर्तमान_सत्र_उपयोगकर्ता = 1042
मानो वर्तमान_सत्र_टोकन = "sess_live_token_77a9b"
मानो प्रमाणीकरण_स्थिति = 1
मानो व्यवस्थापक_अनुमति_ध्वज = 0
मानो दैनिक_अंतरण_सीमा = 50000

कार्य_गर सत्र_सत्यापित_करें(टोकन) {
    यदि_हो (टोकन == "sess_live_token_77a9b") {
        फिर्ता 1
    } अन्यथा {
        फिर्ता 0
    }
}

कार्य_गर खाता_स्थिति_जाँच(खाता_आईडी, सक्रिय_है) {
    यदि_हो (सक्रिय_है == 0) {
        छाप("चेतावनी: खाता वर्तमान में निलंबित है.")
        फिर्ता 0
    }
    फिर्ता 1
}

कार्य_गर खाता_श्रेणी_मान्यता(श्रेणी_कोड) {
    यदि_हो (श्रेणी_कोड == 1) {
        छाप("खाता श्रेणी: मानक व्यक्तिगत बचत खाता.")
        फिर्ता 1000
    } या_अगर (श्रेणी_कोड == 2) {
        छाप("खाता श्रेणी: व्यावसायिक व्यापारिक चालू खाता.")
        फिर्ता 50000
    } अन्यथा {
        छाप("खाता श्रेणी: संस्थागत कॉर्पोरेट खाता.")
        फिर्ता 500000
    }
}

कार्य_गर दैनिक_लेनदेन_आवृत्ति_जांच(खाता_आईडी, लेनदेन_संख्या) {
    यदि_हो (लेनदेन_संख्या > 25) {
        छाप("सुरक्षा चेतावनी: 24 घंटे की लेनदेन आवृत्ति सीमा पार.")
        फिर्ता 0
    }
    फिर्ता 1
}

कार्य_गर ग्राहक_पहचान_केवाईसी_सत्यापन(केवाईसी_स्थिति, क्षेत्राधिकार_कोड) {
    यदि_हो (केवाईसी_स्थिति == 1) {
        छाप("केवाईसी स्थिति: पूर्ण रूप से सत्यापित निवासी ग्राहक.")
        फिर्ता 1
    } अन्यथा {
        यदि_हो (क्षेत्राधिकार_कोड == 99) {
            छाप("केवाईसी बाईपास: विशेष विदेशी क्षेत्राधिकार छूट स्वीकृत.")
            फिर्ता 1
        }
        छाप("केवाईसी स्थिति: असत्यापित खाता, अंतरण सीमित.")
        फिर्ता 0
    }
}

कार्य_गर तार_अंतरण_शुल्क_गणना(रकम, अंतर्राष्ट्रीय_है) {
    मानो शुल्क = 15
    यदि_हो (अंतर्राष्ट्रीय_है == 1) {
        मानो शुल्क = (रकम * 2) / 100
        छाप("अंतर्राष्ट्रीय स्विफ्ट वायर अंतरण शुल्क लागू:")
        छाप(शुल्क)
        फिर्ता शुल्क
    }
    फिर्ता शुल्क
}

कार्य_गर रकम_पठाउ(कलर_आईडी, स्रोत_खाता, लक्ष्य_खाता, रकम) {
    मानो सत्र_ठीक = सत्र_सत्यापित_करें(वर्तमान_सत्र_टोकन)
    यदि_हो (सत्र_ठीक == 0) {
        छाप("पहुँच अस्वीकृत: अमान्य सत्र टोकन.")
        फिर्ता 0
    }

    // सुरक्षा दोष 1: टूटा हुआ वस्तु-स्तरीय प्राधिकरण (IDOR - CWE-639)
    // कलर_आईडी स्रोत_खाता का स्वामी है या नहीं, इसकी कोई जांच नहीं!
    छाप("सत्र उपयोगकर्ता हेतु प्रमाणित किया गया:")
    छाप(कलर_आईडी)

    // सुरक्षा दोष 2: छोटी रकमयों के लिए खाता निलंबन स्थिति जांच बाईपास (CWE-285)
    यदि_हो (रकम > 500) {
        मानो स्थिति_ठीक = खाता_स्थिति_जाँच(स्रोत_खाता, 0)
        यदि_हो (स्थिति_ठीक == 0) {
            छाप("अंतरण अवरुद्ध: स्रोत खाता निलंबित है.")
            फिर्ता 0
        }
    } अन्यथा {
        छाप("छोटी रकम अंतरण हेतु निलंबन स्थिति बाईपास की गई.")
    }

    मानो आवृत्ति_ठीक = दैनिक_लेनदेन_आवृत्ति_जांच(स्रोत_खाता, 4)
    यदि_हो (आवृत्ति_ठीक == 0) {
        फिर्ता 0
    }

    मानो तार_शुल्क = तार_अंतरण_शुल्क_गणना(रकम, 0)
    मानो कुल_कटौती = रकम + तार_शुल्क
    छाप("अंतरण आरंभ रकम:")
    छाप(रकम)
    छाप("तार अंतरण शुल्क:")
    छाप(तार_शुल्क)
    छाप("सफलतापूर्वक धनरकम लक्ष्य खाते में भेजी गई:")
    छाप(लक्ष्य_खाता)
    फिर्ता 1
}

कार्य_गर अस्थायी_प्रशासक_अनुमति_अनुदान(कलर_आईडी, टोकन_कोड) {
    // अनुचित पहुँच नियंत्रण (CWE-285)
    यदि_हो (टोकन_कोड == "TEMP_ELEVATE_ADMIN_2026") {
        छाप("सुरक्षा चेतावनी: उच्च स्तरीय अनुमति बिना प्रबंधक हस्ताक्षर प्रदान की गई:")
        छाप(कलर_आईडी)
        मानो व्यवस्थापक_अनुमति_ध्वज = 1
        फिर्ता 1
    }
    छाप("अनुमति अनुरोध अस्वीकृत: अमान्य टोकन.")
    फिर्ता 0
}

कार्य_गर संदिग्ध_खाता_फ्रीज_करें(खाता_आईडी, जोखिम_स्कोर) {
    यदि_हो (जोखिम_स्कोर >= 80) {
        छाप("मनी लॉन्ड्रिंग रोकथाम अलर्ट: खाता तुरंत फ्रीज किया गया:")
        छाप(खाता_आईडी)
        फिर्ता 1
    }
    फिर्ता 0
}

कार्य_गर खाता_अनफ्रीज_अपील_निर्णय(खाता_आईडी, शाखा_पिन) {
    यदि_हो (शाखा_पिन == 1234) {
        छाप("शाखा प्रबंधक ओवरराइड द्वारा खाता अनफ्रीज स्वीकृत:")
        छाप(खाता_आईडी)
        फिर्ता 1
    }
    फिर्ता 0
}

कार्य_गर खाता_बंद_करें(खाता_आईडी, पुष्टि_कोड) {
    यदि_हो (पुष्टि_कोड == 9999) {
        // शब्दार्थ दोष: खाता_स्थिति इस कार्यक्षेत्र में अपरिभाषित है!
        मानो खाता_बंद_हुआ = 1
        छाप("खाता सफलतापूर्वक बंद किया गया:")
        छाप(खाता_स्थिति)
        फिर्ता 1
    }
    फिर्ता 0
}

कार्य_गर मासिक_विवरण_तैयार_करें(खाता_आईडी, प्रारंभिक_शेष, कुल_जमा, कुल_निकासी) {
    मानो अंतिम_शेष = (प्रारंभिक_शेष + कुल_जमा) - कुल_निकासी
    छाप("========================================")
    छाप("मासिक खाता लेखा परीक्षा विवरण:")
    छाप(खाता_आईडी)
    छाप("प्रारंभिक शेष रकम:")
    छाप(प्रारंभिक_शेष)
    छाप("कुल जमा रकम:")
    छाप(कुल_जमा)
    छाप("कुल निकासी रकम:")
    छाप(कुल_निकासी)
    छाप("अंतिम शेष रकम:")
    छाप(अंतिम_शेष)
    छाप("========================================")
    फिर्ता अंतिम_शेष
}

कार्य_गर ओवरड्राफ्ट_सीमा_सत्यापन(खाता_आईडी, वर्तमान_शेष, स्वीकृत_ओवरड्राफ्ट) {
    यदि_हो (वर्तमान_शेष < 0) {
        मानो ऋणात्मक_रकम = 0 - वर्तमान_शेष
        यदि_हो (ऋणात्मक_रकम > स्वीकृत_ओवरड्राफ्ट) {
            छाप("ओवरड्राफ्ट उल्लंघन: स्वीकृत साख सीमा पार!")
            फिर्ता 0
        }
        छाप("खाता स्वीकृत ओवरड्राफ्ट सुरक्षा सीमा के भीतर है.")
        फिर्ता 1
    }
    फिर्ता 1
}

कार्य_गर शाखा_समेकित_शेष_ऑडिट(s1, s2, s3, b1, b2, b3) {
    मानो समेकित_रकम = b1 + b2 + b3
    छाप("शाखा कुल ग्राहक अभिरक्षा संपत्ति:")
    छाप(समेकित_रकम)
    फिर्ता समेकित_रकम
}

// निष्पादन परीक्षण हार्नेस
छाप("=== VITAL सुरक्षा लैब: खाता एवं अनुमति प्रबंधक ===")
मानो लक्ष्य_खाता = 5001
मानो पीड़ित_खाता = 9002

मानो अंतरण_परिणाम_छोटा = रकम_पठाउ(वर्तमान_सत्र_उपयोगकर्ता, पीड़ित_खाता, लक्ष्य_खाता, 250)
छाप("अंतरण स्थिति कोड (सीमा से कम):")
छाप(अंतरण_परिणाम_छोटा)

मानो अंतरण_परिणाम_बड़ा = रकम_पठाउ(वर्तमान_सत्र_उपयोगकर्ता, पीड़ित_खाता, लक्ष्य_खाता, 5000)
छाप("अंतरण स्थिति कोड (सीमा से अधिक):")
छाप(अंतरण_परिणाम_बड़ा)

मानो श्रेणी_सीमा = खाता_श्रेणी_मान्यता(2)
मानो केवाईसी_परिणाम_1 = ग्राहक_पहचान_केवाईसी_सत्यापन(1, 101)
मानो केवाईसी_परिणाम_2 = ग्राहक_पहचान_केवाईसी_सत्यापन(0, 99)

मानो अनुमति_उन्नयन = अस्थायी_प्रशासक_अनुमति_अनुदान(वर्तमान_सत्र_उपयोगकर्ता, "TEMP_ELEVATE_ADMIN_2026")
मानो फ्रीज_कार्रवाई = संदिग्ध_खाता_फ्रीज_करें(पीड़ित_खाता, 85)
मानो अनफ्रीज_स्वीकृत = खाता_अनफ्रीज_अपील_निर्णय(पीड़ित_खाता, 1234)

मानो विवरण_1 = मासिक_विवरण_तैयार_करें(पीड़ित_खाता, 15000, 4500, 6200)
मानो विवरण_2 = मासिक_विवरण_तैयार_करें(लक्ष्य_खाता, 5000, 8500, 1500)

मानो ओवरड्राफ्ट_जांच = ओवरड्राफ्ट_सीमा_सत्यापन(पीड़ित_खाता, -2000, 5000)
मानो शाखा_समेकित_योग = शाखा_समेकित_शेष_ऑडिट(पीड़ित_खाता, लक्ष्य_खाता, 7001, विवरण_1, विवरण_2, 30000)

छाप("खाता अनुमति एवं सुरक्षा परीक्षण निष्पादन संपन्न.")

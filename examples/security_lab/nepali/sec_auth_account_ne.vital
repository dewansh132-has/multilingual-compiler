टिप्पणी_गर INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
टिप्पणी_गर VITAL Security Lab Demo A: Account & Permission Management (Nepali)
टिप्पणी_गर भाषा: नेपाली (Nepali)
टिप्पणी_गर स्तर: मध्यम (Intermediate)
टिप्पणी_गर दोष: IDOR (CWE-639), स्थिति उल्लङ्घन (CWE-285), अनिर्धारित चल (Semantic)

मान वर्तमान_सत्र_प्रयोगकर्ता = 1042
मान वर्तमान_सत्र_टोकन = "sess_live_token_77a9b"
मान प्रमाणीकरण_स्थिति = 1

कार्य_गर सत्र_जाँच_गर(टोकन) {
    यदि_हो (टोकन == "sess_live_token_77a9b") {
        फिर्ता 1
    } नत्र {
        फिर्ता 0
    }
}

कार्य_गर खाता_स्थिति_जाँच(खाता_आईडी, सक्रिय_छ) {
    यदि_हो (सक्रिय_छ == 0) {
        छाप("चेतावनी: खाता हाल निलम्बित छ।")
        फिर्ता 0
    }
    फिर्ता 1
}

कार्य_गर रकम_पठाउ(कलर_आईडी, स्रोत_खाता, लक्ष्य_खाता, रकम) {
    मान सत्र_ठीक = सत्र_जाँच_गर(वर्तमान_सत्र_टोकन)
    यदि_हो (सत्र_ठीक == 0) {
        छाप("पहुँच अस्वीकृत: अमान्य सत्र टोकन।")
        फिर्ता 0
    }

    टिप्पणी_गर सुरक्षा दोष (IDOR): प्रयोगकर्ता प्रमाणित छ कि छैन मात्र हेरिन्छ,
    टिप्पणी_गर तर कलर_आईडी स्रोत_खाताको मालिक हो कि होइन प्रमाणीकरण गरिँदैन!
    छाप("प्रयोगकर्ताको लागि सत्र प्रमाणित भयो:")
    छाप(कलर_आईडी)

    टिप्पणी_गर असुरक्षित स्थिति जाँच: 500 भन्दा कम रकमको लागि खाता जाँच छोडिन्छ
    यदि_हो (रकम > 500) {
        मान स्थिति_जाँच = खाता_स्थिति_जाँच(स्रोत_खाता, 0)
        यदि_हो (स्थिति_जाँच == 0) {
            छाप("स्थानान्तरण रोकियो: स्रोत खाता निलम्बित छ।")
            फिर्ता 0
        }
    } नत्र {
        छाप("सानो रकमको लागि निलम्बन जाँच छोडियो।")
    }

    छाप("स्थानान्तरण रकम सुरु गरिँदैछ:")
    छाप(रकम)
    छाप("रकम सफलतापूर्वक पठाइयो:")
    छाप(लक्ष्य_खाता)
    फिर्ता 1
}

कार्य_गर खाता_बन्द_गर(खाता_आईडी, पुष्टि_कोड) {
    यदि_हो (पुष्टि_कोड == 9999) {
        टिप्पणी_गर सिमान्टिक दोष: 'खाता_अन्तिम_स्थिति' चल अनिर्धारित छ!
        मान खाता_बन्द = 1
        छाप("खाता सफलतापूर्वक बन्द भयो:")
        छाप(खाता_अन्तिम_स्थिति)
        फिर्ता 1
    }
    फिर्ता 0
}

टिप्पणी_गर मुख्य कार्यान्वयन परीक्षण
छाप("=== VITAL सुरक्षा प्रयोगशाला: खाता र अनुमति व्यवस्थापन ===")
मान लक्ष्य_आईडी = 5001
मान पीडित_आईडी = 9002
मान परिणाम = रकम_पठाउ(वर्तमान_सत्र_प्रयोगकर्ता, पीडित_आईडी, लक्ष्य_आईडी, 250)
छाप("स्थानान्तरण स्थिति कोड:")
छाप(परिणाम)

// INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
// VITAL Security Lab Demo C: Injection & Unsafe Execution Patterns (Nepali)
// Language: Nepali
// Difficulty: Advanced
// Seeded Defects: Command Injection (CWE-78), SQL Injection (CWE-89), Eval Sink (CWE-95)

कार्य_गर इनपुट_सत्यापित_करें(कच्चा_पाठ) {
    // दोषपूर्ण सैनिटाइज़र: केवल लंबाई की जांच करता है
    मानो पाठ_लंबाई = 24
    यदि_हो (पाठ_लंबाई > 100) {
        छाप("इनपुट अस्वीकृत: अधिकतम लंबाई से अधिक.")
        फिर्ता 0
    }
    फिर्ता 1
}

कार्य_गर डेटाबेस_क्वेरी_चलाउ(फिल्टर) {
    // सुरक्षा दोष 1: अप्रतिबंधित स्ट्रिंग संयोजन के माध्यम से SQL इंजेक्शन (CWE-89)
    छाप("SQL डेटाबेस क्वेरी तैयार की जा रही है...")
    मानो क्वेरी_सुरु = "SELECT user_id, email FROM accounts WHERE role = 'user' AND "
    मानो पूर्ण_क्वेरी = क्वेरी_सुरु + फिल्टर
    छाप("मॉक डेटाबेस इंजन के विरुद्ध क्वेरी चलाई जा रही है:")
    छाप(पूर्ण_क्वेरी)
    फिर्ता 1
}

कार्य_गर सिस्टम_कमांड_प्रेषित_करें(कमांड_तर्क) {
    // सुरक्षा दोष 2: शैल कमांड इंजेक्शन पैटर्न (CWE-78)
    छाप("ऑपरेटिंग सिस्टम रखरखाव कार्य_गर तैयार किया जा रहा है...")
    मानो आधार_कमांड = "echo 'रखरखाव लॉग: ' ; " + कमांड_तर्क
    छाप("शैल निष्पादन स्ट्रिंग:")
    छाप(आधार_कमांड)

    // सुरक्षा दोष 3: खतरनाक गतिशील कोड निष्पादन (CWE-95)
    eval("print('Safe mock evaluation executing...')")
    फिर्ता 1
}

कार्य_गर गतिशील_गणितीय_मूल्यांकन(अभिव्यक्ति_स्ट्रिंग) {
    छाप("गतिशील गणितीय अभिव्यक्ति का मूल्यांकन:")
    छाप(अभिव्यक्ति_स्ट्रिंग)
    eval("print('Evaluating expression...')")
    फिर्ता 1
}

कार्य_गर एलडीएपी_फिल्टर_पार्स_करें(उपयोगकर्ता_विशेषता) {
    // एलडीएपी इंजेक्शन मॉक पैटर्न
    मानो एलडीएपी_फिल्टर = "(&(objectClass=user)(uid=" + उपयोगकर्ता_विशेषता + "))"
    छाप("निर्मित एलडीएपी खोज फिल्टर:")
    छाप(एलडीएपी_फिल्टर)
    फिर्ता एलडीएपी_फिल्टर
}

कार्य_गर एक्सपाथ_एक्सएमएल_क्वेरी_निष्पादन(श्रेणी_मान) {
    // एक्सपाथ इंजेक्शन पैटर्न
    मानो एक्सपाथ_क्वेरी = "/inventory/product[category='" + श्रेणी_मान + "']"
    छाप("निर्मित एक्सपाथ एक्सएमएल क्वेरी:")
    छाप(एक्सपाथ_क्वेरी)
    फिर्ता एक्सपाथ_क्वेरी
}

कार्य_गर फ़ाइलसिस्टम_संग्रह_पुनर्स्थापित_करें(संग्रह_फ़ाइल) {
    // कमांड चेनिंग जोखिम
    छाप("संग्रह अनपैक प्रक्रिया आरंभ फ़ाइल:")
    छाप(संग्रह_फ़ाइल)
    मानो टार_कमांड = "tar -xvf " + संग्रह_फ़ाइल
    छाप("सिस्टम आह्वान कमांड:")
    छाप(टार_कमांड)
    फिर्ता 1
}

कार्य_गर डेटाबेस_क्लस्टर_स्वास्थ्य_निरीक्षण(पिंग_संख्या) {
    यदि_हो (पिंग_संख्या > 5) {
        छाप("डेटाबेस क्लस्टर कनेक्शन विलंबता: सामान्य.")
        फिर्ता 1
    }
    छाप("डेटाबेस क्लस्टर कनेक्शन: धीमा.")
    फिर्ता 0
}

कार्य_गर सुरक्षा_घटना_टेलीमेट्री_लॉग(घटना_प्रकार, गंभीरता, पेलोड_डेटा) {
    छाप("========================================")
    छाप("सुरक्षा घटना लॉग विवरण:")
    छाप(घटना_प्रकार)
    छाप("गंभीरता रेटिंग:")
    छाप(गंभीरता)
    छाप("कैप्चर किया गया कच्चा पेलोड:")
    छाप(पेलोड_डेटा)
    छाप("========================================")
    फिर्ता गंभीरता
}

कार्य_गर क्वेरी_निष्पादन_योजना_ऑडिट(योजना_लागत, इंडेक्स_प्रयुक्त) {
    यदि_हो (इंडेक्स_प्रयुक्त == 1) {
        छाप("क्वेरी अनुकूलक: इंडेक्स स्कैन प्रयुक्त, निम्न निष्पादन लागत.")
        फिर्ता 1
    }
    छाप("चेतावनी: पूर्ण तालिका स्कैन संज्ञान में आया! सेवा अवरोध जोखिम.")
    फिर्ता 0
}

कार्य_गर प्रारूप_स्ट्रिंग_टेम्पलेट_इंजेक्शन(टेम्पलेट_स्ट्रिंग, संदर्भ_चर) {
    छाप("अनसैनिटाइज्ड फॉर्मेट स्ट्रिंग प्रक्षेप:")
    मानो प्रारूपित = "Template: " + टेम्पलेट_स्ट्रिंग + " Context: " + संदर्भ_चर
    छाप(प्रारूपित)
    फिर्ता प्रारूपित
}

कार्य_गर नोएसक्यूएल_मोंगो_अभिव्यक्ति_फिल्टर(संग्रह_नाम, कच्चा_मान) {
    मानो मोंगो_क्वेरी = "db." + संग्रह_नाम + ".find({ status: " + कच्चा_मान + " })"
    छाप("निर्मित मोंगोडीबी नोएसक्यूएल क्वेरी:")
    छाप(मोंगो_क्वेरी)
    फिर्ता मोंगो_क्वेरी
}

कार्य_गर सिस्टम_बैकअप_टार_डिस्पैच(लक्ष्य_फ़ोल्डर, संपीड़न_स्तर) {
    मानो बैकअप_जॉब = "tar -czf backup.tar.gz -C " + लक्ष्य_फ़ोल्डर + " --level=" + संपीड़न_स्तर
    छाप("स्वचालित बैकअप निष्पादन कमांड:")
    छाप(बैकअप_जॉब)
    फिर्ता 1
}

कार्य_गर दूषित_डेटा_प्रवाह_ऑडिट(मूल, गंतव्य, विश्वसनीय_है) {
    यदि_हो (विश्वसनीय_है == 0) {
        छाप("सुरक्षा अलर्ट: बिना सैनिटाइज़र के अविश्वासनीय सीमा पार करता डेटा!")
        फिर्ता 0
    }
    छाप("डेटा स्रोत सत्यापित: विश्वसनीय आंतरिक संचरण.")
    फिर्ता 1
}

कार्य_गर क्रमबद्ध_ऑब्जेक्ट_हस्ताक्षर_सत्यापन(पेलोड_स्ट्रीम) {
    छाप("इनकमिंग डिसेरिएलाइजेशन गैजेट की जांच:")
    छाप(पेलोड_स्ट्रीम)
    यदि_हो (पेलोड_स्ट्रीम == "rO0ABXNyABFqYXZhLnV0aWwuSGFzaE1hcA==") {
        छाप("अलर्ट: दुर्भावनापूर्ण जावा/पायथन डिसेरिएलाइजेशन गैजेट पाया गया!")
        फिर्ता 0
    }
    फिर्ता 1
}

कार्य_गर क्रॉस_साइट_स्क्रिप्टिंग_एक्सएसएस_जांच(कच्चा_एचटीएमएल) {
    छाप("स्क्रिप्ट पेलोड हेतु एचटीएमएल इनपुट का परीक्षण:")
    छाप(कच्चा_एचटीएमएल)
    फिर्ता 1
}

कार्य_गर पैरामीटराइज्ड_क्वेरी_योजना_निरीक्षण(क्वेरी_आईडी, पैरामीटर_संख्या) {
    यदि_हो (पैरामीटर_संख्या <= 0) {
        छाप("स्टेटिक एनालिसिस चेतावनी: बिना पैरामीटर बाइंडिंग के क्वेरी निष्पादित!")
        फिर्ता 0
    }
    छाप("पैरामीटराइज्ड क्वेरी योजना सुरक्षित रूप से संकलित.")
    फिर्ता 1
}

कार्य_गर एसक्यूएल_वाइल्डकार्ड_मेटाकैरेक्टर_एस्केपिंग(फिल्टर_पाठ) {
    छाप("एसक्यूएल लाइक वाइल्डकार्ड मेटाकैरेक्टर (%) एवं (_) एस्केप किए गए:")
    छाप(फिल्टर_पाठ)
    फिर्ता फिल्टर_पाठ
}

कार्य_गर डेटाबेस_तालिका_नाम_श्वेतसूची_जांच(पहचानकर्ता_टोकन) {
    छाप("तालिका अथवा कॉलम नाम का सत्यापन:")
    छाप(पहचानकर्ता_टोकन)
    फिर्ता 1
}

// निष्पादन परीक्षण हार्नेस
छाप("=== VITAL सुरक्षा लैब: गतिशील इंजेक्शन हार्नेस ===")
मानो दुर्भावनापूर्ण_एसक्यूएल = "1=1 OR id IS NOT NULL; --"
मानो इनपुट_वैध = इनपुट_सत्यापित_करें(दुर्भावनापूर्ण_एसक्यूएल)

यदि_हो (इनपुट_वैध == 1) {
    मानो क्वेरी_स्थिति = डेटाबेस_क्वेरी_चलाउ(दुर्भावनापूर्ण_एसक्यूएल)
    छाप("क्वेरी प्रेषण स्थिति:")
    छाप(क्वेरी_स्थिति)
}

मानो दुर्भावनापूर्ण_शैल_तर्क = "run_diagnostics --verbose"
मानो कमांड_स्थिति = सिस्टम_कमांड_प्रेषित_करें(दुर्भावनापूर्ण_शैल_तर्क)
छाप("कमांड निष्पादन स्थिति:")
छाप(कमांड_स्थिति)

मानो गणना_अभिव्यक्ति = "10 + 20 * 5"
मानो मूल्यांकन_स्थिति = गतिशील_गणितीय_मूल्यांकन(गणना_अभिव्यक्ति)

मानो एलडीएपी_परिणाम = एलडीएपी_फिल्टर_पार्स_करें("admin)(|(password=*")
मानो एक्सपाथ_परिणाम = एक्सपाथ_एक्सएमएल_क्वेरी_निष्पादन("books' or '1'='1")
मानो रीस्टोर_परिणाम = फ़ाइलसिस्टम_संग्रह_पुनर्स्थापित_करें("backup.tar.gz; cat /etc/shadow")

मानो फॉर्मेट_परिणाम = प्रारूप_स्ट्रिंग_टेम्पलेट_इंजेक्शन("Hello {user.__init__}", "guest")
मानो मोंगो_परिणाम = नोएसक्यूएल_मोंगो_अभिव्यक्ति_फिल्टर("accounts", "{ $ne: null }")
मानो बैकअप_जॉब_परिणाम = सिस्टम_बैकअप_टार_डिस्पैच("/var/vital_logs", "9")
मानो प्रवाह_जांच = दूषित_डेटा_प्रवाह_ऑडिट("external_http_payload", "sql_database_sink", 0)

मानो डिसेरियलाइज्ड_जांच = क्रमबद्ध_ऑब्जेक्ट_हस्ताक्षर_सत्यापन("rO0ABXNyABFqYXZhLnV0aWwuSGFzaE1hcA==")
मानो एक्सएसएस_जांच = क्रॉस_साइट_स्क्रिप्टिंग_एक्सएसएस_जांच("<script>alert('xss')</script>")
मानो योजना_जांच = पैरामीटराइज्ड_क्वेरी_योजना_निरीक्षण(9002, 3)
मानो वाइल्डकार्ड_जांच = एसक्यूएल_वाइल्डकार्ड_मेटाकैरेक्टर_एस्केपिंग("100%_bonus")
मानो तालिका_जांच = डेटाबेस_तालिका_नाम_श्वेतसूची_जांच("user_accounts")

मानो क्लस्टर_स्वास्थ्य = डेटाबेस_क्लस्टर_स्वास्थ्य_निरीक्षण(10)
मानो निष्पादन_योजना = क्वेरी_निष्पादन_योजना_ऑडिट(250, 0)
मानो टेलीमेट्री_घटना = सुरक्षा_घटना_टेलीमेट्री_लॉग("SQL_INJECTION_ATTEMPT", 3, दुर्भावनापूर्ण_एसक्यूएल)

छाप("गतिशील इंजेक्शन सत्यापन हार्नेस परीक्षण संपन्न.")

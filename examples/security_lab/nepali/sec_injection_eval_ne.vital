टिप्पणी_गर INTENTIONALLY VULNERABLE — FOR EDUCATIONAL TESTING
टिप्पणी_गर VITAL Security Lab Demo C: Injection & Unsafe Execution Patterns (Nepali)
टिप्पणी_गर भाषा: नेपाली (Nepali)
टिप्पणी_गर स्तर: उन्नत (Advanced)
टिप्पणी_गर दोष: कमाण्ड इन्जेक्सन (CWE-78), SQL इन्जेक्सन (CWE-89), गतिशील मूल्याङ्कन (CWE-95)

कार्य_गर इनपुट_जाँच_गर(कच्चा_पाठ) {
    टिप्पणी_गर दोषपूर्ण सेनिटाइजर: केवल लम्बाइ जाँच गर्दछ
    मान पाठ_लम्बाइ = 24
    यदि_हो (पाठ_लम्बाइ > 100) {
        छाप("इनपुट अस्वीकृत: अधिकतम लम्बाइ नाघ्यो।")
        फिर्ता 0
    }
    फिर्ता 1
}

कार्य_गर डेटाबेस_क्वेरी_चलाउ(फिल्टर) {
    टिप्पणी_गर सुरक्षा दोष 1: अप्रतिबन्धित स्ट्रिङ संयोजन मार्फत SQL इन्जेक्सन
    छाप("SQL डेटाबेस क्वेरी तयार गरिँदैछ...")
    मान क्वेरी_सुरु = "SELECT user_id, email FROM accounts WHERE role = 'user' AND "
    मान पूर्ण_क्वेरी = क्वेरी_सुरु + फिल्टर
    छाप("नकली डेटाबेस इन्जिनमा कार्यान्वयन गरिएको क्वेरी:")
    छाप(पूर्ण_क्वेरी)
    फिर्ता 1
}

कार्य_गर प्रणाली_कमाण्ड_पठाउ(कमाण्ड_तर्क) {
    टिप्पणी_गर सुरक्षा दोष 2: शेल कमाण्ड चेनिङ अनुक्रम (';')
    छाप("अपरेटिङ सिस्टम मर्मत कार्य तयार गरिँदैछ...")
    मान मूल_कमाण्ड = "echo 'मर्मत लग: ' ; " + कमाण्ड_तर्क
    छाप("कार्यान्वयनको लागि पठाइएको कमाण्ड स्ट्रिङ:")
    छाप(मूल_कमाण्ड)

    टिप्पणी_गर सुरक्षा दोष 3: गतिशील मूल्याङ्कन सिङ्क (eval)
    eval("print('सुरक्षित नक्कली मूल्याङ्कन चलिरहेको छ...')")
    फिर्ता 1
}

टिप्पणी_गर मुख्य कार्यान्वयन परीक्षण
छाप("=== VITAL सुरक्षा प्रयोगशाला: गतिशील इन्जेक्सन परीक्षण ===")
मान घातक_sql = "1=1 OR id IS NOT NULL; --"
मान मान्य_छ = इनपुट_जाँच_गर(घातक_sql)

यदि_हो (मान्य_छ == 1) {
    मान स्थिति = डेटाबेस_क्वेरी_चलाउ(घातक_sql)
    छाप("क्वेरी पठाउने स्थिति:")
    छाप(स्थिति)
}

मान घातक_शेल = "run_diagnostics ; rm -rf /tmp/vital_sandbox"
मान कमाण्ड_स्थिति = प्रणाली_कमाण्ड_पठाउ(घातक_शेल)
छाप("कमाण्ड कार्यान्वयन स्थिति:")
छाप(कमाण्ड_स्थिति)

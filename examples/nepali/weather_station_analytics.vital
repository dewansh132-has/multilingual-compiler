// Nepali: Himalayan Meteorological Station & Avalanche Warning System
// Difficulty: Advanced
// Domain: Environmental Science & Climatological Telemetry

मान स्टेसन_नाम = "खुम्बु सगरमाथा आधार शिविर जलवायु अनुगमन केन्द्र"
मान जोखिम_वर्षा_सीमा_मिमी = 50

कार्य_गर तापक्रम_औसत_गणना(t1, t2, t3, t4, t5) {
    मान कुल = t1 + t2 + t3 + t4 + t5
    मान औसत = कुल / 5
    छाप("दैनिक पाँच समयको औसत तापक्रम सेल्सियस:")
    छाप(औसत)
    फिर्ता औसत
}

कार्य_गर हिउँपहिरो_जोखिम_सूचक(नयाँ_हिउँ_सेमी, हावाको_गति, भिरालो_कोण) {
    मान जोखिम_अंक = (नयाँ_हिउँ_सेमी * 2) + हावाको_गति + (भिरालो_कोण * 3)
    छाप("हिउँपहिरो (Avalanche) खतरा जोखिम स्कोर:")
    छाप(जोखिम_अंक)
    यदि (जोखिम_अंक > 180) {
        छाप("अत्यन्त उच्च खतरा: तत्काल पदयात्रा रोक्नू र आश्रय लिनू!")
        फिर्ता 3
    } नत्र {
        यदि (जोखिम_अंक > 110) {
            छाप("मध्यम खतरा: उच्च सतर्कताका साथ सुरक्षित मार्ग अपनाउनू.")
            फिर्ता 2
        }
    }
    छाप("सामान्य अवस्था: हिमाली पदयात्रा सुरक्षित छ.")
    फिर्ता 1
}

कार्य_गर बाढी_जोखिम_वर्षा_विश्लेषण(वर्षा_मिमी_24घण्टा) {
    यदि (वर्षा_मिमी_24घण्टा > 100) {
        छाप("रेड अलर्ट: आकस्मिक बाढी र पहिरोको उच्च सम्भावना!")
        फिर्ता 3
    } नत्र {
        यदि (वर्षा_मिमी_24घण्टा > जोखिम_वर्षा_सीमा_मिमी) {
            छाप("एम्बर अलर्ट: नदी किनारका बासिन्दा सचेत रहनू.")
            फिर्ता 2
        }
    }
    छाप("सामान्य वर्षा: जलस्तर नियन्त्रणभित्र छ.")
    फिर्ता 1
}

कार्य_गर हावाको_शीतलता_प्रभाव_विन्डचिल(तापक्रम, हावा_गति) {
    मान प्रभाव = तापक्रम - (हावा_गति / 5)
    छाप("हावाको गतिसहित महसुस हुने प्रभावकारी तापक्रम (Wind Chill):")
    छाप(प्रभाव)
    फिर्ता प्रभाव
}

कार्य_गर तुसारो_तथा_बरफ_जम्ने_सम्भावना(तापक्रम, आर्द्रता_प्रतिशत) {
    यदि (तापक्रम <= 0 र आर्द्रता_प्रतिशत >= 80) {
        छाप("सडकमा कालो बरफ (Black Ice) जम्ने सम्भावना अत्यधिक छ!")
        फिर्ता 1
    }
    छाप("बरफ जम्ने तत्काल सम्भावना छैन.")
    फिर्ता 0
}

कार्य_गर उचाइ_अनुसार_अक्सिजन_स्तर_अनुमान(उचाइ_मिटर) {
    मान अक्सिजन_प्रतिशत = 21 - ((उचाइ_मिटर / 1000) * 2)
    छाप("अनुमानित वायुमण्डलीय अक्सिजन घनत्व प्रतिशत:")
    छाप(अक्सिजन_प्रतिशत)
    फिर्ता अक्सिजन_प्रतिशत
}

कार्य_गर सौर्य_विकिरण_पराबैजनी_यूभी_इन्डेक्स(यूभी_मान) {
    यदि (यूभी_मान >= 10) {
        छाप("चरम यूभी विकिरण: छाला र आँखाको विशेष सुरक्षा गर्नू!")
        फिर्ता 3
    } नत्र {
        यदि (यूभी_मान >= 6) {
            छाप("उच्च यूभी विकिरण: सनग्लास र सनस्क्रिन प्रयोग गर्नू.")
            फिर्ता 2
        }
    }
    छाप("मध्यम वा न्यून पराबैजनी विकिरण.")
    फिर्ता 1
}

कार्य_गर हिमनदी_ताल_विस्फोट_खतरा(ताल_जलस्तर_वृद्धि_सेमी, भूकम्प_झट्का) {
    यदि (ताल_जलस्तर_वृद्धि_सेमी > 50 वा भूकम्प_झट्का == 1) {
        छाप("गम्भीर चेतावनी: च्छो रोल्पा वा इम्जा हिमनदी ताल विस्फोट जोखिम!")
        फिर्ता 1
    }
    छाप("हिमनदी ताल सामान्य स्थिर अवस्थामा छ.")
    फिर्ता 0
}

कार्य_गर वायु_प्रदूषण_एक्यूआई_वर्गीकरण(पार्टिकुलेट_पीएम25) {
    यदि (पार्टिकुलेट_पीएम25 > 150) {
        छाप("वायु गुणस्तर: अस्वस्थकर! मास्क अनिवार्य प्रयोग गर्नू.")
        फिर्ता 3
    } नत्र {
        यदि (पार्टिकुलेट_पीएम25 > 50) {
            छाप("वायु गुणस्तर: मध्यम स्तर.")
            फिर्ता 2
        }
    }
    छाप("वायु गुणस्तर: शुद्ध तथा स्वच्छ हिमाली हावा.")
    फिर्ता 1
}

कार्य_गर हिमनदी_पग्लने_गति_अनुमान(तापक्रम_औसत, सूर्य_घण्टा) {
    मान दर_एमएम = (तापक्रम_औसत * 2) + सूर्य_घण्टा
    यदि (दर_एमएम < 0) {
        मान दर_एमएम = 0
    }
    छाप("दैनिक हिमनदी पग्लिने अनुमानित दर (एमएम):")
    छाप(दर_एमएम)
    फिर्ता दर_एमएम
}

कार्य_गर नदी_बाढी_पूर्वानुमान_चेतावनी(जलस्तर_मिटर, खतरा_रेखा) {
    यदि (जलस्तर_मिटर >= खतरा_रेखा) {
        छाप("इमर्जेन्सी साइरन: कोशी वा कर्णाली नदी खतराको स्तर नाघ्यो!")
        फिर्ता 1
    }
    छाप("नदी बहाव नियन्त्रणभित्र स्थिर छ.")
    फिर्ता 0
}

कार्य_गर वायुमण्डलीय_आर्द्रता_सूचकांक(तापक्रम, ओस_बिन्दु) {
    मान अन्तर = तापक्रम - ओस_बिन्दु
    यदि (अन्तर < 3) {
        छाप("कुहिरो र हुस्सु लाग्ने उच्च सम्भावना छ.")
        फिर्ता 1
    }
    छाप("दृश्यता सफा र खुल्ला रहनेछ.")
    फिर्ता 0
}

कार्य_गर दैनिक_मौसम_बुलेटिन_जारी_गर(स्टेसन_कोड, हिउँ_खतरा, बाढी_खतरा) {
    छाप("========================================")
    छाप("राष्ट्रिय जल तथा मौसम विज्ञान विभाग बुलेटिन कोड:")
    छाप(स्टेसन_कोड)
    मान समग्र_जोखिम = हिउँ_खतरा + बाढी_खतरा
    छाप("दैनिक समग्र वातावरणीय जोखिम स्तर:")
    छाप(समग्र_जोखिम)
    छाप("========================================")
    फिर्ता समग्र_जोखिम
}

छाप("हिमाली जलवायु तथा मौसम अनुगमन प्रणाली सुरु:")
छाप(स्टेसन_नाम)

तापक्रम_औसत_गणना(-5, -2, 4, 1, -8)
तापक्रम_औसत_गणना(-12, -8, -1, -5, -15)

मान हिउँ_1 = हिउँपहिरो_जोखिम_सूचक(35, 45, 38)
मान हिउँ_2 = हिउँपहिरो_जोखिम_सूचक(10, 20, 25)

मान बाढी_1 = बाढी_जोखिम_वर्षा_विश्लेषण(120)
मान बाढी_2 = बाढी_जोखिम_वर्षा_विश्लेषण(35)

हावाको_शीतलता_प्रभाव_विन्डचिल(-5, 45)
हावाको_शीतलता_प्रभाव_विन्डचिल(-12, 60)

तुसारो_तथा_बरफ_जम्ने_सम्भावना(-2, 85)
तुसारो_तथा_बरफ_जम्ने_सम्भावना(5, 60)

उचाइ_अनुसार_अक्सिजन_स्तर_अनुमान(5364)
उचाइ_अनुसार_अक्सिजन_स्तर_अनुमान(2500)

सौर्य_विकिरण_पराबैजनी_यूभी_इन्डेक्स(11)
सौर्य_विकिरण_पराबैजनी_यूभी_इन्डेक्स(5)

हिमनदी_ताल_विस्फोट_खतरा(65, 0)

वायुमण्डलीय_आर्द्रता_सूचकांक(4, 2)
वायुमण्डलीय_आर्द्रता_सूचकांक(10, 2)

नदी_बाढी_पूर्वानुमान_चेतावनी(8, 7)
नदी_बाढी_पूर्वानुमान_चेतावनी(5, 7)

वायु_प्रदूषण_एक्यूआई_वर्गीकरण(25)
वायु_प्रदूषण_एक्यूआई_वर्गीकरण(160)

हिमनदी_पग्लने_गति_अनुमान(5, 7)

दैनिक_मौसम_बुलेटिन_जारी_गर(8848, हिउँ_1, बाढी_1)
दैनिक_मौसम_बुलेटिन_जारी_गर(8849, हिउँ_2, बाढी_2)


छाप("दैनिक हिमाली मौसम बुलेटिन प्रसारण सम्पन्न.")

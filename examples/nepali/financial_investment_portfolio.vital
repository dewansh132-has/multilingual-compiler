// Nepali: Stock Investment Portfolio, Compound Returns & Risk Analyzer
// Difficulty: Advanced
// Domain: Financial Markets & Wealth Management

मान पोर्टफोलियो_नाम = "नेपाल स्टक एक्सचेन्ज सम्पत्ति व्यवस्थापन इन्जिन"
मान दलाली_कमिशन_दर = 1
मान पुँजीगत_लाभकर_दर = 5

कार्य_गर सेयर_खरिद_लागत_गणना(कित्ता, प्रति_कित्ता_मूल्य) {
    मान आधार_रकम = कित्ता * प्रति_कित्ता_मूल्य
    मान कमिशन = (आधार_रकम * दलाली_कमिशन_दर) / 100
    मान सेबन_शुल्क = (आधार_रकम * 15) / 100000
    मान कुल_लागत = आधार_रकम + कमिशन + सेबन_शुल्क
    छाप("सेयर खरिद कुल लागत रकम:")
    छाप(कुल_लागत)
    फिर्ता कुल_लागत
}

कार्य_गर पुँजीगत_लाभ_तथा_कर_गणना(खरिद_मूल्य, बिक्री_मूल्य, कित्ता) {
    मान कुल_बिक्री = कित्ता * बिक्री_मूल्य
    मान कुल_खरिद = कित्ता * खरिद_मूल्य
    मान खुद_नाफा = कुल_बिक्री - कुल_खरिद
    यदि (खुद_नाफा > 0) {
        मान लाभकर = (खुद_नाफा * पुँजीगत_लाभकर_दर) / 100
        मान खुद_प्राप्ति = खुद_नाफा - लाभकर
        छाप("पुँजीगत खुद नाफा प्राप्त:")
        छाप(खुद_नाफा)
        छाप("नेपाल सरकारलाई बुझाउनुपर्ने पुँजीगत लाभकर:")
        छाप(लाभकर)
        फिर्ता खुद_प्राप्ति
    }
    छाप("नोक्सानी भएको: कुनै पुँजीगत लाभकर लाग्दैन.")
    फिर्ता खुद_नाफा
}

कार्य_गर चक्रवर्ती_प्रतिफल_अन्दाज(मूलधन, ब्याजदर_प्रतिशत, वर्ष) {
    मान रकम = मूलधन
    मान वृद्धि_दर = 100 + ब्याजदर_प्रतिशत
    यदि (वर्ष == 1) {
        मान रकम = (मूलधन * वृद्धि_दर) / 100
    } नत्र {
        यदि (वर्ष == 2) {
            मान रकम = (मूलधन * वृद्धि_दर * वृद्धि_दर) / 10000
        } नत्र {
            मान रकम = (मूलधन * वृद्धि_दर * वृद्धि_दर * वृद्धि_दर) / 1000000
        }
    }
    छाप("अनुमानित चक्रवर्ती भविष्य मूल्य:")
    छाप(रकम)
    फिर्ता रकम
}

कार्य_गर लाभांश_आम्दानी_गणना(कित्ता, नगद_लाभांश_प्रतिशत, अंकित_मूल्य) {
    मान लाभांश_रकम = (कित्ता * अंकित_मूल्य * नगद_लाभांश_प्रतिशत) / 100
    छाप("कम्पनीबाट प्राप्त नगद लाभांश:")
    छाप(लाभांश_रकम)
    फिर्ता लाभांश_रकम
}

कार्य_गर पोर्टफोलियो_जोखिम_वर्गीकरण(हाइड्रो_प्रतिशत, बैंकिङ_प्रतिशत, उत्पादन_प्रतिशत) {
    मान जोखिम_अंक = (हाइड्रो_प्रतिशत * 3) + (बैंकिङ_प्रतिशत * 1) + (उत्पादन_प्रतिशत * 2)
    छाप("पोर्टफोलियो समग्र जोखिम सूचकांक स्कोर:")
    छाप(जोखिम_अंक)
    यदि (जोखिम_अंक > 220) {
        छाप("जोखिम स्तर: उच्च जोखिम, विविधीकरण आवश्यक!")
        फिर्ता 3
    } नत्र {
        यदि (जोखिम_अंक > 150) {
            छाप("जोखिम स्तर: मध्यम सन्तुलित पोर्टफोलियो.")
            फिर्ता 2
        }
    }
    छाप("जोखिम स्तर: रूढीवादी सुरक्षित लगानी ढाँचा.")
    फिर्ता 1
}

कार्य_गर मूल्य_आम्दानी_अनुपात_विश्लेषण(बजार_मूल्य, प्रति_सेयर_आम्दानी) {
    यदि (प्रति_सेयर_आम्दानी <= 0) {
        छाप("कम्पनी घाटामा छ: पीई गणना सम्भव छैन.")
        फिर्ता 0
    }
    मान पीई = बजार_मूल्य / प्रति_सेयर_आम्दानी
    छाप("मूल्य-आम्दानी (P/E) अनुपात:")
    छाप(पीई)
    यदि (पीई < 15) {
        छाप("मूल्यांकन: सस्तो आकर्षक सेयर.")
        फिर्ता 1
    } नत्र {
        यदि (पीई > 35) {
            छाप("मूल्यांकन: अत्यधिक महँगो, जोखिमपूर्ण.")
            फिर्ता 3
        }
    }
    छाप("मूल्यांकन: उचित मूल्य दायरा.")
    फिर्ता 2
}

कार्य_गर आकस्मिक_सुरक्षा_कोष_पर्याप्तता(मासिक_खर्च, वर्तमान_बचत) {
    मान आवश्यक = मासिक_खर्च * 6
    यदि (वर्तमान_बचत >= आवश्यक) {
        छाप("सुरक्षा कोष पर्याप्त छ: लगानी सुरु गर्न सकिन्छ.")
        फिर्ता 1
    }
    छाप("सचेत रहनुहोस्: पहिले 6 महिनाको आपत्कालीन कोष बनाउनुहोस्.")
    फिर्ता 0
}

कार्य_गर लगानी_समीक्षा_अहवाल(सम्पत्ति_1, सम्पत्ति_2, सम्पत्ति_3, लाभांश) {
    छाप("========================================")
    छाप("लगानी पोर्टफोलियो वित्तीय सारांश अहवाल:")
    मान कुल_सम्पत्ति = सम्पत्ति_1 + सम्पत्ति_2 + सम्पत्ति_3 + लाभांश
    छाप("पोर्टफोलियोको कुल मूल्याङ्कन सम्पत्ति:")
    छाप(कुल_सम्पत्ति)
    छाप("========================================")
    फिर्ता कुल_सम्पत्ति
}

कार्य_गर सेयर_धितो_कर्जा_सीमा(कुल_मूल्याङ्कन) {
    मान सीमा = (कुल_मूल्याङ्कन * 70) / 100
    छाप("नेपाल राष्ट्र बैंक नियमानुसार सेयर धितो कर्जा सीमा (70%):")
    छाप(सीमा)
    फिर्ता सीमा
}

कार्य_गर मुद्रास्फीति_समायोजित_वास्तविक_प्रतिफल(नाफा_प्रतिशत, मुद्रास्फीति) {
    मान वास्तविक = नाफा_प्रतिशत - मुद्रास्फीति
    छाप("मुद्रास्फीति घटाएपछिको वास्तविक प्रतिफल दर:")
    छाप(वास्तविक)
    यदि (वास्तविक > 0) {
        छाप("लगानीले क्रयशक्ति जोगाएको छ.")
        फिर्ता 1
    }
    छाप("क्रयशक्ति घट्दो क्रममा छ.")
    फिर्ता 0
}

कार्य_गर हकप्रद_सेयर_राइट्स_पात्रता(कित्ता, अनुपात_अंश) {
    मान थप_हकप्रद_कित्ता = (कित्ता * अनुपात_अंश) / 10
    छाप("पाउने हकप्रद (Rights Share) सेयर कित्ता:")
    छाप(थप_हकप्रद_कित्ता)
    फिर्ता थप_हकप्रद_कित्ता
}

कार्य_गर मासिक_एसआईपी_किस्ता_लगानी(मासिक_रकम, महिना) {
    मान कुल_जम्मा = मासिक_रकम * महिना
    मान अनुमानित_बोनस = (कुल_जम्मा * 8) / 100
    मान भविष्य_रकम = कुल_जम्मा + अनुमानित_बोनस
    छाप("नियमित एसआईपी बचत भविष्य अनुमान:")
    छाप(भविष्य_रकम)
    फिर्ता भविष्य_रकम
}

छाप("वित्तीय पोर्टफोलियो विश्लेषण सुरु:")
छाप(पोर्टफोलियो_नाम)

मान स्टक_1_लागत = सेयर_खरिद_लागत_गणना(200, 450)
मान स्टक_2_लागत = सेयर_खरिद_लागत_गणना(500, 220)
मान स्टक_3_लागत = सेयर_खरिद_लागत_गणना(100, 850)

पुँजीगत_लाभ_तथा_कर_गणना(450, 600, 200)
पुँजीगत_लाभ_तथा_कर_गणना(220, 190, 500)
पुँजीगत_लाभ_तथा_कर_गणना(850, 1100, 100)

चक्रवर्ती_प्रतिफल_अन्दाज(100000, 12, 3)

मान लाभांश_1 = लाभांश_आम्दानी_गणना(200, 15, 100)
मान लाभांश_2 = लाभांश_आम्दानी_गणना(500, 10, 100)

पोर्टफोलियो_जोखिम_वर्गीकरण(40, 40, 20)

मूल्य_आम्दानी_अनुपात_विश्लेषण(600, 45)
मूल्य_आम्दानी_अनुपात_विश्लेषण(190, 8)
मूल्य_आम्दानी_अनुपात_विश्लेषण(1100, 25)

आकस्मिक_सुरक्षा_कोष_पर्याप्तता(50000, 350000)

मान कुल_पोर्टफोलियो = लगानी_समीक्षा_अहवाल(स्टक_1_लागत, स्टक_2_लागत, स्टक_3_लागत, लाभांश_1 + लाभांश_2)

सेयर_धितो_कर्जा_सीमा(कुल_पोर्टफोलियो)
मुद्रास्फीति_समायोजित_वास्तविक_प्रतिफल(15, 6)

हकप्रद_सेयर_राइट्स_पात्रता(200, 3)
मासिक_एसआईपी_किस्ता_लगानी(5000, 24)


छाप("वित्तीय विश्लेषण तथा सम्पत्ति व्यवस्थापन सम्पन्न.")

// Nepali: Himalayan Airline Flight Booking, Baggage & Tariff System
// Difficulty: Advanced
// Domain: Aviation Management & Travel Reservation

मान एयरलाइन्स_नाम = "नेपाल हिमालयन एयरलाइन्स टिकटिङ प्रणाली"
मान आधार_भाडा_काठमाडौँ_पोखरा = 4500
मान आधार_भाडा_काठमाडौँ_लुक्ला = 8500
मान निशुल्क_झोला_तौल = 15
मान प्रति_केजी_अतिरिक्त_शुल्क = 200

कार्य_गर सेक्टर_भाडा_निर्धारण(गन्तव्य_कोड) {
    मान भाडा = 0
    यदि (गन्तव्य_कोड == 1) {
        मान भाडा = आधार_भाडा_काठमाडौँ_पोखरा
        छाप("गन्तव्य पोखरा: आन्तरिक पर्यटकीय सेक्टर चयन गरियो.")
    } नत्र {
        यदि (गन्तव्य_कोड == 2) {
            मान भाडा = आधार_भाडा_काठमाडौँ_लुक्ला
            छाप("गन्तव्य लुक्ला: सगरमाथा हिमाली सेक्टर चयन गरियो.")
        } नत्र {
            मान भाडा = 3500
            छाप("गन्तव्य विराटनगर: तराई सेक्टर चयन गरियो.")
        }
    }
    छाप("आधार उडान भाडा दर:")
    छाप(भाडा)
    फिर्ता भाडा
}

कार्य_गर अतिरिक्त_झोला_शुल्क_गणना(वास्तविक_तौल) {
    यदि (वास्तविक_तौल <= निशुल्क_झोला_तौल) {
        छाप("झोला तौल निशुल्क सीमाभित्र छ.")
        फिर्ता 0
    }
    मान बढी_तौल = वास्तविक_तौल - निशुल्क_झोला_तौल
    मान कुल_शुल्क = बढी_तौल * प्रति_केजी_अतिरिक्त_शुल्क
    छाप("अतिरिक्त ब्यागेज शुल्क रकम:")
    छाप(कुल_शुल्क)
    फिर्ता कुल_शुल्क
}

कार्य_गर सिट_वर्ग_अपग्रेड_शुल्क(वर्ग_स्तर) {
    यदि (वर्ग_स्तर == 1) {
        मान अपग्रेड = 1500
        छाप("बिजनेस क्लास विन्डो सिट चयन: प्रिमियम सेवा लागू.")
        फिर्ता अपग्रेड
    }
    छाप("इकोनोमी क्लास स्ट्यान्डर्ड सिट चयन.")
    फिर्ता 0
}

कार्य_गर नागरिक_उड्यान_प्राधिकरण_कर(आधार_भाडा) {
    मान विमानस्थल_विकास_शुल्क = 500
    मान भ्याट = (आधार_भाडा * 13) / 100
    मान कुल_कर = विमानस्थल_विकास_शुल्क + भ्याट
    छाप("नागरिक उड्डयन प्राधिकरण सेवा कर र भ्याट:")
    छाप(कुल_कर)
    फिर्ता कुल_कर
}

कार्य_गर ज्येष्ठ_नागरिक_वा_बालबालिका_छुट(उमेर, आधार_भाडा) {
    यदि (उमेर >= 65) {
        मान छुट = (आधार_भाडा * 20) / 100
        छाप("ज्येष्ठ नागरिक सम्मान छुट 20 प्रतिशत लागू.")
        फिर्ता छुट
    } नत्र {
        यदि (उमेर <= 10) {
            मान छुट = (आधार_भाडा * 33) / 100
            छाप("बालबालिका सहुलियत छुट 33 प्रतिशत लागू.")
            फिर्ता छुट
        }
    }
    फिर्ता 0
}

कार्य_गर टिकट_रद्द_शुल्क_गणना(प्रस्थान_बाँकी_घण्टा, टिकट_मूल्य) {
    यदि (प्रस्थान_बाँकी_घण्टा < 24) {
        मान शुल्क = (टिकट_मूल्य * 50) / 100
        छाप("अन्तिम समय रद्द: 50 प्रतिशत कटौती लागू.")
        फिर्ता शुल्क
    } नत्र {
        यदि (प्रस्थान_बाँकी_घण्टा < 72) {
            मान शुल्क = (टिकट_मूल्य * 25) / 100
            छाप("मध्यम समय रद्द: 25 प्रतिशत कटौती लागू.")
            फिर्ता शुल्क
        }
    }
    छाप("समयमै रद्द: न्यूनतम 10 प्रतिशत सेवा शुल्क.")
    मान शुल्क = (टिकट_मूल्य * 10) / 100
    फिर्ता शुल्क
}

कार्य_गर खाना_तथा_पेय_सेवा_शुल्क(अर्डर_कोड) {
    यदि (अर्डर_कोड == 1) {
        मान खाना_खर्च = 450
        छाप("नेपाली परम्परागत खाजा सेट थपियो.")
        फिर्ता खाना_खर्च
    }
    फिर्ता 0
}

कार्य_गर इन्धन_अधिभार_गणना(दूरी_किमी) {
    मान अधिभार = दूरी_किमी * 5
    छाप("उडान इन्धन सरचार्ज अधिभार:")
    छाप(अधिभार)
    फिर्ता अधिभार
}

कार्य_गर उडान_बोर्डिङ_पास_तयार_गर(यात्रु_आइडी, भाडा, ब्यागेज, सिट, कर, छुट, खाना, इन्धन) {
    छाप("========================================")
    छाप("यात्रु उडान बोर्डिङ पास तथा बिल विवरण आइडी:")
    छाप(यात्रु_आइडी)
    मान कुल_प्रदेय = (भाडा - छुट) + ब्यागेज + सिट + कर + खाना + इन्धन
    छाप("यात्रुले भुक्तानी गर्नुपर्ने अन्तिम रकम:")
    छाप(कुल_प्रदेय)
    छाप("========================================")
    फिर्ता कुल_प्रदेय
}

कार्य_गर मौसम_उडान_अनुकूलता_जाँच(हावा_गति, भिजिबिलिटी) {
    यदि (हावा_गति > 40 वा भिजिबिलिटी < 2000) {
        छाप("मौसम प्रतिकूल: उडान स्थगित वा डाइभर्ट गरियो!")
        फिर्ता 0
    }
    छाप("मौसम पूर्णतया सफा: उडान सुरक्षित छ.")
    फिर्ता 1
}

कार्य_गर चालक_दल_ड्युटी_घण्टा_अनुगमन(उडान_घण्टा) {
    यदि (उडान_घण्टा > 8) {
        छाप("चालक दल थकान सीमा: वैकल्पिक पाइलट अनिवार्य.")
        फिर्ता 1
    }
    छाप("चालक दल ड्युटी समय सुरक्षित सीमाभित्र छ.")
    फिर्ता 0
}

कार्य_गर यात्रु_लोयल्टी_माइल_अंक(दूरी_किमी) {
    मान अंक = दूरी_किमी / 10
    छाप("यात्रु फ्रिक्वेन्ट फ्लायर बोनस माइल:")
    छाप(अंक)
    फिर्ता अंक
}

छाप("हवाई सेवा तथा उडान आरक्षण व्यवस्थापन सुरु:")
छाप(एयरलाइन्स_नाम)

मान भाडा_1 = सेक्टर_भाडा_निर्धारण(1)
मान ब्यागेज_1 = अतिरिक्त_झोला_शुल्क_गणना(22)
मान सिट_1 = सिट_वर्ग_अपग्रेड_शुल्क(1)
मान कर_1 = नागरिक_उड्यान_प्राधिकरण_कर(भाडा_1)
मान छुट_1 = ज्येष्ठ_नागरिक_वा_बालबालिका_छुट(70, भाडा_1)
मान खाना_1 = खाना_तथा_पेय_सेवा_शुल्क(1)
मान इन्धन_1 = इन्धन_अधिभार_गणना(200)
मान टिकट_1 = उडान_बोर्डिङ_पास_तयार_गर(1001, भाडा_1, ब्यागेज_1, सिट_1, कर_1, छुट_1, खाना_1, इन्धन_1)

मान भाडा_2 = सेक्टर_भाडा_निर्धारण(2)
मान ब्यागेज_2 = अतिरिक्त_झोला_शुल्क_गणना(14)
मान सिट_2 = सिट_वर्ग_अपग्रेड_शुल्क(0)
मान कर_2 = नागरिक_उड्यान_प्राधिकरण_कर(भाडा_2)
मान छुट_2 = ज्येष्ठ_नागरिक_वा_बालबालिका_छुट(28, भाडा_2)
मान खाना_2 = खाना_तथा_पेय_सेवा_शुल्क(0)
मान इन्धन_2 = इन्धन_अधिभार_गणना(150)
मान टिकट_2 = उडान_बोर्डिङ_पास_तयार_गर(1002, भाडा_2, ब्यागेज_2, सिट_2, कर_2, छुट_2, खाना_2, इन्धन_2)

मान भाडा_3 = सेक्टर_भाडा_निर्धारण(3)
मान ब्यागेज_3 = अतिरिक्त_झोला_शुल्क_गणना(18)
मान सिट_3 = सिट_वर्ग_अपग्रेड_शुल्क(0)
मान कर_3 = नागरिक_उड्यान_प्राधिकरण_कर(भाडा_3)
मान छुट_3 = ज्येष्ठ_नागरिक_वा_बालबालिका_छुट(8, भाडा_3)
मान खाना_3 = खाना_तथा_पेय_सेवा_शुल्क(1)
मान इन्धन_3 = इन्धन_अधिभार_गणना(350)
मान टिकट_3 = उडान_बोर्डिङ_पास_तयार_गर(1003, भाडा_3, ब्यागेज_3, सिट_3, कर_3, छुट_3, खाना_3, इन्धन_3)

टिकट_रद्द_शुल्क_गणना(18, टिकट_1)
मौसम_उडान_अनुकूलता_जाँच(25, 5000)
मौसम_उडान_अनुकूलता_जाँच(50, 1500)

चालक_दल_ड्युटी_घण्टा_अनुगमन(6)
चालक_दल_ड्युटी_घण्टा_अनुगमन(9)

यात्रु_लोयल्टी_माइल_अंक(200)
यात्रु_लोयल्टी_माइल_अंक(350)

मान दिनको_कुल_उडान_राजस्व = टिकट_1 + टिकट_2 + टिकट_3
छाप("आजको कुल उडान टिकट बिक्री आम्दानी:")
छाप(दिनको_कुल_उडान_राजस्व)


छाप("उडान टिकटिङ तथा रिजर्भेसन कार्य सफलतापूर्वक सम्पन्न.")

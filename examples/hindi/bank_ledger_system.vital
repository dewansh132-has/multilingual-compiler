// Hindi: Comprehensive Banking Ledger & Audit Management System
// Difficulty: Advanced
// Domain: Financial Services & Accounting Systems

मानो बैंक_शाखा = "राष्ट्रीय वित्तीय सेवा केंद्र, नई दिल्ली"
मानो कुल_खाताधारक = 4
मानो न्यूनतम_शेष = 1000

कार्य प्रारंभिक_खाता_निर्मित_करें(खाता_संख्या, प्रारंभिक_जमा, खाता_प्रकार) {
    मानो वैध = 1
    अगर (प्रारंभिक_जमा < न्यूनतम_शेष) {
        लिखो("त्रुटि: प्रारंभिक जमा न्यूनतम आवश्यक शेष से कम है!")
        मानो वैध = 0
    } अन्यथा {
        लिखो("खाता सफलतापूर्वक सक्रिय किया गया:")
        लिखो(खाता_संख्या)
        लिखो("खाता प्रकार कोड (1=बचत, 2=चालू):")
        लिखो(खाता_प्रकार)
    }
    लौटाओ वैध
}

कार्य जमा_संसाधित_करें(वर्तमान_शेष, जमा_राशि) {
    अगर (जमा_राशि <= 0) {
        लिखो("त्रुटि: अवैध जमा राशि दर्ज की गई.")
        लौटाओ वर्तमान_शेष
    }
    मानो नया_शेष = वर्तमान_शेष + जमा_राशि
    लिखो("जमा पुष्टि: नया शेष:")
    लिखो(नया_शेष)
    लौटाओ नया_शेष
}

कार्य निकासी_संसाधित_करें(वर्तमान_शेष, निकासी_राशि, अधिप्रभार_अनुमति) {
    अगर (निकासी_राशि <= 0) {
        लिखो("त्रुटि: निकासी राशि शून्य से अधिक होनी चाहिए.")
        लौटाओ वर्तमान_शेष
    }
    मानो शेष_बाद = वर्तमान_शेष - निकासी_राशि
    अगर (शेष_बाद < न्यूनतम_शेष) {
        अगर (अधिप्रभार_अनुमति == 1) {
            लिखो("चेतावनी: न्यूनतम शेष सीमा का उल्लंघन, अधिप्रभार शुल्क लागू.")
            मानो नया_शेष = शेष_बाद - 50
            लौटाओ नया_शेष
        } अन्यथा {
            लिखो("लेनदेन अस्वीकृत: अपर्याप्त शेष और अधिप्रभार अस्वीकृत.")
            लौटाओ वर्तमान_शेष
        }
    }
    लिखो("निकासी सफल, वर्तमान शेष:")
    लिखो(शेष_बाद)
    लौटाओ शेष_बाद
}

कार्य मासिक_ब्याज_गणना(शेष, वार्षिक_दर_प्रतिशत) {
    मानो वार्षिक_ब्याज = (शेष * वार्षिक_दर_प्रतिशत) / 100
    मानो मासिक_ब्याज = वार्षिक_ब्याज / 12
    लौटाओ मासिक_ब्याज
}

कार्य खाता_लेजर_अद्यतन(खाता_आईडी, प्रारंभिक, जमा, निकासी, ब्याज_दर) {
    लिखो("========================================")
    लिखो("खाता लेजर सारांश ऑडिट:")
    लिखो(खाता_आईडी)
    मानो चरण_1 = जमा_संसाधित_करें(प्रारंभिक, जमा)
    मानो चरण_2 = निकासी_संसाधित_करें(चरण_1, निकासी, 1)
    मानो अर्जित_ब्याज = मासिक_ब्याज_गणना(चरण_2, ब्याज_दर)
    मानो अंतिम_शेष = चरण_2 + अर्जित_ब्याज
    लिखो("मासिक अर्जित ब्याज:")
    लिखो(अर्जित_ब्याज)
    लिखो("माह के अंत में अंतिम खाता शेष:")
    लिखो(अंतिम_शेष)
    लिखो("========================================")
    लौटाओ अंतिम_शेष
}

कार्य शाखा_कुल_देनदारी_विश्लेषण(ख1, ख2, ख3, ख4) {
    मानो कुल_जमा_देनदारी = ख1 + ख2 + ख3 + ख4
    मानो औसत_खाता_शेष = कुल_जमा_देनदारी / 4
    लिखो("शाखा कुल जमा पूंजी:")
    लिखो(कुल_जमा_देनदारी)
    लिखो("औसत प्रति खाता शेष:")
    लिखो(औसत_खाता_शेष)
    लौटाओ कुल_जमा_देनदारी
}

कार्य उच्च_मूल्य_खाता_गणना(ख1, ख2, ख3, ख4, सीमा) {
    मानो गिनती = 0
    अगर (ख1 >= सीमा) {
        मानो गिनती = गिनती + 1
    }
    अगर (ख2 >= सीमा) {
        मानो गिनती = गिनती + 1
    }
    अगर (ख3 >= सीमा) {
        मानो गिनती = गिनती + 1
    }
    अगर (ख4 >= सीमा) {
        मानो गिनती = गिनती + 1
    }
    लिखो("उच्च मूल्य खाताधारकों की कुल संख्या:")
    लिखो(गिनती)
    लौटाओ गिनती
}

कार्य अनुपालन_जोखिम_जांच(शेष) {
    अगर (शेष < 500) {
        लिखो("अलर्ट: खाता उच्च निष्क्रियता और न्यूनतम शेष उल्लंघन जोखिम में है!")
        लौटाओ 3
    }
    अगर (शेष < 1000) {
        लिखो("सूचना: खाता मानक न्यूनतम शेष चेतावनी स्तर पर है.")
        लौटाओ 2
    }
    लिखो("पुष्टि: खाता पूर्णत: वित्तीय विनियामक अनुपालन में है.")
    लौटाओ 1
}

कार्य ऋण_पात्रता_मूल्यांकन(वार्षिक_आय, मौजूदा_शेष, क्रेडिट_स्कोर) {
    अगर (क्रेडिट_स्कोर < 650) {
        लिखो("ऋण अस्वीकृत: कम क्रेडिट स्कोर.")
        लौटाओ 0
    }
    मानो अधिकतम_ऋण = (वार्षिक_आय * 4) + (मौजूदा_शेष * 2)
    लिखो("अनुमोदित अधिकतम ऋण सीमा:")
    लिखो(अधिकतम_ऋण)
    लौटाओ अधिकतम_ऋण
}

कार्य शाखा_वार्षिक_कर_कटौती(कुल_ब्याज_भुगतान, कर_दर) {
    मानो कुल_टीडीएस = (कुल_ब्याज_भुगतान * कर_दर) / 100
    लिखो("सरकारी स्रोत पर कर कटौती (टीडीएस) कुल:")
    लिखो(कुल_टीडीएस)
    लौटाओ कुल_टीडीएस
}

कार्य चेक_क्लियरिंग_सत्यापन(चेक_संख्या, चेक_राशि, वर्तमान_शेष) {
    अगर (चेक_राशि <= 0) {
        लिखो("त्रुटि: अमान्य चेक राशि.")
        लौटाओ 0
    }
    अगर (वर्तमान_शेष < चेक_राशि) {
        लिखो("चेक अनादरण (बाउंस): अपर्याप्त शेष!")
        लौटाओ 0
    }
    मानो नया_शेष = वर्तमान_शेष - चेक_राशि
    लिखो("चेक सफलतापूर्वक समाशोधित (क्लियर) हुआ:")
    लिखो(चेक_संख्या)
    लिखो("अद्यतन शेष राशि:")
    लिखो(नया_शेष)
    लौटाओ नया_शेष
}

कार्य स्थिर_जमा_परिपक्वता(मूलधन, ब्याज_दर, अवधि_वर्ष) {
    मानो संचित_ब्याज = (मूलधन * ब्याज_दर * अवधि_वर्ष) / 100
    मानो परिपक्वता_राशि = मूलधन + संचित_ब्याज
    लिखो("स्थिर सावधि जमा परिपक्वता मूल्य:")
    लिखो(परिपक्वता_राशि)
    लौटाओ परिपक्वता_राशि
}

कार्य ऋण_ईएमआई_गणना(ऋण_राशि, वार्षिक_दर, अवधि_माह) {
    मानो कुल_ब्याज = (ऋण_राशि * वार्षिक_दर * अवधि_माह) / 1200
    मानो कुल_भुगतान = ऋण_राशि + कुल_ब्याज
    मानो मासिक_किस्त = कुल_भुगतान / अवधि_माह
    लिखो("मासिक ऋण किस्त (ईएमआई):")
    लिखो(मासिक_किस्त)
    लौटाओ मासिक_किस्त
}

कार्य धोखाधड़ी_रोकथाम_सीमा_जांच(लेनदेन_राशि, दैनिक_सीमा) {
    अगर (लेनदेन_राशि > दैनिक_सीमा) {
        लिखो("संदेहास्पद उच्च मूल्य लेनदेन अवरुद्ध!")
        लौटाओ 0
    }
    लौटाओ 1
}

अगर (कुल_खाताधारक > 0) {
    लिखो("बैंकिंग प्रणाली कोर सेवा प्रारंभ:")
}
लिखो(बैंक_शाखा)

प्रारंभिक_खाता_निर्मित_करें(101, 15000, 1)
प्रारंभिक_खाता_निर्मित_करें(102, 28000, 2)
प्रारंभिक_खाता_निर्मित_करें(103, 5000, 1)
प्रारंभिक_खाता_निर्मित_करें(104, 75000, 2)

मानो अंतिम_ख1 = खाता_लेजर_अद्यतन(101, 15000, 4500, 2000, 4)
मानो अंतिम_ख2 = खाता_लेजर_अद्यतन(102, 28000, 12000, 8500, 5)
मानो अंतिम_ख3 = खाता_लेजर_अद्यतन(103, 5000, 1000, 4800, 3)
मानो अंतिम_ख4 = खाता_लेजर_अद्यतन(104, 75000, 25000, 15000, 6)

शाखा_कुल_देनदारी_विश्लेषण(अंतिम_ख1, अंतिम_ख2, अंतिम_ख3, अंतिम_ख4)
उच्च_मूल्य_खाता_गणना(अंतिम_ख1, अंतिम_ख2, अंतिम_ख3, अंतिम_ख4, 25000)

अनुपालन_जोखिम_जांच(अंतिम_ख3)
अनुपालन_जोखिम_जांच(अंतिम_ख4)

ऋण_पात्रता_मूल्यांकन(600000, अंतिम_ख1, 740)
ऋण_पात्रता_मूल्यांकन(1200000, अंतिम_ख2, 790)

चेक_क्लियरिंग_सत्यापन(80551, 3500, अंतिम_ख1)
स्थिर_जमा_परिपक्वता(50000, 7, 3)
ऋण_ईएमआई_गणना(300000, 9, 36)
धोखाधड़ी_रोकथाम_सीमा_जांच(25000, 50000)

शाखा_वार्षिक_कर_कटौती(85000, 10)


लिखो("समस्त खाताधारक वित्तीय ऑडिट सफलतापूर्वक पूर्ण हुआ.")

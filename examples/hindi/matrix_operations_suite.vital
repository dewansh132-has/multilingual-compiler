// Hindi: 3x3 Matrix Algebraic Operations & Linear Transformation Suite
// Difficulty: Advanced
// Domain: Linear Algebra & Matrix Transformations

मानो सूट_शीर्षक = "मैट्रिक्स बीजगणित और रैखिक परिवर्तन सूट"
मानो मैट्रिक्स_आकार = 3

कार्य मैट्रिक्स_जोड़_तत्व(ए, बी) {
    मानो योग = ए + बी
    लौटाओ योग
}

कार्य मैट्रिक्स_घटाव_तत्व(ए, बी) {
    मानो अंतर = ए - बी
    लौटाओ अंतर
}

कार्य अदिश_गुणन_तत्व(तत्व, अदिश) {
    मानो परिणाम = तत्व * अदिश
    लौटाओ परिणाम
}

कार्य पंक्ति_वेक्टर_डॉट_उत्पाद(ए1, ए2, ए3, बी1, बी2, बी3) {
    मानो पद_1 = ए1 * बी1
    मानो पद_2 = ए2 * बी2
    मानो पद_3 = ए3 * बी3
    मानो कुल = पद_1 + पद_2 + पद_3
    लौटाओ कुल
}

कार्य मैट्रिक्स_ट्रेस_गणना(एम00, एम11, एम22) {
    मानो ट्रेस = एम00 + एम11 + एम22
    लिखो("मैट्रिक्स ट्रेस (मुख्य विकर्ण योग):")
    लिखो(ट्रेस)
    लौटाओ ट्रेस
}

कार्य दो_गुणा_दो_सारणिक_गणना(ए, बी, सी, डी) {
    मानो मुख्य_गुणन = ए * डी
    मानो सहायक_गुणन = बी * सी
    मानो सारणिक_मान = मुख्य_गुणन - सहायक_गुणन
    लौटाओ सारणिक_मान
}

कार्य तीन_गुणा_तीन_सारणिक(a00, a01, a02, a10, a11, a12, a20, a21, a22) {
    मानो उप_सारणिक_0 = दो_गुणा_दो_सारणिक_गणना(a11, a12, a21, a22)
    मानो उप_सारणिक_1 = दो_गुणा_दो_सारणिक_गणना(a10, a12, a20, a22)
    मानो उप_सारणिक_2 = दो_गुणा_दो_सारणिक_गणना(a10, a11, a20, a21)

    मानो भाग_0 = a00 * उप_सारणिक_0
    मानो भाग_1 = a01 * उप_सारणिक_1
    मानो भाग_2 = a02 * उप_सारणिक_2

    मानो कुल_सारणिक = (भाग_0 - भाग_1) + भाग_2
    लिखो("3x3 मैट्रिक्स सारणिक (डिटरमिनेंट) मान:")
    लिखो(कुल_सारणिक)
    लौटाओ कुल_सारणिक
}

कार्य सममित_मैट्रिक्स_जांच(a01, a10, a02, a20, a12, a21) {
    मानो सममित = 1
    अगर (a01 != a10) {
        मानो सममित = 0
    }
    अगर (a02 != a20) {
        मानो सममित = 0
    }
    अगर (a12 != a21) {
        मानो सममित = 0
    }
    अगर (सममित == 1) {
        लिखो("मैट्रिक्स सममित (सिमेट्रिक) है.")
    } अन्यथा {
        लिखो("मैट्रिक्स असममित (नॉन-सिमेट्रिक) है.")
    }
    लौटाओ सममित
}

कार्य पंक्ति_योग_गणना(पंक्ति_संख्या, ई1, ई2, ई3) {
    मानो योग = ई1 + ई2 + ई3
    लिखो("पंक्ति योग:")
    लिखो(पंक्ति_संख्या)
    लिखो(योग)
    लौटाओ योग
}

कार्य स्तंभ_योग_गणना(स्तंभ_संख्या, ई1, ई2, ई3) {
    मानो योग = ई1 + ई2 + ई3
    लिखो("स्तंभ योग:")
    लिखो(स्तंभ_संख्या)
    लिखो(योग)
    लौटाओ योग
}

कार्य फ्रोबेनियस_मानदंड_वर्ग(a0, a1, a2, a3, a4, a5, a6, a7, a8) {
    मानो वर्ग_योग = (a0 * a0) + (a1 * a1) + (a2 * a2) + (a3 * a3) + (a4 * a4) + (a5 * a5) + (a6 * a6) + (a7 * a7) + (a8 * a8)
    लिखो("फ्रोबेनियस नॉर्म का वर्ग:")
    लिखो(वर्ग_योग)
    लौटाओ वर्ग_योग
}

कार्य विकर्ण_मैट्रिक्स_जांच(a01, a02, a10, a12, a20, a21) {
    मानो विकर्ण_है = 1
    अगर (a01 != 0 या a02 != 0 या a10 != 0 या a12 != 0 या a20 != 0 या a21 != 0) {
        मानो विकर्ण_है = 0
    }
    लौटाओ विकर्ण_है
}

कार्य स्केलर_मैट्रिक्स_गुणा_सभी(स्केलर, e0, e1, e2, e3, e4, e5, e6, e7, e8) {
    मानो s0 = अदिश_गुणन_तत्व(e0, स्केलर)
    मानो s1 = e1 * स्केलर
    मानो s2 = e2 * स्केलर
    मानो s3 = e3 * स्केलर
    मानो s4 = e4 * स्केलर
    मानो s5 = e5 * स्केलर
    मानो s6 = e6 * स्केलर
    मानो s7 = e7 * स्केलर
    मानो s8 = e8 * स्केलर
    मानो कुल_स्केलर_योग = s0 + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8
    लौटाओ कुल_स्केलर_योग
}

कार्य शून्य_मैट्रिक्स_जांच(e0, e1, e2, e3, e4, e5, e6, e7, e8) {
    मानो कुल = e0 + e1 + e2 + e3 + e4 + e5 + e6 + e7 + e8
    अगर (कुल == 0) {
        लौटाओ 1
    }
    लौटाओ 0
}

कार्य पहचान_मैट्रिक्स_तत्व_जांच(d0, d1, d2, off0, off1, off2) {
    मानो पहचान_है = 1
    अगर (d0 != 1 या d1 != 1 या d2 != 1) {
        मानो पहचान_है = 0
    }
    अगर (off0 != 0 या off1 != 0 या off2 != 0) {
        मानो पहचान_है = 0
    }
    लौटाओ पहचान_है
}

अगर (मैट्रिक्स_आकार > 0) {
    लिखो("मैट्रिक्स बीजगणित इंजन प्रारंभ:")
}
लिखो(सूट_शीर्षक)

मानो m_a_00 = 3
मानो m_a_01 = 2
मानो m_a_02 = 1
मानो m_a_10 = 1
मानो m_a_11 = 4
मानो m_a_12 = 2
मानो m_a_20 = 2
मानो m_a_21 = 1
मानो m_a_22 = 5

मानो m_b_00 = 1
मानो m_b_01 = 0
मानो m_b_02 = 2
मानो m_b_10 = 0
मानो m_b_11 = 1
मानो m_b_12 = 1
मानो m_b_20 = 2
मानो m_b_21 = 1
मानो m_b_22 = 0

मैट्रिक्स_जोड़_तत्व(m_a_00, m_b_00)
मैट्रिक्स_जोड़_तत्व(m_a_01, m_b_01)
मैट्रिक्स_जोड़_तत्व(m_a_02, m_b_02)
मैट्रिक्स_जोड़_तत्व(m_a_10, m_b_10)
मैट्रिक्स_जोड़_तत्व(m_a_11, m_b_11)
मैट्रिक्स_जोड़_तत्व(m_a_12, m_b_12)
मैट्रिक्स_जोड़_तत्व(m_a_20, m_b_20)
मैट्रिक्स_जोड़_तत्व(m_a_21, m_b_21)
मैट्रिक्स_जोड़_तत्व(m_a_22, m_b_22)

मैट्रिक्स_घटाव_तत्व(m_a_00, m_b_00)
मैट्रिक्स_घटाव_तत्व(m_a_11, m_b_11)
मैट्रिक्स_घटाव_तत्व(m_a_22, m_b_22)

मैट्रिक्स_ट्रेस_गणना(m_a_00, m_a_11, m_a_22)
मैट्रिक्स_ट्रेस_गणना(m_b_00, m_b_11, m_b_22)

तीन_गुणा_तीन_सारणिक(m_a_00, m_a_01, m_a_02, m_a_10, m_a_11, m_a_12, m_a_20, m_a_21, m_a_22)
तीन_गुणा_तीन_सारणिक(m_b_00, m_b_01, m_b_02, m_b_10, m_b_11, m_b_12, m_b_20, m_b_21, m_b_22)

सममित_मैट्रिक्स_जांच(m_a_01, m_a_10, m_a_02, m_a_20, m_a_12, m_a_21)
विकर्ण_मैट्रिक्स_जांच(m_a_01, m_a_02, m_a_10, m_a_12, m_a_20, m_a_21)

पंक्ति_योग_गणना(1, m_a_00, m_a_01, m_a_02)
पंक्ति_योग_गणना(2, m_a_10, m_a_11, m_a_12)
पंक्ति_योग_गणना(3, m_a_20, m_a_21, m_a_22)

स्तंभ_योग_गणना(1, m_a_00, m_a_10, m_a_20)
स्तंभ_योग_गणना(2, m_a_01, m_a_11, m_a_21)
स्तंभ_योग_गणना(3, m_a_02, m_a_12, m_a_22)

फ्रोबेनियस_मानदंड_वर्ग(m_a_00, m_a_01, m_a_02, m_a_10, m_a_11, m_a_12, m_a_20, m_a_21, m_a_22)
स्केलर_मैट्रिक्स_गुणा_सभी(3, m_a_00, m_a_01, m_a_02, m_a_10, m_a_11, m_a_12, m_a_20, m_a_21, m_a_22)
शून्य_मैट्रिक्स_जांच(m_a_00, m_a_01, m_a_02, m_a_10, m_a_11, m_a_12, m_a_20, m_a_21, m_a_22)
पहचान_मैट्रिक्स_तत्व_जांच(m_b_00, m_b_11, m_b_22, m_b_01, m_b_10, m_b_20)

मानो उत्पाद_पंक्ति0_स्तंभ0 = पंक्ति_वेक्टर_डॉट_उत्पाद(m_a_00, m_a_01, m_a_02, m_b_00, m_b_10, m_b_20)
मानो उत्पाद_पंक्ति1_स्तंभ1 = पंक्ति_वेक्टर_डॉट_उत्पाद(m_a_10, m_a_11, m_a_12, m_b_01, m_b_11, m_b_21)
मानो उत्पाद_पंक्ति2_स्तंभ2 = पंक्ति_वेक्टर_डॉट_उत्पाद(m_a_20, m_a_21, m_a_22, m_b_02, m_b_12, m_b_22)


लिखो("मैट्रिक्स गुणन विकर्ण तत्व C00, C11, C22:")
लिखो(उत्पाद_पंक्ति0_स्तंभ0)
लिखो(उत्पाद_पंक्ति1_स्तंभ1)
लिखो(उत्पाद_पंक्ति2_स्तंभ2)

लिखो("रैखिक बीजगणित गणना संपूर्ण निष्पादन सफलतापूर्वक समाप्त.")

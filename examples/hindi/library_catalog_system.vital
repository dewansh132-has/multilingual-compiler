// Hindi: Public Library Catalog Circulation & Fine Assessment System
// Difficulty: Advanced
// Domain: Information Management & Library Circulation

मानो पुस्तकालय_नाम = "केंद्रीय सार्वजनिक पुस्तकालय, वाराणसी"
मानो कुल_पुस्तक_प्रतियां = 1500
मानो दैनिक_विलंब_शुल्क = 5
मानो मानक_उधार_दिन = 14

कार्य पुस्तक_पंजीयन_सत्यापन(आईएसबीएन, शीर्षक_कोड, कुल_प्रतियां, शेल्फ_स्थान) {
    अगर (आईएसबीएन > 0) {
        मानो _आईएसबीएन_जांच = 1
    }
    अगर (कुल_प्रतियां <= 0) {
        लिखो("त्रुटि: शून्य प्रतियों के साथ पुस्तक पंजीकृत नहीं की जा सकती.")
        लौटाओ 0
    }
    लिखो("पुस्तक सफलतापूर्वक कैटलॉग में पंजीकृत:")
    लिखो(शीर्षक_कोड)
    लिखो("आवंटित शेल्फ क्रमांक:")
    लिखो(शेल्फ_स्थान)
    लौटाओ 1
}

कार्य पुस्तक_निर्गमन_पात्रता(सदस्य_आईडी, सक्रिय_पुस्तकें_संख्या, सदस्यता_वैधता) {
    अगर (सदस्यता_वैधता == 0) {
        लिखो("निर्गमन अस्वीकृत: सदस्यता समाप्त हो चुकी है.")
        लौटाओ 0
    }
    अगर (सक्रिय_पुस्तकें_संख्या >= 3) {
        लिखो("निर्गमन अस्वीकृत: सदस्य की अधिकतम पुस्तक सीमा (3) पूर्ण हो चुकी है.")
        लौटाओ 0
    }
    लिखो("निर्गमन स्वीकृत: सदस्य पात्रता सत्यापित:")
    लिखो(सदस्य_आईडी)
    लौटाओ 1
}

कार्य विलंब_शुल्क_गणना(नियत_दिन, वास्तविक_वापसी_दिन, छूट_प्रतिशत) {
    अगर (वास्तविक_वापसी_दिन <= नियत_दिन) {
        लिखो("समय पर वापसी: कोई विलंब शुल्क नहीं.")
        लौटाओ 0
    }
    मानो अतिरिक्त_दिन = वास्तविक_वापसी_दिन - नियत_दिन
    मानो सकल_शुल्क = अतिरिक्त_दिन * दैनिक_विलंब_शुल्क
    मानो छूट_राशि = (सकल_शुल्क * छूट_प्रतिशत) / 100
    मानो शुद्ध_शुल्क = सकल_शुल्क - छूट_राशि
    लिखो("विलंब शुल्क विवरण:")
    लिखो("अतिरिक्त दिन:")
    लिखो(अतिरिक्त_दिन)
    लिखो("शुद्ध देय विलंब शुल्क:")
    लिखो(शुद्ध_शुल्क)
    लौटाओ शुद्ध_शुल्क
}

कार्य पुस्तक_वापसी_संसाधन(पुस्तक_आईडी, वर्तमान_उपलब्ध, कुल_क्षमता) {
    मानो नया_उपलब्ध = वर्तमान_उपलब्ध + 1
    अगर (नया_उपलब्ध > कुल_क्षमता) {
        लिखो("चेतावनी: शेल्फ क्षमता से अधिक प्रतियां वापस दर्ज हुईं.")
        लौटाओ कुल_क्षमता
    }
    लिखो("पुस्तक इन्वेंट्री में पुन: दर्ज:")
    लिखो(पुस्तक_आईडी)
    लिखो("वर्तमान उपलब्ध प्रतियां:")
    लिखो(नया_उपलब्ध)
    लौटाओ नया_उपलब्ध
}

कार्य पुस्तक_आरक्षण_कतार_प्रबंधन(आरक्षण_संख्या, उपलब्ध_प्रतियां) {
    अगर (उपलब्ध_प्रतियां <= 0) {
        मानो नई_कतार = आरक्षण_संख्या + 1
        लिखो("प्रतियां अनुपलब्ध: आरक्षण कतार में जोड़ा गया:")
        लिखो(नई_कतार)
        लौटाओ नई_कतार
    }
    लिखो("प्रति तत्काल उपलब्ध: आरक्षण की आवश्यकता नहीं.")
    लौटाओ आरक्षण_संख्या
}

कार्य सदस्य_इतिहास_ऑडिट(सदस्य_आईडी, कुल_जारी, कुल_विलंब, संचित_शुल्क) {
    लिखो("========================================")
    लिखो("सदस्य परिसंचरण इतिहास ऑडिट:")
    लिखो(सदस्य_आईडी)
    लिखो("जीवनकाल कुल पुस्तकें जारी:")
    लिखो(कुल_जारी)
    लिखो("विलंबित वापसी घटनाएं:")
    लिखो(कुल_विलंब)
    लिखो("कुल संचित विलंब शुल्क भुगतान:")
    लिखो(संचित_शुल्क)
    मानो विश्वसनीयता_स्कोर = 100 - (कुल_विलंब * 10)
    अगर (विश्वसनीयता_स्कोर < 0) {
        मानो विश्वसनीयता_स्कोर = 0
    }
    लिखो("सदस्य विश्वसनीयता विश्वसनीयता रेटिंग (0-100):")
    लिखो(विश्वसनीयता_स्कोर)
    लिखो("========================================")
    लौटाओ विश्वसनीयता_स्कोर
}

कार्य अनुभाग_मासिक_संचलन_योग(कथा, विज्ञान, इतिहास, दर्शन) {
    मानो कुल_संचलन = कथा + विज्ञान + इतिहास + दर्शन
    मानो सर्वाधिक_मांग_श्रेणी = 0
    अगर (कथा >= विज्ञान और कथा >= इतिहास) {
        मानो सर्वाधिक_मांग_श्रेणी = 1
    } अन्यथा {
        अगर (विज्ञान >= इतिहास) {
            मानो सर्वाधिक_मांग_श्रेणी = 2
        } अन्यथा {
            मानो सर्वाधिक_मांग_श्रेणी = 3
        }
    }
    लिखो("पुस्तकालय कुल मासिक परिसंचरण:")
    लिखो(कुल_संचलन)
    लिखो("शीर्ष मांग अनुभाग कोड (1=कथा, 2=विज्ञान, 3=इतिहास):")
    लिखो(सर्वाधिक_मांग_श्रेणी)
    लौटाओ कुल_संचलन
}

कार्य सदस्यता_नवीनीकरण_शुल्क(सदस्यता_प्रकार, अवधि_माह) {
    मानो मासिक_दर = 100
    अगर (सदस्यता_प्रकार == 2) {
        मानो मासिक_दर = 200
    }
    मानो कुल_शुल्क = मासिक_दर * अवधि_माह
    लौटाओ कुल_शुल्क
}

कार्य पुस्तक_क्षति_मूल्यांकन(पुस्तक_लागत, क्षति_प्रतिशत) {
    मानो क्षति_दंड = (पुस्तक_लागत * क्षति_प्रतिशत) / 100
    लिखो("पुस्तक क्षति दंड मूल्यांकन राशि:")
    लिखो(क्षति_दंड)
    लौटाओ क्षति_दंड
}

कार्य दुर्लभ_पांडुलिपि_पहुंच_अनुमति(अनुसंधान_अनुमति, पर्यवेक्षक_आईडी) {
    अगर (अनुसंधान_अनुमति == 1 और पर्यवेक्षक_आईडी > 0) {
        लिखो("दुर्लभ पांडुलिपि संदर्भ कक्ष पहुंच स्वीकृत.")
        लौटाओ 1
    }
    लिखो("पहुंच अस्वीकृत: अनुसंधान अनुमति अथवा पर्यवेक्षक अनुपस्थित.")
    लौटाओ 0
}

कार्य डिजिटल_ईबुक_डाउनलोड_सत्यापन(सदस्य_आईडी, बैंडविड्थ_उपयोग) {
    अगर (सदस्य_आईडी > 0) {
        मानो _सदस्य_जांच = 1
    }
    अगर (बैंडविड्थ_उपयोग > 5000) {
        लिखो("दैनिक डिजिटल डाउनलोड सीमा समाप्त.")
        लौटाओ 0
    }
    लौटाओ 1
}

अगर (कुल_पुस्तक_प्रतियां > 0 और मानक_उधार_दिन > 0) {
    लिखो("पुस्तकालय स्वचालन प्रणाली आरंभ:")
}
लिखो(पुस्तकालय_नाम)

पुस्तक_पंजीयन_सत्यापन(9001, 101, 8, 42)
पुस्तक_पंजीयन_सत्यापन(9002, 102, 5, 18)
पुस्तक_पंजीयन_सत्यापन(9003, 103, 12, 75)

पुस्तक_निर्गमन_पात्रता(501, 1, 1)
पुस्तक_निर्गमन_पात्रता(502, 3, 1)
पुस्तक_निर्गमन_पात्रता(503, 0, 0)

विलंब_शुल्क_गणना(14, 21, 0)
विलंब_शुल्क_गणना(14, 14, 10)
विलंब_शुल्क_गणना(14, 28, 20)

पुस्तक_वापसी_संसाधन(9001, 4, 8)
पुस्तक_वापसी_संसाधन(9002, 2, 5)

पुस्तक_आरक्षण_कतार_प्रबंधन(2, 0)
पुस्तक_आरक्षण_कतार_प्रबंधन(0, 3)

सदस्य_इतिहास_ऑडिट(501, 24, 2, 85)
सदस्य_इतिहास_ऑडिट(502, 45, 6, 320)
सदस्य_इतिहास_ऑडिट(503, 8, 0, 0)

अनुभाग_मासिक_संचलन_योग(450, 380, 210, 140)

सदस्यता_नवीनीकरण_शुल्क(2, 12)
पुस्तक_क्षति_मूल्यांकन(1200, 25)
दुर्लभ_पांडुलिपि_पहुंच_अनुमति(1, 99)
डिजिटल_ईबुक_डाउनलोड_सत्यापन(501, 1250)


लिखो("कैटलॉग और परिसंचरण प्रणाली निष्पादन सफलतापूर्वक समाप्त.")

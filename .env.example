# Google Gemini API Configuration for VITAL IDE
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
GEMINI_MODEL_ADVANCED=gemini-3-flash-preview

# Comma-separated preference lists for dynamic model discovery and retirement/quota fallback
# GEMINI_MODEL_FALLBACKS_ADVANCED: used for Stage 12 security, Fix All, and deep remediation (strongest available first)
GEMINI_MODEL_FALLBACKS_ADVANCED=gemini-3-flash-preview,gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest

# GEMINI_MODEL_FALLBACKS_FAST: used for Stage 8 IR explanation and quick checks (lite/cheap models first)
GEMINI_MODEL_FALLBACKS_FAST=gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemini-flash-lite-latest,gemini-3-flash-preview

# Legacy fallback list (kept for backwards compatibility)
GEMINI_MODEL_FALLBACKS=gemini-3-flash-preview,gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest
VITAL_AI_TIMEOUT=45
